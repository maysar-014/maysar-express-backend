sequenceDiagram
    participant API
    participant UC as CompletePayoutUseCase
    participant PE as Payout Entity
    participant PR as PayoutRepository
    participant EB as EventBus

    API->>UC: execute(command)
    UC->>PR: findById(command.payoutId)
    PR-->>UC: payout
    
    UC->>PE: validateStatus()
    PE-->>UC: valid
    
    UC->>PE: markComplete()
    PE-->>UC: updatedPayout
    
    UC->>PR: save(updatedPayout)
    PR-->>UC: success
    
    UC->>EB: publish(PayoutCompletedEvent)
    UC-->>API: success
