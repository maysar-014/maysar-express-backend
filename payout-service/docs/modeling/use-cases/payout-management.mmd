useCaseDiagram
    actor "Seller" as S
    actor "Payment Provider" as PP
    actor "Admin" as A
    actor "System" as Sys

    package "Payout Service" {
        usecase "Initiate Payout" as UC1
        usecase "Process Payout" as UC2
        usecase "Complete Payout" as UC3
        usecase "Cancel Payout" as UC4
        usecase "Retry Failed Payout" as UC5
        usecase "View Payout History" as UC6
        usecase "Calculate Fees" as UC7
    }

    S --> UC1
    S --> UC6
    
    A --> UC4
    A --> UC5
    A --> UC6
    
    Sys --> UC2
    Sys --> UC3
    Sys --> UC7

    PP --> UC3

    UC1 ..> UC7 : <<include>>
    UC2 ..> UC7 : <<include>>
