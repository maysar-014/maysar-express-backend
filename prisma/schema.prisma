  @@index([isActive])
  @@index([category])
  @@map("chat_suspicious_phrases")
}

model Chat_EmergingPattern {
  id                String                     @id @default(cuid()) @db.VarChar(64)
  phrase            String                     @unique @db.VarChar(300)
  occurrences       Int                        @default(0)
  conversationCount Int                        @default(0)
  sampleMessageIds  Json?
  status            Chat_EmergingPatternStatus @default(PENDING)
  firstSeenAt       DateTime                   @default(now()) @db.Timestamp(6)
  lastSeenAt        DateTime                   @default(now()) @db.Timestamp(6)

  @@map("chat_emerging_patterns")
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery Pricing Engine
// ─────────────────────────────────────────────────────────────────────────────

model Logistics_Quote {
  id                          String    @id @db.VarChar(64)
  deliveryFee                 Decimal   @db.Decimal(12, 2)
  courierCompensationEstimate Decimal   @db.Decimal(12, 2)
  platformMarginAmount        Decimal   @db.Decimal(12, 2)
  pricingVersion              Int
  originLat                   Float
  originLng                   Float
  originAddress               String    @db.VarChar(500)
  destinationLat              Float
  destinationLng              Float
  destinationAddress          String    @db.VarChar(500)
  packageWeightKg             Float
  deliveryZone                String?   @db.VarChar(20)
  status                      String    @db.VarChar(30)
  breakdown                   Json
  unavailableReason           String?
  issuedAt                    DateTime  @default(now())
  expiresAt                   DateTime
  consumedAt                  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  auditRecord                 Logistics_PricingAuditRecord?

  // ── Delivery consolidation fields (nullable for backward compat with solo quotes) ──
  deliveryGroupId             String?   @db.VarChar(64)   // non-null when quote belongs to a delivery group
  sellerOrderIds              Json?                       // string[] — seller order IDs in this group

  @@index([status, expiresAt])
  @@index([issuedAt])
  @@map("logistics_quotes")
}

model Logistics_PricingConfig {
  version                    Int       @id

  // ── Platform margin ────────────────────────────────────────────────────────
  platformMarginPct          Decimal   @db.Decimal(6, 4)

  // ── Floor / ceiling / rounding ─────────────────────────────────────────────
  floorPriceTzs              Decimal   @db.Decimal(12, 2)
  ceilingPriceTzs            Decimal   @db.Decimal(12, 2)
  roundingIncrementTzs       Int

  // ── COD policy (independent of delivery economics) ─────────────────────────
  codPolicy                  Json

  // ── Strategy-specific pricing configs ──────────────────────────────────────
  localUrban                 Json
  metropolitan               Json
  intercityCorridors         Json
  intercityFallback          Json?
  remoteUnavailable          Boolean   @default(false)

  // ── Quote / cache settings ──────────────────────────────────────────────────
  quoteValiditySeconds       Int
  routingCacheTtlMs          Int

  // ── Delivery consolidation parameters ───────────────────────────────────────
  // All nullable for backward compatibility — defaults applied in application code
  consolidationRadiusKm              Decimal?  @db.Decimal(6, 2)   // default 5.0 km
  maxConsolidatedRouteOverheadPct    Decimal?  @db.Decimal(6, 4)   // default 1.40 (40%)
  maxGroupWeightKg                   Decimal?  @db.Decimal(6, 2)   // default 20.0 kg
  allocationAlgorithm                String?   @db.VarChar(32)     // default 'weight_proportional'

  isActive                   Boolean   @default(false)
  createdAt                  DateTime  @default(now())

  @@index([isActive])
  @@map("logistics_pricing_configs")
}

// ─── Delivery Consolidation Engine ───────────────────────────────────────────

model Logistics_DeliveryGroup {
  id                  String   @id @db.VarChar(64)  // DCG-{ULID}
  masterOrderId       String   @db.VarChar(64)
  sellerOrderIds      Json                           // string[] — ordered by pickup sequence
  pickupSequence      Json                           // {lat, lng, address}[] — ordered
  buyerDestination    Json                           // {lat, lng, address}
  totalDeliveryCost   Decimal  @db.Decimal(12, 2)
  pricingVersion      Int
  allocationAlgorithm String   @default("weight_proportional") @db.VarChar(32)
  status              String   @default("PENDING_PRICING") @db.VarChar(32)
  quoteId             String?  @db.VarChar(64)       // set when QUOTE_ISSUED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([masterOrderId])
  @@index([status])
  @@map("logistics_delivery_groups")
}

model Logistics_ConsolidationAudit {
  id               String   @id @db.VarChar(64)
  masterOrderId    String   @db.VarChar(64)
  deliveryGroupIds Json                          // string[]
  groupSizes       Json                          // number[] — one per group
  rulesApplied     Json                          // {proximity, weight, routeEfficiency, timeWindow}
  totalSavingsTzs  Decimal  @db.Decimal(12, 2)
  fallbackReason   String?  @db.Text
  pricingVersion   Int
  consolidatedAt   DateTime @default(now())

  @@index([masterOrderId])
  @@map("logistics_consolidation_audits")
}
// ─────────────────────────────────────────────────────────────────────────────

model Logistics_PricingAuditRecord {
  id                          String    @id @db.VarChar(64)
  orderId                     String?   @db.VarChar(64)
  quoteId                     String    @unique @db.VarChar(64)
  pricingVersion              Int
  courierCompensationEstimate Decimal   @db.Decimal(12, 2)
  buyerDeliveryFee            Decimal   @db.Decimal(12, 2)
  platformMarginAmount        Decimal   @db.Decimal(12, 2)
  deliveryZone                String?   @db.VarChar(20)
  packageWeightKg             Float
  distanceKm                  Float
  durationMinutes             Float
  recordedAt                  DateTime  @default(now())

  quote                       Logistics_Quote @relation(fields: [quoteId], references: [id])

  @@index([orderId])
  @@index([pricingVersion])
  @@index([recordedAt])
  @@map("logistics_pricing_audit_records")
}

// ── Shipment domain (Phase 2) ────────────────────────────────────────────────

/// The atomic unit of physical movement: one seller group's package from the
/// seller's origin to the buyer's destination. One order produces one Shipment
/// per seller group. Shipments are assigned to DeliveryJobs by the
/// consolidation engine (deliveryJobId set on assignment).
/// State machine (named transition methods only — no direct status writes):
///   CREATED → PLANNED → ASSIGNED → DISPATCHED → DELIVERED → CONFIRMED → SETTLED
///   PLANNED/ASSIGNED/DISPATCHED/DELIVERED → FAILED (with sub-reason)
model Logistics_Shipment {
  id                      String   @id @db.VarChar(64)  // SHP-{ULID}
  orderId                 String   @db.VarChar(64)      // master/seller order reference
  sellerId                String   @db.VarChar(64)
  originLat               Float
  originLng               Float
  originAddress           String   @db.VarChar(255)
  destinationLat          Float
  destinationLng          Float
  destinationAddress      String   @db.VarChar(255)
  packageWeightKg         Float
  packageDimensions       Json?                          // {lengthCm, widthCm, heightCm}
  handlingRequirements    Json                           // {fragile, temperatureControlled, hazmat}
  requestedDeliveryWindow Json?                          // {earliestAt, latestAt}
  requiredVehicleClass    String?  @db.VarChar(20)       // MOTORCYCLE | PICKUP | VAN | TRUCK
  status                  String   @default("CREATED") @db.VarChar(32)
  failureReason           String?  @db.VarChar(40)       // set when status = FAILED
  deliveryJobId           String?  @db.VarChar(64)       // set when assigned to a DeliveryJob
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@index([deliveryJobId])
  @@map("logistics_shipments")
}

/// One physical courier operation. May contain multiple Shipments
/// (consolidated). This is the entity assigned to a driver.
/// State machine (named transition methods only — no direct status writes):
///   PENDING → ASSIGNED → DRIVER_ACCEPTED → AT_PICKUP → LOADING → IN_TRANSIT
///     → AT_DESTINATION → DELIVERED → CONFIRMED → SETTLED
///   DRIVER_ACCEPTED/AT_PICKUP/LOADING → FAILED_PICKUP
///   IN_TRANSIT/AT_DESTINATION → CUSTOMER_UNAVAILABLE
model Logistics_DeliveryJob {
  id                  String    @id @db.VarChar(64)  // DJB-{ULID}
  shipmentIds         Json                           // string[] — shipments in this job
  driverId            String?   @db.VarChar(64)
  vehicleId           String?   @db.VarChar(64)
  routeId             String?   @db.VarChar(64)
  status              String    @default("PENDING") @db.VarChar(32)
  failureReason       String?   @db.VarChar(40)      // FAILED_PICKUP | CUSTOMER_UNAVAILABLE
  scheduledPickupAt   DateTime?
  estimatedDeliveryAt DateTime?
  actualPickupAt      DateTime?
  actualDeliveryAt    DateTime?
  matchAudit           Json?                           // Phase 5 §5.1 — matching score + all input factors, stored for audit at assignment time
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([driverId])
  @@map("logistics_delivery_jobs")
}

/// Records every evaluated route-insertion opportunity so optimization
/// quality can be analysed retrospectively. (Phase 5 §5.2)
model Logistics_RouteInsertionCandidate {
  id                        String    @id @db.VarChar(64)  // RIC-{ULID}
  shipmentId                String    @db.VarChar(64)
  deliveryJobId             String    @db.VarChar(64)
  marginalCostTzs           Float
  additionalDistanceKm      Float
  additionalDurationMinutes Float
  feasible                  Boolean
  rejectionReason           String?   @db.VarChar(64)      // CAPACITY | THRESHOLD | VEHICLE_CLASS
  evaluatedAt               DateTime  @default(now())

  @@index([deliveryJobId])
  @@index([shipmentId])
  @@map("logistics_route_insertion_candidates")
}

/// Materialized snapshot of the continuous shipment opportunity pool —
/// pending Shipments not yet assigned to a DeliveryJob. Refreshed on every
/// Shipment state change and before each pool optimization run. (Phase 5 §5.3)
model Logistics_ShipmentPoolEntry {
  id                  String    @id @db.VarChar(64)  // SPL-{ULID}
  shipmentId          String    @db.VarChar(64)
  status              String    @db.VarChar(32)
  originLat           Float
  originLng           Float
  destinationLat      Float
  destinationLng      Float
  packageWeightKg     Float
  requiredVehicleClass String?  @db.VarChar(16)
  windowEarliestAt    DateTime?
  windowLatestAt      DateTime?
  refreshedAt         DateTime  @default(now())

  @@unique([shipmentId])
  @@index([status])
  @@map("logistics_shipment_pool")
}

/// A physical vehicle a driver operates. The optimizer needs real capability
/// constraints (weight/volume, areas, hours) — the motorcycle-assumes-all
/// model is retired. (Phase 2 §2.3)
model Logistics_Vehicle {
  id               String    @id @db.VarChar(64)  // VHL-{ULID}
  driverId         String    @db.VarChar(64)
  vehicleType      String    @db.VarChar(20)      // MOTORCYCLE | PICKUP | VAN | TRUCK
  maxWeightKg      Float
  maxVolumeM3      Float?                          // null = not volume-constrained
  cargoDimensions  Json?                           // {maxLengthCm, maxWidthCm, maxHeightCm}
  servesAreas      Json                            // string[] of region/district names
  operatingHours   Json                            // [{dayOfWeek, startHour, endHour}]
  hasRefrigeration Boolean   @default(false)
  handlesFragile   Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tariffs          Logistics_VehicleTariff[]

  @@index([driverId])
  @@index([vehicleType])
  @@index([isActive])
  @@map("logistics_vehicles")
}

/// Versioned operating tariff per vehicle. Never overwritten — historical
/// orders reference the version at time of pricing. (Phase 2 §2.3)
model Logistics_VehicleTariff {
  id                        String               @id @db.VarChar(64)  // vtf-{ULID}
  vehicleId                 String               @db.VarChar(64)
  version                   Int                  // monotonic per vehicle (starts at 1)
  baseOperatingCostTzs      Decimal              @db.Decimal(12, 2)
  costPerKmTzs              Decimal              @db.Decimal(12, 2)
  costPerHourTzs            Decimal              @db.Decimal(12, 2)
  minimumJobCompensationTzs Decimal              @db.Decimal(12, 2)
  loadingFeeTzs             Decimal              @db.Decimal(12, 2)
  unloadingFeeTzs           Decimal              @db.Decimal(12, 2)
  waitingRateTzsPerMinute   Decimal              @db.Decimal(12, 2)
  freeWaitMinutes           Int                  @default(0)
  isActive                  Boolean              @default(true)
  effectiveFrom             DateTime             @default(now())
  createdAt                 DateTime             @default(now())

  vehicle                   Logistics_Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, version])
  @@index([vehicleId, isActive])
  @@index([isActive])
  @@map("logistics_vehicle_tariffs")
}

// ── Four-concept cost model (Phase 3) ────────────────────────────────────────

/// Immutable cost adjustment with attributed responsibility. Every logistics
/// cost that deviates from the planned route/schedule gets one of these.
/// Never updated after creation. (Phase 3 §3.2)
model Logistics_CostAdjustment {
  id               String   @id @db.VarChar(64)  // adj-{ULID}
  deliveryJobId    String   @db.VarChar(64)
  shipmentId       String?  @db.VarChar(64)
  adjustmentType   String   @db.VarChar(32)      // WAITING | FAILED_DELIVERY_ATTEMPT | ROUTE_DEVIATION | LOADING_DELAY | DAMAGE | DISPUTE
  amountTzs        Decimal  @db.Decimal(12, 2)
  responsibleParty String   @db.VarChar(20)      // CUSTOMER | SUPPLIER | DRIVER | MAYSAR | EXTERNAL
  reason           String   @db.Text             // free text for ops
  evidenceUrl      String?  @db.VarChar(512)     // photo/document
  recordedAt       DateTime @default(now())
  recordedBy       String   @db.VarChar(64)

  @@index([deliveryJobId])
  @@index([responsibleParty])
  @@map("logistics_cost_adjustments")
}

/// Append-only logistics ledger (Phase 3 §3.3). Settlement reads the ledger;
/// it never re-derives amounts from current config. Rows are NEVER updated.
model Logistics_LedgerEntry {
  id             String   @id @db.VarChar(64)  // led-{ULID}
  deliveryJobId  String   @db.VarChar(64)
  shipmentId     String?  @db.VarChar(64)
  entryType      String   @db.VarChar(40)      // BUYER_LOGISTICS_CHARGE | CARRIER_PAYABLE | SUPPLIER_LOGISTICS_CHARGE | MAYSAR_LOGISTICS_REVENUE | DISCOUNT_MAYSAR_FUNDED | DISCOUNT_SUPPLIER_FUNDED | PENALTY | REFUND | ADJUSTMENT | CONSOLIDATION_SAVING
  amountTzs      Decimal  @db.Decimal(12, 2)   // positive: income to that party; negative: cost to that party
  counterpartyId String   @db.VarChar(64)
  pricingVersion Int                           // FK semantics: PricingConfig.version at time of pricing
  tariffVersion  Int?                          // FK semantics: VehicleTariff.version at time of pricing
  routingVersion String?  @db.VarChar(64)      // hash/version of the routing config used
  calculatedAt   DateTime @default(now())
  metadata       Json                          // full calculation inputs — enough to reproduce the result

  @@index([deliveryJobId])
  @@index([entryType])
  @@index([counterpartyId])
  @@map("logistics_ledger_entries")
}

/// Absolute price lock at checkout confirmation (Phase 3 §3.4). Post-
/// confirmation optimization savings are Maysar's, never a buyer credit.
model Logistics_FulfillmentCommitment {
  id                String   @id @db.VarChar(64)  // cmt-{ULID}
  checkoutSessionId String   @db.VarChar(64)
  quoteId           String   @unique @db.VarChar(64)
  buyerPriceTzs     Decimal  @db.Decimal(12, 2)   // locked — must not change
  pricingVersion    Int
  lockedAt          DateTime @default(now())
  expiresAt         DateTime
  status            String   @default("LOCKED") @db.VarChar(20)  // LOCKED | CONSUMED | EXPIRED

  @@index([checkoutSessionId])
  @@index([status])
  @@map("logistics_fulfillment_commitments")
}

/// Versioned, operator-configurable optimization weights (Phase 4 §4.2).
/// Weights must sum to 1.0 (validated at save). Config changes require a new
/// version — no in-place overwrites. Also carries the Phase 3 §3.4
/// CostVariancePolicy (deferred from Phase 3 per backlog).
model Logistics_OptimizationConfig {
  id                        String   @id @db.VarChar(64)  // opt-{ULID}
  version                   Int      @unique
  buyerCostWeight           Decimal  @db.Decimal(6, 4)
  deliveryTimeWeight        Decimal  @db.Decimal(6, 4)
  vehicleUtilizationWeight  Decimal  @db.Decimal(6, 4)
  failureRiskWeight         Decimal  @db.Decimal(6, 4)
  driverEfficiencyWeight    Decimal  @db.Decimal(6, 4)
  maysarMarginWeight        Decimal  @db.Decimal(6, 4)
  // CostVariancePolicy (Phase 3 §3.4)
  maysarAbsorbsUpToTzs          Decimal @db.Decimal(12, 2) @default(0)
  customerChargeableVarianceTypes Json  @default("[]")
  // Fairness thresholds (Phase 6 §6.1) — versioned with the config
  maxBuyerPriceRatio            Decimal @db.Decimal(6, 4)  @default(1.5)
  minimumDriverHourlyRateTzs    Decimal @db.Decimal(12, 2) @default(3000)
  minVehicleUtilizationTarget   Decimal @db.Decimal(6, 4)  @default(0.5)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())

  @@map("logistics_optimization_configs")
}

// ── Phase 6 — Fairness Engine & Operational Intelligence ─────────────────────

/// Every failed fairness check is recorded here and surfaced to ops —
/// flagged options never disappear from a list without a recorded reason.
/// (Phase 6 §6.1)
model Logistics_FairnessFlag {
  id            String   @id @db.VarChar(64)  // FFL-{ULID}
  optionId      String?  @db.VarChar(64)
  deliveryJobId String?  @db.VarChar(64)
  checkType     String   @db.VarChar(32)      // BUYER_PRICE_RATIO | DRIVER_EARNINGS | SUPPLIER_ATTRIBUTION | MAYSAR_SUSTAINABILITY
  computedValue Decimal  @db.Decimal(12, 4)
  threshold     Decimal  @db.Decimal(12, 4)
  detail        String?  @db.VarChar(255)
  flaggedAt     DateTime @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?  @db.VarChar(64)

  @@index([checkType])
  @@index([resolvedAt])
  @@map("logistics_fairness_flags")
}

/// Per-buyer logistics behavior record, updated on every DeliveryConfirmed /
/// DeliveryFailed event. Feeds failure_probability in option ranking.
/// (Phase 6 §6.3)
model Logistics_BuyerProfile {
  id                          String   @id @db.VarChar(64)  // byp-{ULID}
  buyerId                     String   @unique @db.VarChar(64)
  preferredDeliveryWindows    Json     @default("{}")
  deliverySuccessRate         Decimal  @db.Decimal(4, 3)  @default(0.8)  // new-buyer default 0.80
  completedDeliveries         Int      @default(0)
  failedDeliveries            Int      @default(0)
  typicalOrderWeightKg        Decimal  @db.Decimal(8, 3)  @default(0)
  consolidationAcceptanceRate Decimal  @db.Decimal(4, 3)  @default(0)
  pickupPreference            String   @default("DELIVERY") @db.VarChar(16)
  lastUpdatedAt               DateTime @default(now())

  @@map("logistics_buyer_profiles")
}

// ── Phase 5 — Driver Matching & Live Optimization ────────────────────────────

// NOTE: Logistics_RouteInsertionCandidate is defined once above (next to the
// delivery-job model) — it was created by migration 20260904060000 with
// Float/DOUBLE PRECISION columns, so that is the canonical definition.

/// Audit of every driver-matching run (Phase 5 §5.1). The matching score and
/// all input factors are stored per candidate for audit — assignment decisions
/// must be explainable after the fact. APPEND-ONLY.
model Logistics_DriverMatchAudit {
  id                       String   @id @db.VarChar(64)  // dma-{ULID}
  deliveryJobId            String   @db.VarChar(64)
  driverId                 String   @db.VarChar(64)
  vehicleId                String?  @db.VarChar(64)
  vehicleType              String   @db.VarChar(20)
  score                    Decimal  @db.Decimal(8, 4)
  eligible                 Boolean
  exclusionReason          String?  @db.VarChar(50)
  scoreComponents          Json     // proximity, capacityHeadroom, reliability, routeFit, eta, driverEconomics
  estimatedCompensationTzs Decimal  @db.Decimal(12, 2)
  etaMinutes               Int
  distanceToPickupKm       Decimal  @db.Decimal(8, 2)
  matchedAt                DateTime @default(now())

  @@index([deliveryJobId])
  @@index([driverId])
  @@map("logistics_driver_match_audits")
}

/// Per-run analytics of the pool optimization job (Phase 5 §5.3).
/// Feeds the Phase 6 fairness KPIs.
model Logistics_PoolOptimizationRun {
  id                          String   @id @db.VarChar(64)  // por-{ULID}
  shipmentsEvaluated          Int
  consolidationCandidatesFound Int
  jobsCreated                 Int
  averageSavingsPerJobTzs     Decimal  @db.Decimal(12, 2)
  durationMs                  Int
  ranAt                       DateTime @default(now())

  @@map("logistics_pool_optimization_runs")
}

// ── Product Intelligence Engine ──────────────────────────────────────────────

/// Seller-specific offer data, decoupled from the canonical product record.
/// A product can have one offer per seller (marketplace model).
model Catalog_SellerOffer {
  id                      String   @id @db.VarChar(64)
  productId               String   @db.VarChar(64)
  sellerId                String   @db.VarChar(64)
  price                   Decimal  @db.Decimal(12, 2) @default(0)
  currency                String   @db.VarChar(10) @default("TZS")
  minimumOrderQuantity    Int      @default(1)
  codAccepted             Boolean  @default(false)
  freeDelivery            Boolean  @default(false)
  deliveryTerms           String?
  condition               String   @db.VarChar(20) @default("new")
  enablerEnabled          Boolean  @default(false)
  enablerCommissionRate   Decimal? @db.Decimal(5, 4)
  supplierLocationId      String?  @db.VarChar(64)
  supplierLocationDisplay String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @db.Timestamp(6)

  @@unique([productId, sellerId])
  @@index([productId])
  @@index([sellerId])
  @@index([productId, isActive])
  @@map("catalog_seller_offers")
}

/// Named semantic section of a generated product description.
/// Stored separately to allow per-section regeneration and independent rendering.
model Catalog_ProductContentSection {
  id                      String   @id @db.VarChar(64)
  productId               String   @db.VarChar(64)
  /// One of: OVERVIEW, KEY_FEATURES, SPECIFICATIONS, USAGE,
  ///         SELLER_OFFER_DELIVERY, SELLER_OFFER_LOCATION
  sectionType             String   @db.VarChar(40)
  content                 String
  /// One of: SELLER_ATTRIBUTE, DERIVED, CATEGORY_TEMPLATE
  source                  String   @db.VarChar(30) @default("SELLER_ATTRIBUTE")
  contributingAttributes  String[]
  /// True for sections that must never appear in the canonical product description
  isSellerOffer           Boolean  @default(false)
  schemaVersion           String?  @db.VarChar(64)
  contentVersion          Int      @default(1)
  generatedAt             DateTime @default(now()) @db.Timestamp(6)
  createdAt               DateTime @default(now()) @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @db.Timestamp(6)

  @@unique([productId, sectionType])
  @@index([productId])
  @@index([productId, isSellerOffer])
  @@map("catalog_product_content_sections")
}

/// Immutable audit log of product lifecycle state transitions.
model Catalog_ProductLifecycleLog {
  id           String   @id @db.VarChar(64)
  productId    String   @db.VarChar(64)
  /// Previous state (null for initial DRAFT creation)
  fromState    String?  @db.VarChar(32)
  /// New state after this transition
  toState      String   @db.VarChar(32)
  /// Machine-readable block reason codes
  blockReasons String[]
  /// Human-readable explanation
  reason       String?
  triggeredBy  String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([productId])
  @@index([productId, toState])
  @@index([createdAt])
  @@map("catalog_product_lifecycle_log")
}

// ─── Maysar Request ─────────────────────────────────────────────────────────
// Sourcing & assisted-commerce: customer describes a need, Maysar assesses,
// sources, prices, and presents a fulfillable solution that converts into a
// normal Maysar order. See docs/requests/MAYSAR_REQUEST_BACKLOG.md.
//
// Four-way separation (backlog rule §B-1):
//   Catalog Product ≠ Request Item ≠ Procurement Source ≠ Maysar Seller

model Request_Request {
  id                  String   @id @db.VarChar(64)
  customerId          String   @db.VarChar(64)
  title               String   @db.VarChar(160)
  description         String   @db.Text
  deliveryAddress     Json
  preferredDeliveryDate DateTime?
  budgetTzs           Int?
  attachments         Json?
  status              String   @db.VarChar(32)
  assignedProviderId  String?  @db.VarChar(64)
  unfulfillableReason String?  @db.Text
  orderId             String?  @db.VarChar(64)
  convertedQuoteId    String?  @db.VarChar(64)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  messages            Request_Message[]
  assessments         Request_Assessment[]
  quotes              Request_Quote[]
  accessLinks         Request_AccessLink[]
  itemRows            Request_Item[]

  @@index([customerId])
  @@index([assignedProviderId])
  @@index([status])
  @@map("request_requests")
}

/// Conversation thread attached to a Request (append-only; no update/delete).
model Request_Message {
  id          String   @id @db.VarChar(64)
  requestId   String   @db.VarChar(64)
  authorType  String   @db.VarChar(32)
  authorId    String?  @db.VarChar(64)
  body        String   @db.Text
  attachments Json?
  createdAt   DateTime @default(now())

  request     Request_Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("request_messages")
}

/// Provider assessment record (internal notes never leave the service).
model Request_Assessment {
  id                 String   @id @db.VarChar(64)
  requestId          String   @db.VarChar(64)
  providerId         String   @db.VarChar(64)
  decision           String   @db.VarChar(32)
  unfulfillableReason String?  @db.Text
  internalNotes      String?  @db.Text
  assessedAt         DateTime @default(now())

  request            Request_Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_assessments")
}

/// A Maysar offer for a Request. Published quotes are immutable — any change
/// creates a new version and supersedes the old one (§B-6).
model Request_Quote {
  id                  String   @id @db.VarChar(64)
  requestId           String   @db.VarChar(64)
  createdByProviderId String   @db.VarChar(64)
  label               String   @db.VarChar(40)
  status              String   @db.VarChar(24)
  items               Json
  /// Internal procurement cost — never exposed to the customer (§B-3).
  procurementCostTzs  Int
  logisticsCostTzs    Int
  sellingPriceTzs     Int
  deliveryDate        DateTime
  warrantyNote        String?  @db.Text
  explanation         String?  @db.Text
  validUntil          DateTime
  publishedAt         DateTime?
  createdAt           DateTime @default(now())

  request             Request_Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  accessLinks         Request_AccessLink[]
  itemRows            Request_Item[]

  @@index([requestId, status])
  @@map("request_quotes")
}

/// Secure, single-use assessment/checkout link. Only the SHA-256 hash of the
/// raw token is stored; the raw token is shown exactly once (§B-7).
model Request_AccessLink {
  id          String   @id @db.VarChar(64)
  requestId   String   @db.VarChar(64)
  quoteId     String   @db.VarChar(64)
  customerId  String   @db.VarChar(64)
  tokenHash   String   @unique @db.VarChar(128)
  status      String   @db.VarChar(16)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  request     Request_Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote       Request_Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([quoteId])
  @@map("request_access_links")
}

/// A first-class line item on a Request (Phase 2 §2.1).
/// §B-1: a request item never requires a catalog row. `sourceType` is the only
/// source-of-truth for how the item is procured, and `catalogProductId` is only
/// ever set for `CATALOG_PRODUCT` items.
model Request_Item {
  id               String   @id @db.VarChar(64)
  requestId        String   @db.VarChar(64)
  /// Nullable — items may exist at request level before quoting (quoteId is
  /// bound when the provider includes the item in a quote).
  quoteId          String?  @db.VarChar(64)
  description      String   @db.VarChar(255)
  quantity         Int
  unitPriceTzs     Int
  specifications   Json?
  warranty         String?  @db.VarChar(255)
  sourceType       String   @db.VarChar(24) /// CATALOG_PRODUCT | KNOWN_SUPPLIER | EXTERNAL_SUPPLIER | MAYSAR_INVENTORY
  catalogProductId String?  @db.VarChar(64) /// set ONLY when sourceType = CATALOG_PRODUCT
  fulfillmentNote  String?  @db.Text
  createdAt        DateTime @default(now())

  request      Request_Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote        Request_Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  sources      Request_Source[]
  procurements Request_Procurement[]

  @@index([requestId])
  @@index([quoteId])
  @@map("request_items")
}

/// A fulfillment source. Suppliers are NOT Maysar sellers — no auth account,
/// never customer-facing (§2.2).
model Request_Supplier {
  id                     String   @id @db.VarChar(64)
  name                   String   @db.VarChar(160)
  contact                Json     /// { phone?, whatsapp?, email? }
  source                 String   @db.VarChar(24) /// KNOWN | DISCOVERED
  discoveredViaRequestId String?  @db.VarChar(64)
  /// Phase 5 growth loop: PENDING → INVITE_READY (ops) → INVITED (event published)
  inviteStatus           String   @default("PENDING") @db.VarChar(24)
  isActive               Boolean  @default(true)
  notes                  String?  @db.Text
  createdAt              DateTime @default(now())

  sources Request_Source[]
  procurements Request_Procurement[]

  @@index([source])
  @@map("request_suppliers")
}

/// A sourcing record linking an item to a supplier (or to Maysar's own
/// inventory when supplierId is null). Multiple sources may exist per item —
/// the provider commits to one when the quote is published.
model Request_Source {
  id             String   @id @db.VarChar(64)
  itemId         String   @db.VarChar(64)
  supplierId     String?  @db.VarChar(64) /// null ONLY for MAYSAR_INVENTORY
  agreedPriceTzs Int
  availability   String   @db.VarChar(24) /// CONFIRMED | PENDING | UNAVAILABLE
  availableUntil DateTime?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  item     Request_Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier Request_Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procurements Request_Procurement[]

  @@index([itemId])
  @@index([supplierId])
  @@map("request_sources")
}

/// Post-order map: Order → Item → Supplier. Maysar-internal; the customer
/// never sees this (§2.3).
model Request_Procurement {
  id                String   @id @db.VarChar(64)
  orderId           String   @db.VarChar(64)
  itemId            String   @db.VarChar(64)
  supplierId        String   @db.VarChar(64) /// MAYSAR_INVENTORY uses the canonical inventory supplier
  sourceId          String?  @db.VarChar(64)
  agreedPriceTzs    Int
  procurementStatus String   @db.VarChar(24) /// PENDING → ORDERED → RECEIVED | FAILED
  orderedAt         DateTime?
  receivedAt        DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  item     Request_Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier Request_Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  source   Request_Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([itemId])
  @@map("request_procurements")
}

/// Append-only outbox for Request-domain events (request.submitted,
/// Append-only outbox for Request-domain events (request.submitted,
/// request.converted, quote.published, ...). Same pattern as the logistics
/// outbox — consumers reconcile from the tables if a row is missed.
model Request_OutboxEvent {
  id          String    @id @default(cuid()) @db.VarChar(64)
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("request_outbox_events")
}


/// Append-only audit trail (Phase 4 §4.3). Rows are written by the service on
/// every mutation and are never updated or deleted — there is no mutation path
/// by design. Read surface: provider/ops audit endpoint only.
model Request_AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(64)
  auditId    String   @unique
  requestId  String
  actorType  String
  actorId    String?
  action     String
  fromStatus String?
  toStatus   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("request_audit_logs")
}