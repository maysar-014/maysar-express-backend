// --- user-service Service Models ---

// Prisma schema for User_User Service
// This schema defines the database structure for user management and profiles





// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User_User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  passwordHash            String
  role                    User_UserRole @default(BUYER)
  status                  User_UserStatus @default(PENDING_VERIFICATION)

  // Profile Information
  firstName               String?
  lastName                String?
  phoneNumber             String?
  dateOfBirth             DateTime?
  avatar                  String?

  // Verification Status
  isEmailVerified         Boolean  @default(false)
  isPhoneVerified         Boolean  @default(false)
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?

  // Security Tracking
  failedLoginAttempts     Int      @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?

  // Two-Factor Authentication
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret         String?

  // Preferences
  language                String   @default("en")
  timezone                String   @default("UTC")
  notificationsEnabled    Boolean  @default(true)

  // Metadata
  attributes              Json?

  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  addresses               User_UserAddress[]
  sessions                User_Session[]
  passwordResetTokens     User_PasswordResetToken[]
  emailVerificationTokens User_EmailVerificationToken[]
  auditLogs               User_AuditLog[]

  @@map("users")
}

// ============================================================================
// USER ADDRESSES
// ============================================================================

model User_UserAddress {
  id          String   @id @default(cuid())
  userId      String
  type        User_AddressType @default(HOME)
  street      String
  city        String
  state       String?
  postalCode  String?
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User_User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

// ============================================================================
// SESSION MANAGEMENT
// ============================================================================

model User_Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  ipAddress   String
  userAgent   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relations
  user        User_User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================================
// PASSWORD RESET TOKENS
// ============================================================================

model User_PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User_User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================================
// EMAIL VERIFICATION TOKENS
// ============================================================================

model User_EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User_User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ============================================================================
// AUDIT LOGGING
// ============================================================================

model User_AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  email       String?
  action      String
  ipAddress   String
  userAgent   String
  success     Boolean
  reason      String?
  metadata    Json?
  timestamp   DateTime @default(now())

  // Relations
  user        User_User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ============================================================================
// ENUMS
