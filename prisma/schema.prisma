  id          String                                @id @default(cuid())
  userId      String
  requestType Compliance_SubjectRightsRequestType
  status      Compliance_SubjectRightsRequestStatus @default(pending)
  requestedAt DateTime                              @default(now())
  completedAt DateTime?
  data        Json?
  reason      String?

  @@map("compliance_subject_rights_requests")
}

// PCI DSS Compliance Tracking
model Compliance_PCIComplianceRecord {
