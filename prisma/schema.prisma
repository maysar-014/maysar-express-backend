generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analytics_EnablerAnalytics {
  enablerId              String    @id
  trainingsScheduled     Int?      @default(0)
  lastTrainingDate       DateTime?
  certificatesIssued     Int?      @default(0)
  sellersOnboarded       Int?      @default(0)
  totalEarnings          Float?    @default(0.0)
  lastActivity           DateTime?
  supportTicketsResolved Int?      @default(0)
  successRate            Float?    @default(0.0)
  salesSupported         Int?      @default(0)
  totalSalesValue        Float?    @default(0.0)
  conversionRate         Float?    @default(0.0)
  skillCertifications    Int?      @default(0)
  skillLevel             String?
  createdAt              DateTime  @default(now())
}

model Analytics_SellerMetrics {
  sellerId                       String                               @id
  averageOrderValue              Float?
  conversionRate                 Float?
  customerLifetimeValue          Float?
  returnRate                     Float?
  profitMargin                   Float?
  activeVisitors                 Int?
  cartAbandonment                Int?
  liveOrders                     Int?
  inventoryAlerts                Int?
  customerInquiries              Int?
  todaySales                     Decimal?                             @db.Decimal(12, 2)
  todayOrderCount                Int?
  thisMonthRevenue               Decimal?                             @db.Decimal(12, 2)
  lastMonthRevenue               Decimal?                             @db.Decimal(12, 2)
  monthOverMonthGrowth           Float?
  repeatCustomerRate             Float?
  bestPerformingProductId        String?
  bestPerformingProductRevenue   Decimal?                             @db.Decimal(12, 2)
  bestPerformingProductUnitsSold Int?
  pendingCustomerQuestions       Int?
  lowConversionProductCount      Int?
  profitabilityScore             Int?
  averageRating                  Float?
  responseRate                   Float?
  averageDeliveryTime            Float?
  lastUpdated                    DateTime                             @default(now())
  createdAt                      DateTime                             @default(now())
  actionItems                    Analytics_SellerActionItem[]
  dailySales                     Analytics_SellerDailySales[]
  inventoryHealth                Analytics_SellerInventoryHealth[]
  productPerformance             Analytics_SellerProductPerformance[]
}

model Analytics_SellerDailySales {
  id            String                  @id @default(uuid())
  sellerId      String
  date          DateTime
  revenue       Decimal                 @db.Decimal(12, 2)
  orderCount    Int
  createdAt     DateTime                @default(now())
  sellerMetrics Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, date])
  @@index([sellerId, date])
  @@map("analytics_seller_daily_sales")
}

model Analytics_SellerProductPerformance {
  id             String                  @id @default(uuid())
  sellerId       String
  productId      String
  views          Int                     @default(0)
  orders         Int                     @default(0)
  revenue        Decimal                 @db.Decimal(12, 2)
  conversionRate Float?
  lastUpdated    DateTime                @default(now())
  sellerMetrics  Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, productId])
  @@index([sellerId, revenue])
  @@map("analytics_seller_product_performance")
}

model Analytics_SellerInventoryHealth {
  id                String                  @id @default(uuid())
  sellerId          String
  productId         String
  currentStock      Int
  stockStatus       String
  salesVelocity     Float?
  daysUntilStockout Int?
  lastUpdated       DateTime                @default(now())
  sellerMetrics     Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, productId])
  @@index([sellerId, stockStatus])
  @@map("analytics_seller_inventory_health")
}

model Analytics_SellerActionItem {
  id            String                  @id @default(uuid())
  sellerId      String
  type          String
  priority      String
  title         String
  description   String
  productId     String?
  metadata      Json?
  isResolved    Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  sellerMetrics Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@index([sellerId, isResolved, priority])
  @@map("analytics_seller_action_items")
}

model Analytics_SalesAnalytics {
  id        String   @id @default(uuid())
  sellerId  String
  date      DateTime
  insights  String?
  createdAt DateTime @default(now())
}

model Analytics_SupplierAnalytics {
  supplierId          String    @id
  resourceUtilization Json?
  lastUpdated         DateTime?
  qualityScore        Float?
  certificatesIssued  Int?      @default(0)
  ordersShipped       Int?      @default(0)
  lastShipment        DateTime?
  totalRevenue        Float?    @default(0.0)
  paymentsReceived    Int?      @default(0)
  pricingUpdates      Int?      @default(0)
  activeProducts      Int?      @default(0)
  createdAt           DateTime  @default(now())
}

model Analytics_CourierAnalytics {
  courierId           String    @id
  performanceScore    Float?
  lastAnalysis        DateTime?
  totalEarnings       Float?    @default(0.0)
  deliveriesCompleted Int?      @default(0)
  lastDelivery        DateTime?
  totalPayouts        Float?    @default(0.0)
  payoutsReceived     Int?      @default(0)
  vehicleStatus       String?
  lastVehicleUpdate   DateTime?
  kycStatus           String?
  kycCompletedAt      DateTime?
  createdAt           DateTime  @default(now())
}

model Analytics_Metric {
  id         String   @id @default(uuid())
  metricType String
  value      Float
  dimension  String
  period     String
  timestamp  DateTime
  confidence Float
  createdAt  DateTime @default(now())

  @@index([metricType, timestamp])
  @@index([dimension, metricType])
}

model User {
  id                      String                        @id @default(cuid())
  email                   String                        @unique
  passwordHash            String
  role                    Auth_UserRole                 @default(BUYER)
  status                  Auth_UserStatus               @default(PENDING_VERIFICATION)
  phoneNumber             String?
  isEmailVerified         Boolean                       @default(false)
  isPhoneVerified         Boolean                       @default(false)
  failedLoginAttempts     Int                           @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?
  twoFactorEnabled        Boolean                       @default(false)
  twoFactorSecret         String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  auditLogs               AuditLog[]
  emailVerificationTokens Auth_EmailVerificationToken[]
  passwordResetTokens     Auth_PasswordResetToken[]
  sessions                Session[]
  twoFactorAuth           User_TwoFactorAuth?

  @@map("auth_users")
}

model Auth_User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  role             Auth_UserRole   @default(BUYER)
  status           Auth_UserStatus @default(PENDING_VERIFICATION)
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("auth_user_sync")
}

model User_TwoFactorAuth {
  id          String    @id @default(cuid())
  userId      String    @unique
  method      String
  secret      String
  backupCodes Json
  isEnabled   Boolean   @default(false)
  isVerified  Boolean   @default(false)
  deviceName  String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor_auth")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Auth_PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_password_reset_tokens")
}

model Auth_EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_email_verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  action    String
  ipAddress String
  userAgent String
  success   Boolean
  reason    String?
  metadata  Json?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@map("auth_audit_logs")
}

model Auth_UserIndex {
  userId    String
  indexType String
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, indexType])
  @@map("auth_user_indexes")
}

model Business {
  id                 String                              @id @default(cuid())
  name               String
  businessType       BusinessRegistry_BusinessType
  registrationNumber String                              @unique
  taxId              String?                             @unique
  status             BusinessRegistry_BusinessStatus     @default(PENDING)
  verificationStatus BusinessRegistry_VerificationStatus @default(UNVERIFIED)
  complianceStatus   BusinessRegistry_ComplianceStatus   @default(UNDER_REVIEW)
  ownerId            String
  description        String?
  industry           String?
  website            String?
  email              String?
  phoneNumber        String?
  verifiedAt         DateTime?
  verifiedBy         String?
  attributes         Json?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  addresses          BusinessAddress[]
  documents          BusinessDocument[]
  complianceRecords  BusinessRegistry_ComplianceRecord[]

  @@map("businessregistry_businesses")
}

model BusinessAddress {
  id         String                       @id @default(cuid())
  businessId String
  type       BusinessRegistry_AddressType @default(MAIN)
  street     String
  city       String
  region     String
  postalCode String?
  country    String                       @default("Tanzania")
  isPrimary  Boolean                      @default(false)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  business   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_business_addresses")
}

model BusinessDocument {
  id         String                          @id @default(cuid())
  businessId String
  type       BusinessRegistry_DocumentType
  fileName   String
  fileUrl    String
  status     BusinessRegistry_DocumentStatus @default(PENDING)
  uploadedAt DateTime                        @default(now())
  verifiedAt DateTime?
  business   Business                        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_business_documents")
}

model BusinessRegistry_ComplianceRecord {
  id         String                            @id @default(cuid())
  businessId String
  type       BusinessRegistry_ComplianceType
  status     BusinessRegistry_ComplianceStatus
  checkedAt  DateTime                          @default(now())
  expiresAt  DateTime?
  notes      String?
  business   Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_compliance_records")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("businessregistry_outbox_events")
}

model EventStore {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  aggregateId String
  version     Int
  timestamp   DateTime @default(now())
  payload     Json
  metadata    Json?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([aggregateId])
  @@index([eventType])
  @@map("event_store")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  parentId     String?    @db.Uuid
  name         String     @db.VarChar(255)
  slug         String     @unique @db.VarChar(255)
  description  String?
  imageUrl     String?    @db.VarChar(500)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  seoMetadata  Json?
  createdAt    DateTime   @default(now()) @db.Timestamp(6)
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]

  @@map("catalog_categories")
}

model Product {
  id                 String                @id @default(uuid()) @db.Uuid
  sellerId           String                @db.Uuid
  title              String                @db.VarChar(255)
  description        String?
  categoryId         String                @db.Uuid
  brand              String?               @db.VarChar(100)
  model              String?               @db.VarChar(100)
  status             Catalog_ProductStatus @default(draft)
  visibility         Catalog_Visibility    @default(public)
  seoMetadata        Json?
  tags               String[]
  gtin               String?               @db.VarChar(14)
  mpn                String?               @db.VarChar(100)
  isbn               String?               @db.VarChar(13)
  fingerprint        String?               @db.VarChar(64)
  fingerprintVersion Int                   @default(1)
  createdAt          DateTime              @default(now()) @db.Timestamp(6)
  updatedAt          DateTime              @updatedAt @db.Timestamp(6)
  variants           ProductVariant[]
  category           Category              @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, fingerprint])
  @@index([gtin])
  @@index([mpn])
  @@index([isbn])
  @@index([brand, model, categoryId])
  @@map("catalog_products")
}

model BuyBox {
  id              String                      @id @default(uuid()) @db.Uuid
  productId       String                      @unique @db.Uuid
  primarySellerId String                      @db.Uuid
  primaryScore    Decimal                     @db.Decimal(6, 2)
  lastComputedAt  DateTime                    @db.Timestamp(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamp(6)
  alternatives    Catalog_BuyBoxAlternative[]

  @@index([productId])
  @@map("catalog_buy_boxes")
}

model Catalog_BuyBoxAlternative {
  id       String  @id @default(uuid()) @db.Uuid
  buyBoxId String  @db.Uuid
  sellerId String  @db.Uuid
  score    Decimal @db.Decimal(6, 2)
  rank     Int
  buyBox   BuyBox  @relation(fields: [buyBoxId], references: [id], onDelete: Cascade)

  @@index([buyBoxId])
  @@map("catalog_buy_box_alternatives")
}

model ProductVariant {
  id              String                  @id @default(uuid()) @db.Uuid
  productId       String                  @db.Uuid
  sku             String                  @unique @db.VarChar(100)
  name            String?                 @db.VarChar(255)
  price           Decimal                 @db.Decimal(10, 2)
  compareAtPrice  Decimal?                @db.Decimal(10, 2)
  costPrice       Decimal?                @db.Decimal(10, 2)
  inventoryPolicy Catalog_InventoryPolicy @default(deny)
  weight          Decimal?                @db.Decimal(8, 3)
  dimensions      Json?
  attributes      Json?
  images          Json?
  status          Catalog_VariantStatus   @default(active)
  createdAt       DateTime                @default(now()) @db.Timestamp(6)
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("catalog_product_variants")
}

model MediaRef {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @db.VarChar(50)
  entityId     String   @db.Uuid
  mediaType    String   @db.VarChar(50)
  url          String   @db.VarChar(500)
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  metadata     Json?
  uploadedBy   String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("catalog_media_refs")
}

model Catalog_ProductMatchAudit {
  id                 String                 @id @default(uuid()) @db.Uuid
  candidateProductId String                 @db.Uuid
  matchedProductId   String?                @db.Uuid
  matchLevel         Catalog_MatchLevel
  matchScore         Decimal                @db.Decimal(5, 2)
  matchingCriteria   Json
  decision           Catalog_MatchDecision
  decidedBy          Catalog_MatchDecidedBy
  sellerId           String                 @db.Uuid
  metadata           Json?
  createdAt          DateTime               @default(now()) @db.Timestamp(6)

  @@index([sellerId, createdAt])
  @@index([matchLevel])
  @@index([decision])
  @@map("catalog_product_match_audits")
}

model Catalog_MatchConfirmation {
  id                String                     @id @default(uuid()) @db.Uuid
  auditId           String                     @db.Uuid
  sellerId          String                     @db.Uuid
  candidateProducts Json
  status            Catalog_ConfirmationStatus @default(PENDING)
  sellerChoice      String?
  expiresAt         DateTime                   @db.Timestamp(6)
  respondedAt       DateTime?                  @db.Timestamp(6)
  createdAt         DateTime                   @default(now()) @db.Timestamp(6)

  @@index([sellerId, status])
  @@index([expiresAt])
  @@map("catalog_match_confirmations")
}

model CatalogOutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("catalog_outbox_events")
}

model Checkout_Cart {
  id        String              @id @default(uuid())
  userId    String              @db.Uuid
  status    String              @default("active")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  expiresAt DateTime            @default(dbgenerated("(now() + '7 days'::interval)"))
  items     Checkout_CartItem[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model Checkout_CartItem {
  id          String        @id @default(uuid())
  cartId      String
  productId   String        @db.Uuid
  variantId   String?       @db.Uuid
  quantity    Int
  priceAtTime Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cart        Checkout_Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Checkout_CheckoutSession {
  id                String   @id @default(uuid())
  cartId            String
  userId            String   @db.Uuid
  status            String   @default("initiated")
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  subtotal          Decimal  @db.Decimal(12, 2)
  shippingCost      Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(12, 2)
  paymentMethodId   String?
  paymentStatus     String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime @default(dbgenerated("(now() + '01:00:00'::interval)"))

  @@index([userId])
  @@index([status])
  @@index([cartId])
  @@index([expiresAt])
}

model Checkout_Order {
  id                String               @id @default(uuid())
  checkoutSessionId String
  userId            String               @db.Uuid
  status            String               @default("pending")
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  subtotal          Decimal              @db.Decimal(12, 2)
  shippingCost      Decimal              @db.Decimal(12, 2)
  taxAmount         Decimal              @db.Decimal(12, 2)
  discountAmount    Decimal              @db.Decimal(12, 2)
  totalAmount       Decimal              @db.Decimal(12, 2)
  paymentMethodId   String?
  paymentStatus     String               @default("pending")
  trackingNumber    String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             Checkout_OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Checkout_OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  productId  String         @db.Uuid
  variantId  String?        @db.Uuid
  quantity   Int
  unitPrice  Decimal        @db.Decimal(12, 2)
  totalPrice Decimal        @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  order      Checkout_Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Checkout_InventoryReservation {
  id         String   @id @default(uuid())
  checkoutId String
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  quantity   Int
  status     String   @default("reserved")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([checkoutId, productId, variantId])
  @@index([checkoutId])
  @@index([status])
  @@index([expiresAt])
}

model Checkout_AppliedDiscount {
  id            String   @id @default(uuid())
  checkoutId    String
  discountCode  String?
  discountType  String
  discountValue Decimal  @db.Decimal(12, 2)
  maxUses       Int?
  currentUses   Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([checkoutId])
  @@index([discountCode])
}

model Commission {
  id        String                      @id @default(uuid()) @db.Uuid
  orderId   String                      @db.Uuid
  sellerId  String                      @db.Uuid
  amount    Decimal                     @db.Decimal(10, 2)
  rate      Decimal                     @db.Decimal(5, 4)
  type      Commission_CommissionType
  status    Commission_CommissionStatus @default(pending)
  paidAt    DateTime?                   @db.Timestamp(6)
  payoutId  String?                     @db.Uuid
  metadata  Json?
  createdAt DateTime                    @default(now()) @db.Timestamp(6)

  @@map("commission_commissions")
}

model Commission_Referral {
  id           String                    @id @default(uuid()) @db.Uuid
  referrerId   String                    @db.Uuid
  refereeId    String                    @db.Uuid
  referralCode String                    @unique @db.VarChar(50)
  status       Commission_ReferralStatus @default(pending)
  rewardAmount Decimal?                  @db.Decimal(8, 2)
  rewardPaid   Boolean                   @default(false)
  completedAt  DateTime?                 @db.Timestamp(6)
  expiresAt    DateTime                  @db.Timestamp(6)
  metadata     Json?
  createdAt    DateTime                  @default(now()) @db.Timestamp(6)

  @@map("commission_referrals")
}

model Commission_Reward {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  type        Commission_RewardType
  amount      Decimal                 @db.Decimal(8, 2)
  description String?
  status      Commission_RewardStatus @default(earned)
  expiresAt   DateTime?               @db.Timestamp(6)
  redeemedAt  DateTime?               @db.Timestamp(6)
  referenceId String?                 @db.Uuid
  createdAt   DateTime                @default(now()) @db.Timestamp(6)

  @@map("commission_rewards")
}

model CommissionPayout {
  id            String                  @id @default(uuid()) @db.Uuid
  recipientId   String                  @db.Uuid
  recipientType String
  amount        Decimal                 @db.Decimal(10, 2)
  status        Commission_PayoutStatus @default(pending)
  scheduledDate DateTime?               @db.Timestamp(6)
  processedDate DateTime?               @db.Timestamp(6)
  reference     String?
  metadata      Json?
  createdAt     DateTime                @default(now()) @db.Timestamp(6)

  @@map("commission_payouts")
}

model Commission_EventStore {
  id           String   @id @default(uuid()) @db.Uuid
  aggregateId  String
  eventType    String
  eventData    Json
  occurredAt   DateTime @default(now()) @db.Timestamp(6)
  eventVersion Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("commission_event_store")
}

model Post {
  id               String               @id @default(uuid()) @db.Uuid
  authorId         String               @db.Uuid
  title            String?              @db.VarChar(255)
  content          String
  type             Community_PostType   @default(text)
  visibility       Community_Visibility @default(public)
  tags             String[]
  location         Json?
  metadata         Json?
  isPinned         Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  likesCount       Int                  @default(0)
  commentsCount    Int                  @default(0)
  sharesCount      Int                  @default(0)
  status           Community_PostStatus @default(published)
  publishedAt      DateTime?            @db.Timestamp(6)
  moderatedBy      String?              @db.Uuid
  moderatedAt      DateTime?            @db.Timestamp(6)
  moderationReason String?
