  operator   String
  value      Json
  createdAt  DateTime               @default(now())
  campaign   Campaign_Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_conditions")
}

model Campaign_Product {
  id            String            @id @default(cuid()) @db.VarChar(64)
  campaignId    String @db.VarChar(64)
  productId     String            @db.VarChar(64)
