  endDate      DateTime?
  timezone     String                 @default("UTC")
  autoApply    Boolean                @default(true)
  autoRevert   Boolean                @default(true)
  sellerId     String                 @db.VarChar(64)
  createdBy    String                 @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  categories   Campaign_Category[]
  conditions   Campaign_Condition[]
  metrics      Campaign_Metrics?
  pricingRules Campaign_PricingRule[]
  products     Campaign_Product[]

