  @@map("global_outbox_events")
}

model Support_OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("support_outbox_events")
}

// --- enabler-service Service Models ---

// Enabler Service Database Schema
// Sales enabler management, product listings, facilitated orders, and commission tracking

// Core enabler profile with verification and performance tracking
model Enabler_Profile {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @db.Uuid
  businessName        String  @db.VarChar(255)
  contactEmail        String  @db.VarChar(255)
  contactPhone        String? @db.VarChar(50)
  businessDescription String?

  // Status and verification
  status             Enabler_Status @default(PENDING)
  verificationStatus String         @default("unverified") // unverified, pending, verified, rejected
  verifiedAt         DateTime?      @db.Timestamp(6)
  verifiedBy         String?        @db.Uuid

  // Commission tier and performance
  tier           Enabler_Tier @default(BRONZE)
  commissionRate Decimal      @db.Decimal(5, 4) // Base commission rate based on tier

  // Performance metrics
  totalSales            Decimal  @default(0) @db.Decimal(12, 2)
  totalOrders           Int      @default(0)
  conversionRate        Decimal  @default(0) @db.Decimal(5, 4)
  customerRating        Decimal? @db.Decimal(3, 2)
  totalCommissionEarned Decimal  @default(0) @db.Decimal(12, 2)

  // Business details
  businessAddress    String?
  taxId              String? @db.VarChar(100)
  bankAccountDetails Json? // Encrypted bank account information

  // Approval workflow
  approvedBy      String?   @db.Uuid
  approvedAt      DateTime? @db.Timestamp(6)
  rejectionReason String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  productListings Enabler_ProductListing[]
  orders          Enabler_Order[]
  commissions     Enabler_Commission[]
  policies        Enabler_Policy[]
  analytics       Enabler_Analytics?

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("enabler_profiles")
}

// Junction table for enabler-product relationships
model Enabler_ProductListing {
  id        String @id @default(uuid()) @db.Uuid
  enablerId String @db.Uuid
  productId String @db.Uuid
  sellerId  String @db.Uuid

  // Listing details
  status     Enabler_ListingStatus @default(ACTIVE)
  visibility Boolean               @default(true)

  // Custom pricing (if different from base product)
  customPrice Decimal? @db.Decimal(10, 2)
  priceMarkup Decimal? @db.Decimal(5, 4) // Percentage markup

  // Listing terms
  listingTerms     Json? // Custom terms, restrictions, promotional info
  sellerApproved   Boolean   @default(false)
  sellerApprovedAt DateTime? @db.Timestamp(6)

  // Performance tracking
  views   Int     @default(0)
  clicks  Int     @default(0)
  orders  Int     @default(0)
  revenue Decimal @default(0) @db.Decimal(12, 2)

  // Metadata
  metadata  Json?
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  expiresAt DateTime? @db.Timestamp(6)

  // Relations
  enabler Enabler_Profile @relation(fields: [enablerId], references: [id], onDelete: Cascade)

  @@unique([enablerId, productId])
  @@index([enablerId])
  @@index([productId])
  @@index([sellerId])
  @@index([status])
  @@map("enabler_product_listings")
}

// Enabler-facilitated orders
model Enabler_Order {
  id               String @id @default(uuid()) @db.Uuid
  enablerId        String @db.Uuid
  orderId          String @unique @db.Uuid // Reference to main order
  sellerId         String @db.Uuid
  buyerId          String @db.Uuid
  productListingId String @db.Uuid

  // Order details
  status            Enabler_OrderStatus @default(PENDING)
  orderAmount       Decimal             @db.Decimal(12, 2)
  productAmount     Decimal             @db.Decimal(12, 2) // Amount going to seller
  enablerCommission Decimal             @db.Decimal(12, 2)
  platformFee       Decimal             @default(0) @db.Decimal(12, 2)

  // Commission breakdown
  commissionRate   Decimal @db.Decimal(5, 4)
  tierBonus        Decimal @default(0) @db.Decimal(12, 2)
  performanceBonus Decimal @default(0) @db.Decimal(12, 2)

  // Settlement tracking
  sellerPaidAt     DateTime? @db.Timestamp(6)
  enablerPaidAt    DateTime? @db.Timestamp(6)
  settlementStatus String    @default("pending") // pending, processing, completed, failed

  // Dispute and cancellation
  cancelledAt        DateTime? @db.Timestamp(6)
  cancellationReason String?
  disputeStatus      String?   @default("none") // none, raised, under_review, resolved

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  enabler          Enabler_Profile     @relation(fields: [enablerId], references: [id])
  commissionRecord Enabler_Commission?

  @@index([enablerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@index([settlementStatus])
  @@map("enabler_orders")
}

// Commission records for enabler sales
model Enabler_Commission {
  id             String  @id @default(uuid()) @db.Uuid
  enablerId      String  @db.Uuid
  enablerOrderId String  @unique @db.Uuid
  commissionId   String? @unique @db.Uuid // Reference to main commission record

  // Commission details
  baseCommission   Decimal @db.Decimal(12, 2)
  tierBonus        Decimal @default(0) @db.Decimal(12, 2)
  performanceBonus Decimal @default(0) @db.Decimal(12, 2)
  totalCommission  Decimal @db.Decimal(12, 2)

  // Status and approval
  status     String    @default("pending") // pending, approved, on_hold, paid, disputed
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamp(6)

  // Hold and protection
  holdUntil        DateTime? @db.Timestamp(6) // Commission hold period
  protectionStatus String    @default("active") // active, released, forfeited
  fraudCheckStatus String    @default("pending") // pending, cleared, flagged

  // Payout tracking
  payoutId      String?   @db.Uuid
  paidAt        DateTime? @db.Timestamp(6)
  paymentMethod String?

  // Calculation breakdown
  calculationDetails Json? // Detailed breakdown of commission calculation

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  enabler      Enabler_Profile @relation(fields: [enablerId], references: [id])
  enablerOrder Enabler_Order   @relation(fields: [enablerOrderId], references: [id])

  @@index([enablerId])
  @@index([status])
  @@index([holdUntil])
  @@index([paidAt])
  @@map("enabler_commissions")
}

// Business policies and rules for enabler operations
model Enabler_Policy {
  id          String  @id @default(uuid()) @db.Uuid
  enablerId   String? @db.Uuid // Null for global policies
  policyType  String  @db.VarChar(100) // approval, listing, commission, settlement
  policyName  String  @db.VarChar(255)
  policyRules Json // Policy rules and conditions

  // Scope
  isGlobal    Boolean  @default(false)
  sellerIds   String[] // Specific sellers this policy applies to
  categoryIds String[] // Product categories this policy applies to

  // Status
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime  @default(now()) @db.Timestamp(6)
  effectiveUntil DateTime? @db.Timestamp(6)

  // Metadata
  createdBy String   @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  enabler Enabler_Profile? @relation(fields: [enablerId], references: [id], onDelete: Cascade)

  @@index([enablerId])
  @@index([policyType])
  @@index([isGlobal])
  @@map("enabler_policies")
}

// Performance analytics for enablers
model Enabler_Analytics {
  id        String @id @default(uuid()) @db.Uuid
  enablerId String @unique @db.Uuid

  // Sales metrics
  totalSales        Decimal @default(0) @db.Decimal(12, 2)
  totalOrders       Int     @default(0)
  averageOrderValue Decimal @default(0) @db.Decimal(12, 2)

  // Performance metrics
  conversionRate Decimal  @default(0) @db.Decimal(5, 4)
  customerRating Decimal? @db.Decimal(3, 2)
  responseTime   Int? // Average response time in minutes

  // Commission metrics
  totalCommissions   Decimal @default(0) @db.Decimal(12, 2)
  averageCommission  Decimal @default(0) @db.Decimal(12, 2)
  pendingCommissions Decimal @default(0) @db.Decimal(12, 2)

  // Customer metrics
  totalCustomers    Int     @default(0)
  repeatCustomers   Int     @default(0)
  customerRetention Decimal @default(0) @db.Decimal(5, 4)

  // Quality metrics
  disputeRate      Decimal @default(0) @db.Decimal(5, 4)
  cancellationRate Decimal @default(0) @db.Decimal(5, 4)
  fraudScore       Decimal @default(0) @db.Decimal(5, 4)

  // Activity tracking
  lastSaleAt     DateTime? @db.Timestamp(6)
  lastActivityAt DateTime? @db.Timestamp(6)

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  enabler Enabler_Profile @relation(fields: [enablerId], references: [id], onDelete: Cascade)

  @@index([enablerId])
  @@map("enabler_analytics")
}

// Enums for enabler service
enum Enabler_Status {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED

  @@map("enabler_status")
}

enum Enabler_Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM

  @@map("enabler_tier")
}

enum Enabler_ListingStatus {
  ACTIVE
  PAUSED
  EXPIRED
  REMOVED

  @@map("enabler_listing_status")
}

enum Enabler_OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  DISPUTED

  @@map("enabler_order_status")
}

// Transactional outbox for event-driven communication
model Enabler_OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING") // PENDING,  PROCESSING, SENT, FAILED
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("enabler_outbox_events")
}

// --- campaign-service Service Models ---

model Campaign_Campaign {
  id          String          @id @default(uuid())
  name        String
  description String?
  type        Campaign_Type
  status      Campaign_Status @default(DRAFT)
  startDate   DateTime
  endDate     DateTime?
  timezone    String          @default("UTC")
  autoApply   Boolean         @default(true)
  autoRevert  Boolean         @default(true)
  sellerId    String          @db.Uuid
  createdBy   String          @db.Uuid
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  pricingRules Campaign_PricingRule[]
  conditions   Campaign_Condition[]
  products     Campaign_Product[]
  categories   Campaign_Category[]
  metrics      Campaign_Metrics?

  @@index([sellerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model Campaign_PricingRule {
  id         String            @id @default(uuid())
  campaignId String
  ruleType   Campaign_RuleType
  value      Decimal           @db.Decimal(10, 2)
  priority   Int               @default(0)
  conditions Json?
  createdAt  DateTime          @default(now())

  campaign Campaign_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_pricing_rules")
}

model Campaign_Condition {
  id         String                 @id @default(uuid())
  campaignId String
  type       Campaign_ConditionType
  operator   String
  value      Json
  createdAt  DateTime               @default(now())

  campaign Campaign_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_conditions")
}

model Campaign_Product {
  id            String    @id @default(uuid())
  campaignId    String
  productId     String    @db.Uuid
  originalPrice Json
  campaignPrice Json
  appliedAt     DateTime?
  revertedAt    DateTime?

  campaign Campaign_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
  @@map("campaign_products")
}

model Campaign_Category {
  id         String   @id @default(uuid())
  campaignId String
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())

  campaign Campaign_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
  @@map("campaign_categories")
}

model Campaign_Metrics {
  id                     String   @id @default(uuid())
  campaignId             String   @unique
  views                  Int      @default(0)
  conversions            Int      @default(0)
  revenue                Decimal  @default(0) @db.Decimal(12, 2)
  totalProductsAffected  Int      @default(0)
  totalRevenueImpact     Decimal  @default(0) @db.Decimal(12, 2)
  averageDiscountPercent Float    @default(0)
  updatedAt              DateTime @updatedAt

  campaign Campaign_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_metrics")
}

model Campaign_OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("campaign_outbox_events")
}

enum Campaign_Type {
  DISCOUNT
  PROMOTION
  CLEARANCE
  SEASONAL
}

enum Campaign_Status {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Campaign_RuleType {
  FIXED_DISCOUNT
  PERCENTAGE_DISCOUNT
  FIXED_PRICE
  BUY_GET
}

enum Campaign_ConditionType {
  MIN_ORDER_VALUE
  MAX_USES_PER_CUSTOMER
  CUSTOMER_SEGMENT
  GEOGRAPHIC_REGION
}

// --- community-service Service Models ---

// Business-focused community and knowledge sharing platform

// Discussion threads for Q&A
model Community_DiscussionThread {
  id                  String                   @id @default(uuid())
  authorId            String
  topic               String
  content             String
  category            String
  status              Community_ThreadStatus   @default(OPEN)
  expertiseLevel      Community_ExpertiseLevel
  businessContext     Json // { industry: string[], businessStage: string, tags: string[] }
  maxResponsesPerUser Int                      @default(3)
  acceptedAnswerId    String?
  resolvedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  answers Community_ThreadAnswer[]

  @@index([authorId])
  @@index([category, status])
  @@index([status, createdAt])
  @@map("community_discussion_threads")
}

// Answers to discussion threads
model Community_ThreadAnswer {
  id           String   @id @default(uuid())
  threadId     String
  authorId     String
  content      String
  qualityScore Int      @default(0)
  isAccepted   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  thread Community_DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([isAccepted])
  @@map("community_thread_answers")
}

// Extended business profiles for users
model Community_BusinessProfile {
  id                     String                   @id @default(uuid())
  userId                 String                   @unique
  businessId             String?
  expertiseAreas         Json // Array of { area: string, level: string, verifiedAt?: Date }
  industryExperience     String[]
  certifications         String[]
  contributionScore      Int                      @default(0)
  contributionMetrics    Json // { helpfulAnswers, knowledgeShared, mentorshipHours, etc. }
  reputationTier         Community_ReputationTier @default(NEWCOMER)
  businessGoals          Json // Array of goals
  learningObjectives     Json // Array of learning objectives
  availableForMentorship Boolean                  @default(false)
  mentorshipCapacity     Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([userId])
  @@index([reputationTier])
  @@map("community_business_profiles")
}

// Knowledge articles for long-form educational content
model Community_KnowledgeArticle {
  id               String                   @id @default(uuid())
  authorId         String
  title            String
  summary          String
  sections         Json // Array of { heading, content, order }
  category         String
  industryTags     String[]
  expertiseLevel   Community_ExpertiseLevel
  reviewStatus     Community_ReviewStatus   @default(DRAFT)
  qualityScore     Int                      @default(0)
  version          Int                      @default(1)
  trainingModuleId String?
  publishedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  reviews Community_ArticleReview[]

  @@index([authorId])
  @@index([category, reviewStatus])
  @@index([reviewStatus, publishedAt])
  @@map("community_knowledge_articles")
}

// Peer reviews for knowledge articles
model Community_ArticleReview {
  id         String   @id @default(uuid())
  articleId  String
  reviewerId String
  score      Int
  feedback   String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  article Community_KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([reviewerId])
  @@map("community_article_reviews")
}

// Business challenges for collaborative problem-solving
model Community_BusinessChallenge {
  id                 String                    @id @default(uuid())
  proposerId         String
  title              String
  description        String
  category           String
  industryTags       String[]
  constraints        String[]
  successCriteria    Json // Array of criteria
  status             Community_ChallengeStatus @default(OPEN)
  deadline           DateTime?
  acceptedSolutionId String?
  collaborators      String[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  solvedAt           DateTime?

  solutions Community_ChallengeSolution[]

  @@index([proposerId])
  @@index([category, status])
  @@index([status, deadline])
  @@map("community_business_challenges")
}

// Solutions to business challenges
model Community_ChallengeSolution {
  id             String   @id @default(uuid())
  challengeId    String
  authorId       String
  solution       String
  approach       String
  implementation String?
  isAccepted     Boolean  @default(false)
  votes          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge Community_BusinessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([authorId])
  @@map("community_challenge_solutions")
}

// Engagement quotas for rate limiting
model Community_EngagementQuota {
  id              String   @id @default(uuid())
  userId          String
  quotaType       String // THREAD, ANSWER, ARTICLE, CHALLENGE, COMMENT
  dailyLimit      Int
  weeklyLimit     Int
  dailyUsed       Int      @default(0)
  weeklyUsed      Int      @default(0)
  dailyRemaining  Int
  weeklyRemaining Int
  lastResetDaily  DateTime @default(now())
  lastResetWeekly DateTime @default(now())
  qualityBonus    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, quotaType])
  @@index([userId])
  @@map("community_engagement_quotas")
}

// Contribution history for tracking user actions
model Community_ContributionHistory {
  id           String   @id @default(uuid())
  userId       String
  actionType   String // ANSWER, ARTICLE, CHALLENGE, ENDORSEMENT, etc.
  contentId    String
  contentType  String
  pointsEarned Int      @default(0)
  qualityScore Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, actionType])
  @@map("community_contribution_history")
}

// User interactions for discovery and analytics
model Community_UserInteraction {
  id              String   @id @default(uuid())
  userId          String
  contentId       String
  contentType     String // THREAD, ARTICLE, CHALLENGE
  category        String
  interactionType String // VIEW, UPVOTE, COMMENT, BOOKMARK
  timestamp       DateTime @default(now())

  @@index([userId, timestamp])
  @@index([contentId, interactionType])
  @@map("community_user_interactions")
}

// Peer endorsements for expertise validation
model Community_PeerEndorsement {
  id            String   @id @default(uuid())
  endorserId    String
  endorseeId    String
  expertiseArea String
  message       String?
  createdAt     DateTime @default(now())

  @@unique([endorserId, endorseeId, expertiseArea])
  @@index([endorseeId, expertiseArea])
  @@map("community_peer_endorsements")
}

// Enums
enum Community_ThreadStatus {
  OPEN
  ACTIVE
  RESOLVED
  CLOSED
}

enum Community_ExpertiseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Community_ReputationTier {
  NEWCOMER
  CONTRIBUTOR
  EXPERT
  MENTOR
  THOUGHT_LEADER
}

enum Community_ReviewStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum Community_ChallengeStatus {
  OPEN
  IN_PROGRESS
  SOLVED
  CLOSED
}

// Outbox for event publishing
model Community_OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("community_outbox_events")
}
