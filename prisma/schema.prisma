  deliveryCodeUsedAt     DateTime?
  verificationDeadlineAt    DateTime?
  verificationTimeoutMinutes Int?            @default(30)
  orderSource            Order_OrderSource   @default(CART)
  orderCompletionMethod  Order_OrderCompletionMethod?
  chatConversationId     String?             @db.VarChar(64)
  declineReason          String?             @db.Text
  quoteId                String?             @db.VarChar(64)
  pricingVersion         Int?
  /// Idempotency anchor for Maysar Request → order conversion (§1.6).
  /// One accepted Request quote → exactly one normal Order_Order; the unique
  /// index makes a second conversion attempt return the existing order.
  requestQuoteId         String?             @unique @db.VarChar(64)
  /// The seller location chosen as fulfillment pickup point at checkout
  fulfillmentLocationId  String?             @db.VarChar(64)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  version                Int                 @default(0)
  codDisputes            Order_CODDispute[]
  items                  Order_OrderItem[]
  payments               Order_Payment[]
  settlements            Order_Settlement[]
  verificationAuditLogs  Order_VerificationAuditLog[]
  masterOrderItems       Order_MasterOrderItem[]      // back-reference for multi-seller
  /// Enabler capability (Enabler §24/§43) — the draft that produced this order,
  /// the attribution rows pointing at it, and the enabler earning anchored to
  /// it. The Order domain remains the single source of truth for commerce.
  enablerDrafts          Enabler_OrderDraft[]
  enablerAttributions    Enabler_Attribution[]
  enablerEarnings        Enabler_Earning[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([enablerId])
  @@map("orders")
}

