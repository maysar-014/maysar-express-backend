model Order_Order {
  id                     String              @id @default(cuid()) @db.VarChar(64)
  trackingNumber         String?             @unique @db.VarChar(32)
  buyerId                String
  sellerId               String @db.VarChar(64)
  enablerId              String? @db.VarChar(64)
  enablerCode            String?
  status                 Order_OrderStatus   @default(PENDING)
  paymentMethod          Order_PaymentMethod
  totalAmount            Decimal
  currency               String              @default("TZS")
  totalWeight            Float
  deliveryAddress        Json
  codCommitmentFee       Decimal?
  codCommitmentPaid      Boolean             @default(false)
  codReputationScore     Int?
  codEligibilityChecked  Boolean             @default(false)
  codDeliveryOtp         String?
  codOtpExpiresAt        DateTime?
