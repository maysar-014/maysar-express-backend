datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- analytics-service Service Models ---

model Analytics_EnablerAnalytics {
  enablerId              String    @id
  trainingsScheduled     Int?      @default(0)
  lastTrainingDate       DateTime?
  certificatesIssued     Int?      @default(0)
  sellersOnboarded       Int?      @default(0)
  totalEarnings          Float?    @default(0.0)
  lastActivity           DateTime?
  supportTicketsResolved Int?      @default(0)
  successRate            Float?    @default(0.0)
  salesSupported         Int?      @default(0)
  totalSalesValue        Float?    @default(0.0)
  conversionRate         Float?    @default(0.0)
  skillCertifications    Int?      @default(0)
  skillLevel             String?
  createdAt              DateTime  @default(now())
}

model Analytics_SellerMetrics {
  sellerId              String   @id
  averageOrderValue     Float?
  conversionRate        Float?
  customerLifetimeValue Float?
  returnRate            Float?
  profitMargin          Float?
  activeVisitors        Int?
  cartAbandonment       Int?
  liveOrders            Int?
  inventoryAlerts       Int?
  customerInquiries     Int?
  createdAt             DateTime @default(now())
}

model Analytics_SalesAnalytics {
  id        String   @id @default(uuid())
  sellerId  String
  date      DateTime
  insights  String? // JSON string
  createdAt DateTime @default(now())
}

model Analytics_SupplierAnalytics {
  supplierId          String    @id
  resourceUtilization Json?
  lastUpdated         DateTime?
  qualityScore        Float?
  certificatesIssued  Int?      @default(0)
  ordersShipped       Int?      @default(0)
  lastShipment        DateTime?
  totalRevenue        Float?    @default(0.0)
  paymentsReceived    Int?      @default(0)
  pricingUpdates      Int?      @default(0)
  activeProducts      Int?      @default(0)
  createdAt           DateTime  @default(now())
}

model Analytics_CourierAnalytics {
  courierId           String    @id
  performanceScore    Float?
  lastAnalysis        DateTime?
  totalEarnings       Float?    @default(0.0)
  deliveriesCompleted Int?      @default(0)
  lastDelivery        DateTime?
  totalPayouts        Float?    @default(0.0)
  payoutsReceived     Int?      @default(0)
  vehicleStatus       String?
  lastVehicleUpdate   DateTime?
  kycStatus           String?
  kycCompletedAt      DateTime?
  createdAt           DateTime  @default(now())
}

model Analytics_Metric {
  id         String   @id @default(uuid())
  metricType String
  value      Float
  dimension  String
  period     String
  timestamp  DateTime
  confidence Float
  createdAt  DateTime @default(now())

  @@index([metricType, timestamp])
  @@index([dimension, metricType])
}

// --- auth-service Service Models ---

// Prisma schema for Authentication Service
// This schema defines the database structure for user authentication and authorization

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model Auth_User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         Auth_UserRole   @default(BUYER)
  status       Auth_UserStatus @default(PENDING_VERIFICATION)

  // Profile Information
  phoneNumber     String?
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  // Security Tracking
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?

  // Two-Factor Authentication
  twoFactorEnabled Boolean             @default(false)
  twoFactorSecret  String?
  twoFactorAuth    User_TwoFactorAuth?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions                Auth_Session[]
  passwordResetTokens     Auth_PasswordResetToken[]
  emailVerificationTokens Auth_EmailVerificationToken[]
  auditLogs               Auth_AuditLog[]

  @@map("auth_users")
}

model User_TwoFactorAuth {
  id          String    @id @default(cuid())
  userId      String    @unique
  method      String // 'totp' or 'sms'
  secret      String // Encrypted TOTP secret
  backupCodes Json // Array of hashed backup codes
  isEnabled   Boolean   @default(false)
  isVerified  Boolean   @default(false)
  deviceName  String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user Auth_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor_auth")
}

// ============================================================================
// SESSION MANAGEMENT
// ============================================================================

model Auth_Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user Auth_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

// ============================================================================
// PASSWORD RESET TOKENS
// ============================================================================

model Auth_PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user Auth_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_password_reset_tokens")
}

// ============================================================================
// EMAIL VERIFICATION TOKENS
// ============================================================================

model Auth_EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user Auth_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_email_verification_tokens")
}

// ============================================================================
// AUDIT LOGGING
// ============================================================================

model Auth_AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  action    String
  ipAddress String
  userAgent String
  success   Boolean
  reason    String?
  metadata  Json?
  timestamp DateTime @default(now())

  // Relations
  user Auth_User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("auth_audit_logs")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Auth_UserRole {
  BUYER    @map("buyer")
  SELLER   @map("seller")
  SUPPLIER @map("supplier")
  COURIER  @map("courier")
  ENABLER  @map("enabler")
  SYSTEM   @map("system")
}

enum Auth_UserStatus {
  PENDING_VERIFICATION @map("pending_verification")
  ACTIVE               @map("active")
  SUSPENDED            @map("suspended")
  DEACTIVATED          @map("deactivated")
  LOCKED               @map("locked")
}

// ============================================================================
// INDEXES AND CONSTRAINTS
// ============================================================================

// Additional indexes for performance
model Auth_UserIndex {
  userId    String
  indexType String
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, indexType])
  @@map("auth_user_indexes")
}

// --- business-registry-service Service Models ---

model BusinessRegistry_Business {
  id                 String                              @id @default(cuid())
  name               String
  businessType       BusinessRegistry_BusinessType
  registrationNumber String                              @unique
  taxId              String?                             @unique
  status             BusinessRegistry_BusinessStatus     @default(PENDING)
  verificationStatus BusinessRegistry_VerificationStatus @default(UNVERIFIED)
  complianceStatus   BusinessRegistry_ComplianceStatus   @default(UNDER_REVIEW)
  ownerId            String
  description        String?
  industry           String?
  website            String?
  email              String?
  phoneNumber        String?

  verifiedAt DateTime?
  verifiedBy String?

  attributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses         BusinessRegistry_BusinessAddress[]
  documents         BusinessRegistry_BusinessDocument[]
  complianceRecords BusinessRegistry_ComplianceRecord[]

  @@map("businessregistry_businesses")
}

model BusinessRegistry_BusinessAddress {
  id         String                       @id @default(cuid())
  businessId String
  type       BusinessRegistry_AddressType @default(MAIN)
  street     String
  city       String
  region     String
  postalCode String?
  country    String                       @default("Tanzania")
  isPrimary  Boolean                      @default(false)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  business BusinessRegistry_Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_business_addresses")
}

model BusinessRegistry_BusinessDocument {
  id         String                          @id @default(cuid())
  businessId String
  type       BusinessRegistry_DocumentType
  fileName   String
  fileUrl    String
  status     BusinessRegistry_DocumentStatus @default(PENDING)
  uploadedAt DateTime                        @default(now())
  verifiedAt DateTime?

  business BusinessRegistry_Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_business_documents")
}

model BusinessRegistry_ComplianceRecord {
  id         String                            @id @default(cuid())
  businessId String
  type       BusinessRegistry_ComplianceType
  status     BusinessRegistry_ComplianceStatus
  checkedAt  DateTime                          @default(now())
  expiresAt  DateTime?
  notes      String?

  business BusinessRegistry_Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_compliance_records")
}

enum BusinessRegistry_BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LIMITED_LIABILITY
  CORPORATION
}

enum BusinessRegistry_BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  CLOSED
}

enum BusinessRegistry_VerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum BusinessRegistry_ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
}

enum BusinessRegistry_AddressType {
  MAIN
  BRANCH
  WAREHOUSE
  OTHER
}

enum BusinessRegistry_DocumentType {
  REGISTRATION_CERTIFICATE
  TAX_CERTIFICATE
  BUSINESS_LICENSE
  PROOF_OF_ADDRESS
  OWNER_ID
}

enum BusinessRegistry_DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessRegistry_ComplianceType {
  TAX_COMPLIANCE
  BUSINESS_LICENSE
  HEALTH_PERMIT
  ENVIRONMENTAL_CLEARANCE
}

model BusinessRegistry_OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("businessregistry_outbox_events")
}

// --- catalog-service Service Models ---

// Catalog Service Database Schema
// Complete product catalog management with categories and variants

// Hierarchical category system
model Catalog_Category {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String?  @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?
  imageUrl     String?  @db.VarChar(500)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  seoMetadata  Json?
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  // Relations
  parent   Catalog_Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Catalog_Category[] @relation("CategoryHierarchy")
  products Catalog_Product[]

  @@map("catalog_categories")
}

// Catalog_Product management with SEO
model Catalog_Product {
  id          String                @id @default(uuid()) @db.Uuid
  sellerId    String                @db.Uuid
  title       String                @db.VarChar(255)
  description String?
  categoryId  String                @db.Uuid
  brand       String?               @db.VarChar(100)
  model       String?               @db.VarChar(100)
  status      Catalog_ProductStatus @default(draft)
  visibility  Catalog_Visibility    @default(public)
  seoMetadata Json?
  tags        String[]
  createdAt   DateTime              @default(now()) @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @db.Timestamp(6)

  // Relations
  category Catalog_Category         @relation(fields: [categoryId], references: [id])
  variants Catalog_ProductVariant[]

  @@map("catalog_products")
}

// Catalog_Product variants with inventory policy
model Catalog_ProductVariant {
  id              String                  @id @default(uuid()) @db.Uuid
  productId       String                  @db.Uuid
  sku             String                  @unique @db.VarChar(100)
  name            String?                 @db.VarChar(255)
  price           Decimal                 @db.Decimal(10, 2)
  compareAtPrice  Decimal?                @db.Decimal(10, 2)
  costPrice       Decimal?                @db.Decimal(10, 2)
  inventoryPolicy Catalog_InventoryPolicy @default(deny)
  weight          Decimal?                @db.Decimal(8, 3)
  dimensions      Json?
  attributes      Json? // color, size, material, etc.
  images          Json?
  status          Catalog_VariantStatus   @default(active)
  createdAt       DateTime                @default(now()) @db.Timestamp(6)

  // Relations
  product Catalog_Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("catalog_product_variants")
}

// Media management for products and categories
model Catalog_MediaRef {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @db.VarChar(50) // product, category, seller
  entityId     String   @db.Uuid
  mediaType    String   @db.VarChar(50) // image, video, document
  url          String   @db.VarChar(500)
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  metadata     Json?
  uploadedBy   String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("catalog_media_refs")
}

// Enums
enum Catalog_ProductStatus {
  draft
  pending
  published
  suspended
  archived
}

enum Catalog_Visibility {
  public
  private
  unlisted
}

enum Catalog_InventoryPolicy {
  deny // Don't allow sales when out of stock
  allow // Allow backorders
}

enum Catalog_VariantStatus {
  active
  inactive
}

// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model Catalog_OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("catalog_outbox_events")
}

// --- checkout-service Service Models ---

// Checkout Service Database Schema
// Isolated data ownership - no cross-service queries

// Checkout_Cart entity - shopping cart management
model Checkout_Cart {
  id        String              @id @default(uuid())
  userId    String              @db.Uuid
  status    String              @default("active") // active, abandoned, converted
  items     Checkout_CartItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  expiresAt DateTime            @default(dbgenerated("now() + interval '7 days'"))

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// Checkout_Cart items - individual products in cart
model Checkout_CartItem {
  id          String        @id @default(uuid())
  cartId      String
  cart        Checkout_Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String        @db.Uuid
  variantId   String?       @db.Uuid
  quantity    Int
  priceAtTime Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// Checkout session - checkout flow state
model Checkout_CheckoutSession {
  id     String @id @default(uuid())
  cartId String
  userId String @db.Uuid
  status String @default("initiated") // initiated, payment_pending, completed, failed, abandoned

  // Checkout data
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?

  // Pricing
  subtotal       Decimal @db.Decimal(12, 2)
  shippingCost   Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  // Payment
  paymentMethodId String?
  paymentStatus   String? // pending, processing, completed, failed

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime @default(dbgenerated("now() + interval '1 hour'"))

  @@index([userId])
  @@index([status])
  @@index([cartId])
  @@index([expiresAt])
}

// Checkout_Order - created after successful checkout
model Checkout_Order {
  id                String @id @default(uuid())
  checkoutSessionId String
  userId            String @db.Uuid
  status            String @default("pending") // pending, confirmed, shipped, delivered, cancelled

  // Checkout_Order details
  items             Checkout_OrderItem[]
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?

  // Pricing
  subtotal       Decimal @db.Decimal(12, 2)
  shippingCost   Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  // Payment
  paymentMethodId String?
  paymentStatus   String  @default("pending")

  // Tracking
  trackingNumber String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Checkout_Order items - products in order
model Checkout_OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  order      Checkout_Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String         @db.Uuid
  variantId  String?        @db.Uuid
  quantity   Int
  unitPrice  Decimal        @db.Decimal(12, 2)
  totalPrice Decimal        @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())

  @@index([orderId])
}

// Inventory reservation - track reserved stock during checkout
model Checkout_InventoryReservation {
  id         String   @id @default(uuid())
  checkoutId String
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  quantity   Int
  status     String   @default("reserved") // reserved, confirmed, released
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([checkoutId, productId, variantId])
  @@index([checkoutId])
  @@index([status])
  @@index([expiresAt])
}

// Discount application - track applied discounts
model Checkout_AppliedDiscount {
  id            String   @id @default(uuid())
  checkoutId    String
  discountCode  String?
  discountType  String // percentage, fixed, shipping_free
  discountValue Decimal  @db.Decimal(12, 2)
  maxUses       Int?
  currentUses   Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([checkoutId])
  @@index([discountCode])
}

// --- commission-service Service Models ---

// Commission_Commission Service Database Schema
// Revenue sharing, referrals, and loyalty rewards management

// Commission_Commission calculations and payouts
model Commission_Commission {
  id        String                      @id @default(uuid()) @db.Uuid
  orderId   String                      @db.Uuid
  sellerId  String                      @db.Uuid
  amount    Decimal                     @db.Decimal(10, 2)
  rate      Decimal                     @db.Decimal(5, 4)
  type      Commission_CommissionType
  status    Commission_CommissionStatus @default(pending)
  paidAt    DateTime?                   @db.Timestamp(6)
  payoutId  String?                     @db.Uuid
  metadata  Json?
  createdAt DateTime                    @default(now()) @db.Timestamp(6)

  @@map("commissions")
}

// Commission_Referral program management
model Commission_Referral {
  id           String                    @id @default(uuid()) @db.Uuid
  referrerId   String                    @db.Uuid
  refereeId    String                    @db.Uuid
  referralCode String                    @unique @db.VarChar(50)
  status       Commission_ReferralStatus @default(pending)
  rewardAmount Decimal?                  @db.Decimal(8, 2)
  rewardPaid   Boolean                   @default(false)
  completedAt  DateTime?                 @db.Timestamp(6)
  expiresAt    DateTime                  @db.Timestamp(6)
  metadata     Json?
  createdAt    DateTime                  @default(now()) @db.Timestamp(6)

  @@map("commission_referrals")
}

// Loyalty rewards and bonuses
model Commission_Reward {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  type        Commission_RewardType
  amount      Decimal                 @db.Decimal(8, 2)
  description String?
  status      Commission_RewardStatus @default(earned)
  expiresAt   DateTime?               @db.Timestamp(6)
  redeemedAt  DateTime?               @db.Timestamp(6)
  referenceId String?                 @db.Uuid // order_id, referral_id, etc.
  createdAt   DateTime                @default(now()) @db.Timestamp(6)

  @@map("commission_rewards")
}

// Commission_Payout management
model Commission_Payout {
  id            String                  @id @default(uuid()) @db.Uuid
  recipientId   String                  @db.Uuid
  recipientType String
  amount        Decimal                 @db.Decimal(10, 2)
  status        Commission_PayoutStatus @default(pending)
  scheduledDate DateTime?               @db.Timestamp(6)
  processedDate DateTime?               @db.Timestamp(6)
  reference     String?
  metadata      Json?
  createdAt     DateTime                @default(now()) @db.Timestamp(6)

  @@map("commission_payouts")
}

// Event store for domain events
model Commission_EventStore {
  id           String   @id @default(uuid()) @db.Uuid
  aggregateId  String
  eventType    String
  eventData    Json
  occurredAt   DateTime @default(now()) @db.Timestamp(6)
  eventVersion Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("commission_event_store")
}

// Enums
enum Commission_CommissionType {
  sale
  referral
  bonus
  adjustment
  task_assignment
  task_completion
  collaboration_setup
}

enum Commission_CommissionStatus {
  pending
  approved
  paid
  rejected
  cancelled
}

enum Commission_ReferralStatus {
  pending
  completed
  expired
  cancelled
}

enum Commission_RewardType {
  referral
  loyalty
  bonus
  milestone
  promotional
}

enum Commission_RewardStatus {
  earned
  redeemed
  expired
  cancelled
}

enum Commission_PayoutStatus {
  pending
  scheduled
  processed
  cancelled
  failed
}

// --- community-service Service Models ---

// Community Service Database Schema
// Social features, posts, comments, and user engagement

// Social posts and content
model Community_Post {
  id               String               @id @default(uuid()) @db.Uuid
  authorId         String               @db.Uuid
  title            String?              @db.VarChar(255)
  content          String
  type             Community_PostType   @default(text)
  visibility       Community_Visibility @default(public)
  tags             String[]
  location         Json? // Geolocation data
  metadata         Json?
  isPinned         Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  likesCount       Int                  @default(0)
  commentsCount    Int                  @default(0)
  sharesCount      Int                  @default(0)
  status           Community_PostStatus @default(published)
  publishedAt      DateTime?            @db.Timestamp(6)
  moderatedBy      String?              @db.Uuid
  moderatedAt      DateTime?            @db.Timestamp(6)
  moderationReason String?
  createdAt        DateTime             @default(now()) @db.Timestamp(6)
  updatedAt        DateTime             @updatedAt @db.Timestamp(6)

  // Relations
  author    Community_User       @relation("PostAuthor", fields: [authorId], references: [id])
  likes     Community_Like[]
  comments  Community_Comment[]
  shares    Community_Share[]
  bookmarks Community_Bookmark[]

  @@map("community_posts")
}

// Community_User entity for community features
model Community_User {
  id             String               @id @default(uuid()) @db.Uuid
  username       String               @unique @db.VarChar(50)
  displayName    String               @db.VarChar(100)
  avatarUrl      String?              @db.VarChar(500)
  bio            String?              @db.VarChar(500)
  location       String?              @db.VarChar(100)
  website        String?              @db.VarChar(255)
  isVerified     Boolean              @default(false)
  reputation     Int                  @default(0)
  followersCount Int                  @default(0)
  followingCount Int                  @default(0)
  status         Community_UserStatus @default(active)
  lastActiveAt   DateTime             @db.Timestamp(6)
  createdAt      DateTime             @default(now()) @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @db.Timestamp(6)

  // Relations
  posts     Community_Post[]     @relation("PostAuthor")
  comments  Community_Comment[]
  likes     Community_Like[]
  shares    Community_Share[]
  followers Community_Follow[]   @relation("UserFollowers")
  following Community_Follow[]   @relation("UserFollowing")
  bookmarks Community_Bookmark[]

  @@map("community_users")
}

// Nested comments system
model Community_Comment {
  id               String                  @id @default(uuid()) @db.Uuid
  postId           String                  @db.Uuid
  authorId         String                  @db.Uuid
  parentId         String?                 @db.Uuid
  content          String
  likesCount       Int                     @default(0)
  repliesCount     Int                     @default(0)
  status           Community_CommentStatus @default(published)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?               @db.Timestamp(6)
  moderationReason String?
  createdAt        DateTime                @default(now()) @db.Timestamp(6)
  updatedAt        DateTime                @updatedAt @db.Timestamp(6)

  // Relations
  post    Community_Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Community_User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Community_Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Community_Comment[] @relation("CommentReplies")
  likes   Community_Like[]

  @@map("community_comments")
}

// Community_User engagement metrics
model Community_Like {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  postId    String?            @db.Uuid
  commentId String?            @db.Uuid
  type      Community_LikeType @default(like)
  createdAt DateTime           @default(now()) @db.Timestamp(6)

  // Relations
  user    Community_User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Community_Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Community_Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("community_likes")
}

// Social sharing
model Community_Share {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  platform  String?  @db.VarChar(50) // twitter, facebook, etc.
  createdAt DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user Community_User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Community_Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("community_shares")
}

// Community_Follow relationships
model Community_Follow {
  id          String                 @id @default(uuid()) @db.Uuid
  followerId  String                 @db.Uuid
  followingId String                 @db.Uuid
  status      Community_FollowStatus @default(accepted)
  createdAt   DateTime               @default(now()) @db.Timestamp(6)

  // Relations
  follower  Community_User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following Community_User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("community_follows")
}

// Content moderation reports
model Community_Report {
  id          String                 @id @default(uuid()) @db.Uuid
  reporterId  String                 @db.Uuid
  entityType  String                 @db.VarChar(50) // post, comment, user
  entityId    String                 @db.Uuid
  reason      Community_ReportReason
  description String?                @db.VarChar(1000)
  status      Community_ReportStatus @default(pending)
  reviewedBy  String?                @db.Uuid
  reviewedAt  DateTime?              @db.Timestamp(6)
  resolution  String?
  createdAt   DateTime               @default(now()) @db.Timestamp(6)

  @@map("community_reports")
}

// Trending topics and hashtags
model Community_Hashtag {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(100)
  usageCount    Int      @default(0)
  trendingScore Decimal  @default(0) @db.Decimal(5, 2)
  lastUsedAt    DateTime @db.Timestamp(6)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("community_hashtags")
}

// Community_User bookmarks/saves
model Community_Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user Community_User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Community_Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("community_bookmarks")
