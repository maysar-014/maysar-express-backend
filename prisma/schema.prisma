// ─── Seller Location & Product Inventory ─────────────────────────────────────

enum Catalog_LocationType {
  SHOP
  WAREHOUSE
  PICKUP_POINT
  HOME_BASED
  DISTRIBUTION_CENTER
}

enum Catalog_LocationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Catalog_StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// A seller-owned physical location (shop, warehouse, pickup point).
/// Each location has accurate geocoordinates used as delivery pickup points.
model Catalog_SellerLocation {
  id             String                    @id @db.VarChar(64)
  sellerId       String                    @db.VarChar(64)
  name           String                    @db.VarChar(255)
  type           Catalog_LocationType      @default(SHOP)
  status         Catalog_LocationStatus    @default(ACTIVE)
  // Tanzania canonical address
  street         String
  ward           String?
  district       String?
  region         String
  postalCode     String?
  country        String                    @default("Tanzania")
  // Accurate geocoordinates (required)
  latitude       Decimal                   @db.Decimal(10, 7)
  longitude      Decimal                   @db.Decimal(10, 7)
  // Meta
  isPrimary      Boolean                   @default(false)
  isActive       Boolean                   @default(true)
  operatingHours Json?
  notes          String?
  createdAt      DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamp(6)

  productLocations    Catalog_ProductLocation[]
  stockTransfersFrom  Catalog_StockTransfer[]   @relation("TransferFrom")
  stockTransfersTo    Catalog_StockTransfer[]   @relation("TransferTo")
  fulfillmentSelections Catalog_FulfillmentSelection[]

  @@index([sellerId])
  @@index([sellerId, status])
  @@index([latitude, longitude])
  @@map("catalog_seller_locations")
}

/// Inventory of a product at a specific seller location.
/// Products do NOT store addresses — this join table owns inventory.
model Catalog_ProductLocation {
  id                 String                 @id @db.VarChar(64)
  productId          String                 @db.VarChar(64)
  locationId         String                 @db.VarChar(64)
  sellerId           String                 @db.VarChar(64)
  quantityAvailable  Int                    @default(0)
  quantityReserved   Int                    @default(0)
  isAvailable        Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamp(6)
  updatedAt          DateTime               @updatedAt @db.Timestamp(6)

  location           Catalog_SellerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@index([sellerId])
  @@map("catalog_product_locations")
}

/// Records stock movement between a seller's own locations.
model Catalog_StockTransfer {
  id             String                       @id @db.VarChar(64)
  sellerId       String                       @db.VarChar(64)
  productId      String                       @db.VarChar(64)
  fromLocationId String                       @db.VarChar(64)
  toLocationId   String                       @db.VarChar(64)
  quantity       Int
  status         Catalog_StockTransferStatus  @default(PENDING)
  notes          String?
  initiatedBy    String?                      @db.VarChar(64)
  completedAt    DateTime?                    @db.Timestamp(6)
  createdAt      DateTime                     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                     @updatedAt @db.Timestamp(6)

  fromLocation   Catalog_SellerLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation     Catalog_SellerLocation       @relation("TransferTo",   fields: [toLocationId],   references: [id])

  @@index([sellerId])
  @@index([productId])
  @@map("catalog_stock_transfers")
}

/// Audit log: which location was selected at checkout and why.
model Catalog_FulfillmentSelection {
  id             String                 @id @db.VarChar(64)
  checkoutId     String                 @db.VarChar(64)
  productId      String                 @db.VarChar(64)
  sellerId       String                 @db.VarChar(64)
  locationId     String                 @db.VarChar(64)
  selectionBasis String                 @default("proximity")
  buyerLat       Decimal?               @db.Decimal(10, 7)
  buyerLng       Decimal?               @db.Decimal(10, 7)
  distanceKm     Decimal?               @db.Decimal(8, 3)
  stockAvailable Int?
  createdAt      DateTime               @default(now()) @db.Timestamp(6)

  location       Catalog_SellerLocation @relation(fields: [locationId], references: [id])

  @@index([checkoutId])
  @@map("catalog_fulfillment_selections")
}




enum Chat_ConversationType {
  BUYER_SELLER
  SELLER_SUPPLIER
  BUYER_COURIER
  SELLER_TEAM
}

enum Chat_MessageType {
  TEXT
  IMAGE
  VOICE_NOTE
  PRODUCT_CARD
  ORDER_REFERENCE
  LOCATION_PIN
  QUICK_ACTION
}

enum Chat_ModerationStatus {
  ACTIVE
  FLAGGED
  BLOCKED
  ARCHIVED
}

enum Chat_ParticipantRole {
  BUYER
  SELLER
  SUPPLIER
  COURIER
}

model Chat_Conversation {
  id                       String                         @id @default(cuid()) @db.VarChar(64)
  type                     Chat_ConversationType
  moderationStatus         Chat_ModerationStatus          @default(ACTIVE)
  relatedProductId         String?                        @db.VarChar(64)
  relatedOrderId           String?                        @db.VarChar(64)
  relatedShipmentId        String?                        @db.VarChar(64)
  relatedSupplierRequestId String?                        @db.VarChar(64)
  metadata                 Json?
  lastMessageAt            DateTime?                      @db.Timestamp(6)
  createdAt                DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt                DateTime                       @updatedAt @db.Timestamp(6)

  participants             Chat_ConversationParticipant[]
  messages                 Chat_Message[]

  @@index([relatedOrderId])
  @@index([relatedProductId])
  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model Chat_ConversationParticipant {
  conversationId String                @db.VarChar(64)
  userId         String                @db.VarChar(64)
  role           Chat_ParticipantRole
  lastReadAt     DateTime?             @db.Timestamp(6)
  isMuted        Boolean               @default(false)
  joinedAt       DateTime              @default(now()) @db.Timestamp(6)

  conversation   Chat_Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_conversation_participants")
}

model Chat_Message {
  id                String                @id @default(cuid()) @db.VarChar(64)
  conversationId    String                @db.VarChar(64)
  senderId          String                @db.VarChar(64)
  type              Chat_MessageType
  content           String?
  metadata          Json?
  moderationStatus  Chat_ModerationStatus @default(ACTIVE)
  moderationReason  String?               @db.VarChar(1000)
  moderationSignals Json?
  spamScore         Int?
  isDisputeEvidence Boolean               @default(false)
  deletedAt         DateTime?             @db.Timestamp(6)
  createdAt         DateTime              @default(now()) @db.Timestamp(6)

  conversation      Chat_Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  spamScoreLogs     Chat_SpamScoreLog[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Chat_UserBlock {
  blockerId  String   @db.VarChar(64)
  blockedId  String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("chat_user_blocks")
}

model Chat_ModerationReport {
  id             String   @id @default(cuid()) @db.VarChar(64)
  reporterId     String   @db.VarChar(64)
  messageId      String   @db.VarChar(64)
  conversationId String   @db.VarChar(64)
  reason         String
  reportedAt     DateTime @default(now()) @db.Timestamp(6)

  @@index([conversationId])
  @@index([reporterId])
  @@map("chat_moderation_reports")
}

model Chat_SpamScoreLog {
  id         String       @id @default(cuid()) @db.VarChar(64)
  messageId  String       @db.VarChar(64)
  score      Int
  signals    Json
  computedAt DateTime     @default(now()) @db.Timestamp(6)

  message    Chat_Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("chat_spam_score_logs")
}

model Chat_CheckoutLink {
  id             String   @id @default(cuid()) @db.VarChar(64)
  conversationId String   @db.VarChar(64)
  messageId      String   @db.VarChar(64)
  checkoutUrl    String
  isUsed         Boolean  @default(false)
  expiresAt      DateTime @db.Timestamp(6)
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  @@index([conversationId])
  @@index([expiresAt])
  @@map("chat_checkout_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat Moderation — Admin oversight, configurable suspicious phrases, dynamic patterns
// ─────────────────────────────────────────────────────────────────────────────

enum Chat_AdminReviewAction {
  APPROVE
  CONFIRM_BLOCK
  DELETE
}

enum Chat_PhraseMatchType {
  SUBSTRING
  REGEX
}

enum Chat_PhraseLanguage {
  EN
  SW
  OTHER
}

enum Chat_PhraseAction {
  FLAG
  BLOCK
}

enum Chat_PhraseSource {
  SEED
  ADMIN
  AUTO
}

enum Chat_EmergingPatternStatus {
  PENDING
  PROMOTED
  DISMISSED
}

model Chat_ModerationAction {
  id        String                 @id @default(cuid()) @db.VarChar(64)
  messageId String                 @db.VarChar(64)
  adminId   String                 @db.VarChar(64)
  action    Chat_AdminReviewAction
  notes     String?                @db.VarChar(500)
  createdAt DateTime               @default(now()) @db.Timestamp(6)

  @@index([messageId])
  @@map("chat_moderation_actions")
}

model Chat_SuspiciousPhrase {
  id           String               @id @default(cuid()) @db.VarChar(64)
  phrase       String               @unique @db.VarChar(300)
  matchType    Chat_PhraseMatchType @default(SUBSTRING)
  language     Chat_PhraseLanguage  @default(EN)
  category     String               @db.VarChar(64)
  description  String?              @db.VarChar(500)
  weight       Int                  @default(70)
  action       Chat_PhraseAction    @default(FLAG)
