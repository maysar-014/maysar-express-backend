generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analytics_EnablerAnalytics {
  enablerId              String    @id @db.VarChar(64)
  trainingsScheduled     Int?      @default(0)
  lastTrainingDate       DateTime?
  certificatesIssued     Int?      @default(0)
  sellersOnboarded       Int?      @default(0)
  totalEarnings          Float?    @default(0.0)
  lastActivity           DateTime?
  supportTicketsResolved Int?      @default(0)
  successRate            Float?    @default(0.0)
  salesSupported         Int?      @default(0)
  totalSalesValue        Float?    @default(0.0)
  conversionRate         Float?    @default(0.0)
  skillCertifications    Int?      @default(0)
  skillLevel             String?
  createdAt              DateTime  @default(now())
}

model Analytics_SellerMetrics {
  sellerId                       String                               @id @db.VarChar(64)
  averageOrderValue              Float?
  conversionRate                 Float?
  customerLifetimeValue          Float?
  returnRate                     Float?
  profitMargin                   Float?
  activeVisitors                 Int?
  cartAbandonment                Int?
  liveOrders                     Int?
  inventoryAlerts                Int?
  customerInquiries              Int?
  todaySales                     Decimal?                             @db.Decimal(12, 2)
  todayOrderCount                Int?
  thisMonthRevenue               Decimal?                             @db.Decimal(12, 2)
  lastMonthRevenue               Decimal?                             @db.Decimal(12, 2)
  monthOverMonthGrowth           Float?
  repeatCustomerRate             Float?
  bestPerformingProductId        String?
  bestPerformingProductRevenue   Decimal?                             @db.Decimal(12, 2)
  bestPerformingProductUnitsSold Int?
  pendingCustomerQuestions       Int?
  lowConversionProductCount      Int?
  profitabilityScore             Int?
  averageRating                  Float?
  responseRate                   Float?
  averageDeliveryTime            Float?
  lastUpdated                    DateTime                             @default(now())
  createdAt                      DateTime                             @default(now())
  actionItems                    Analytics_SellerActionItem[]
  dailySales                     Analytics_SellerDailySales[]
  inventoryHealth                Analytics_SellerInventoryHealth[]
  productPerformance             Analytics_SellerProductPerformance[]
}

model Analytics_SellerDailySales {
  id            String                  @id @default(cuid()) @db.VarChar(64)
  sellerId      String @db.VarChar(64)
  date          DateTime
  revenue       Decimal                 @db.Decimal(12, 2)
  orderCount    Int
  createdAt     DateTime                @default(now())
  sellerMetrics Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, date])
  @@index([sellerId, date])
  @@map("analytics_seller_daily_sales")
}

model Analytics_SellerProductPerformance {
  id             String                  @id @default(cuid()) @db.VarChar(64)
  sellerId       String @db.VarChar(64)
  productId      String @db.VarChar(64)
  views          Int                     @default(0)
  orders         Int                     @default(0)
  revenue        Decimal                 @db.Decimal(12, 2)
  conversionRate Float?
  lastUpdated    DateTime                @default(now())
  sellerMetrics  Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, productId])
  @@index([sellerId, revenue])
  @@map("analytics_seller_product_performance")
}

model Analytics_SellerInventoryHealth {
  id                String                  @id @default(cuid()) @db.VarChar(64)
  sellerId          String @db.VarChar(64)
  productId         String @db.VarChar(64)
  currentStock      Int
  stockStatus       String
  salesVelocity     Float?
  daysUntilStockout Int?
  lastUpdated       DateTime                @default(now())
  sellerMetrics     Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@unique([sellerId, productId])
  @@index([sellerId, stockStatus])
  @@map("analytics_seller_inventory_health")
}

model Analytics_SellerActionItem {
  id            String                  @id @default(cuid()) @db.VarChar(64)
  sellerId      String @db.VarChar(64)
  type          String
  priority      String
  title         String
  description   String
  productId     String? @db.VarChar(64)
  metadata      Json?
  isResolved    Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  sellerMetrics Analytics_SellerMetrics @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@index([sellerId, isResolved, priority])
  @@map("analytics_seller_action_items")
}

model Analytics_SalesAnalytics {
  id        String   @id @default(cuid()) @db.VarChar(64)
  sellerId  String @db.VarChar(64)
  date      DateTime
  insights  String?
  createdAt DateTime @default(now())
}

model Analytics_SupplierAnalytics {
  supplierId          String    @id @db.VarChar(64)
  resourceUtilization Json?
  lastUpdated         DateTime?
  qualityScore        Float?
  certificatesIssued  Int?      @default(0)
  ordersShipped       Int?      @default(0)
  lastShipment        DateTime?
  totalRevenue        Float?    @default(0.0)
  paymentsReceived    Int?      @default(0)
  pricingUpdates      Int?      @default(0)
  activeProducts      Int?      @default(0)
  createdAt           DateTime  @default(now())
}

model Analytics_CourierAnalytics {
  courierId           String    @id @db.VarChar(64)
  performanceScore    Float?
  lastAnalysis        DateTime?
  totalEarnings       Float?    @default(0.0)
  deliveriesCompleted Int?      @default(0)
  lastDelivery        DateTime?
  totalPayouts        Float?    @default(0.0)
  payoutsReceived     Int?      @default(0)
  vehicleStatus       String?
  lastVehicleUpdate   DateTime?
  kycStatus           String?
  kycCompletedAt      DateTime?
  createdAt           DateTime  @default(now())
}

model Analytics_Metric {
  id         String   @id @default(cuid()) @db.VarChar(64)
  metricType String
  value      Float
  dimension  String
  period     String
  timestamp  DateTime
  confidence Float
  createdAt  DateTime @default(now())

  @@index([metricType, timestamp])
  @@index([dimension, metricType])
}

model Analytics_Event {
  id          String   @id @default(cuid()) @db.VarChar(64)
  type        String
  data        Json
  timestamp   DateTime
  status      String
  processedAt DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, timestamp])
  @@index([type, timestamp])
}

model User {
  id                      String                        @id @default(cuid()) @db.VarChar(64)
  publicCode              String?                       @unique @db.VarChar(16)
  email                   String                        @unique
  passwordHash            String
  role                    Auth_UserRole                 @default(BUYER)
  status                  Auth_UserStatus               @default(PENDING_VERIFICATION)
  phoneNumber             String?
  isEmailVerified         Boolean                       @default(false)
  isPhoneVerified         Boolean                       @default(false)
  failedLoginAttempts     Int                           @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?
  twoFactorEnabled        Boolean                       @default(false)
  twoFactorSecret         String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  auditLogs               AuditLog[]
  emailVerificationTokens Auth_EmailVerificationToken[]
  passwordResetTokens     Auth_PasswordResetToken[]
  roleRequests            Auth_RoleRequest[]
  sessions                Session[]
  twoFactorAuth           User_TwoFactorAuth?

  @@map("auth_users")
}

model Auth_User {
  id               String          @id @default(cuid()) @db.VarChar(64)
  publicCode       String?         @unique @db.VarChar(16)
  email            String          @unique
  passwordHash     String
  role             Auth_UserRole   @default(BUYER)
  status           Auth_UserStatus @default(PENDING_VERIFICATION)
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  phoneNumber      String?
  isPhoneVerified  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("auth_user_sync")
}

model User_TwoFactorAuth {
  id          String    @id @default(cuid()) @db.VarChar(64)
  userId      String    @unique @db.VarChar(64)
  method      String
  secret      String
  backupCodes Json
  isEnabled   Boolean   @default(false)
  isVerified  Boolean   @default(false)
  deviceName  String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor_auth")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  token     String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Auth_PasswordResetToken {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_password_reset_tokens")
}

model Auth_EmailVerificationToken {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_email_verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String? @db.VarChar(64)
  email     String?
  action    String
  ipAddress String
  userAgent String
  success   Boolean
  reason    String?
  metadata  Json?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@map("auth_audit_logs")
}

model Auth_RoleRequest {
  id            String   @id @default(cuid()) @db.VarChar(64)
  userId        String   @db.VarChar(64)
  requestedRole String   @db.VarChar(32)
  status        String   @default("PENDING") @db.VarChar(32)
  justification String?
  metadata      Json?
  reviewedAt    DateTime?
  reviewedBy    String?  @db.VarChar(64)
  reviewNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([requestedRole, status])
  @@map("auth_role_requests")
}

model Auth_UserIndex {
  userId    String @db.VarChar(64)
  indexType String
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, indexType])
  @@map("auth_user_indexes")
}

model Business {
  id                 String                              @id @default(cuid()) @db.VarChar(64)
  name               String
  businessType       BusinessRegistry_BusinessType
  registrationNumber String                              @unique
  taxId              String?                             @unique
  status             BusinessRegistry_BusinessStatus     @default(PENDING)
  verificationStatus BusinessRegistry_VerificationStatus @default(UNVERIFIED)
  complianceStatus   BusinessRegistry_ComplianceStatus   @default(UNDER_REVIEW)
  ownerId            String
  description        String?
  industry           String[]
  website            String?
  email              String?
  phoneNumber        String?
  verifiedAt         DateTime?
  verifiedBy         String?
  attributes         Json?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  addresses          BusinessAddress[]
  documents          BusinessDocument[]
  complianceRecords  BusinessRegistry_ComplianceRecord[]

  @@map("businessregistry_businesses")
}

model BusinessAddress {
  id         String                       @id @default(cuid()) @db.VarChar(64)
  businessId String @db.VarChar(64)
  type       BusinessRegistry_AddressType @default(MAIN)
  street     String
  city       String
  region     String
  postalCode String?
  country    String                       @default("Tanzania")
  isPrimary  Boolean                      @default(false)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  business   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  suppliedProducts Product[]              @relation("ProductSupplierLocation")

  @@map("businessregistry_business_addresses")
}

model BusinessDocument {
  id         String                          @id @default(cuid()) @db.VarChar(64)
  businessId String @db.VarChar(64)
  type       BusinessRegistry_DocumentType
  fileName   String
  fileUrl    String
  status     BusinessRegistry_DocumentStatus @default(PENDING)
  uploadedAt DateTime                        @default(now())
  verifiedAt DateTime?
  business   Business                        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_business_documents")
}

model BusinessRegistry_ComplianceRecord {
  id         String                            @id @default(cuid()) @db.VarChar(64)
  businessId String @db.VarChar(64)
  type       BusinessRegistry_ComplianceType
  status     BusinessRegistry_ComplianceStatus
  checkedAt  DateTime                          @default(now())
  expiresAt  DateTime?
  notes      String?
  business   Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("businessregistry_compliance_records")
}

model OutboxEvent {
  id          String    @id @default(cuid()) @db.VarChar(64)
  eventId     String    @unique
  eventType   String
  eventData   Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("businessregistry_outbox_events")
}

model EventStore {
  id          String   @id @default(cuid()) @db.VarChar(64)
  eventId     String   @unique
  eventType   String
  aggregateId String
  version     Int
  timestamp   DateTime @default(now())
  payload     Json
  metadata    Json?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([aggregateId])
  @@index([eventType])
  @@map("event_store")
}

model Category {
  id           String              @id @default(cuid()) @db.VarChar(64)
  parentId     String?             @db.VarChar(64)
  name         String              @db.VarChar(255)
  slug         String              @unique @db.VarChar(255)
  description  String?
  imageUrl     String?             @db.VarChar(500)
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  seoMetadata  Json?
  createdAt    DateTime            @default(now()) @db.Timestamp(6)
  parent       Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]          @relation("CategoryHierarchy")
  products     Product[]
  attributes   CategoryAttribute[]
  enablerScopes Enabler_SellerAuthorizationScope[]

  @@map("catalog_categories")
}

model Product {
  id                    String                @id @default(cuid()) @db.VarChar(64)
  sellerId              String                @db.VarChar(64)
  title                 String                @db.VarChar(255)
  description           String?
  supplierLocationId    String?               @db.VarChar(64)
  supplierLocation      String?               @db.VarChar(100)
  categoryId            String                @db.VarChar(64)
  brand                 String?               @db.VarChar(100)
  model                 String?               @db.VarChar(100)
  status                Catalog_ProductStatus @default(draft)
  visibility            Catalog_Visibility    @default(public)
  seoMetadata           Json?
  tags                  String[]
  gtin                  String?               @db.VarChar(14)
  mpn                   String?               @db.VarChar(100)
  isbn                  String?               @db.VarChar(13)
  fingerprint           String?               @db.VarChar(64)
  fingerprintVersion    Int                   @default(1)
  slug                  String                @db.VarChar(300)
  seoTitle              String?               @db.VarChar(160)
  shortSeoDescription   String?               @db.VarChar(160)
  generatedDescription  String?
  qualityScore          Int                   @default(0)
  enablerEnabled        Boolean               @default(false)
  enablerCommissionRate Decimal?              @db.Decimal(5, 4)
  codAccepted           Boolean               @default(false)
  freeDelivery          Boolean               @default(false)
  condition             String                @default("new") @db.VarChar(20)
  /// Current product lifecycle state. One of: DRAFT, VALIDATING, MATCH_REVIEW,
  /// CONTENT_FAILED, QUALITY_FAILED, READY, PUBLISHED, UPDATED, REVALIDATION, ARCHIVED
  lifecycleState        String                @default("DRAFT") @db.VarChar(32)
  createdAt             DateTime              @default(now()) @db.Timestamp(6)
  updatedAt             DateTime              @updatedAt @db.Timestamp(6)
  variants              ProductVariant[]
  category              Category              @relation(fields: [categoryId], references: [id])
  supplierLocationRef   BusinessAddress?      @relation("ProductSupplierLocation", fields: [supplierLocationId], references: [id], onDelete: SetNull)
  structuredAttributes  ProductAttribute[]
  /// Enabler capability (Enabler §8) — seller-granted scope rows and the
  /// draft line items that reference this catalog product. Product truth is
  /// never duplicated by the Enabler domain.
  enablerScopes         Enabler_SellerAuthorizationScope[]
  enablerDraftItems     Enabler_OrderDraftItem[]

  @@unique([categoryId, fingerprint])
  @@unique([sellerId, slug])
  @@index([gtin])
  @@index([mpn])
  @@index([isbn])
  @@index([brand, model, categoryId])
  @@index([slug])
  @@index([supplierLocationId])
  @@index([lifecycleState])
  @@map("catalog_products")
}

model BuyBox {
  id              String                      @id @default(cuid()) @db.VarChar(64)
  productId       String                      @unique @db.VarChar(64)
  primarySellerId String                      @db.VarChar(64)
  primaryScore    Decimal                     @db.Decimal(6, 2)
  lastComputedAt  DateTime                    @db.Timestamp(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamp(6)
  compositeScore  Float?
  assignmentType  Catalog_AssignmentType?
  alternatives    Catalog_BuyBoxAlternative[]

  @@index([productId])
  @@map("catalog_buy_boxes")
}

model Catalog_BuyBoxAlternative {
  id             String  @id @default(cuid()) @db.VarChar(64)
  buyBoxId       String  @db.VarChar(64)
  sellerId       String  @db.VarChar(64)
  score          Decimal @db.Decimal(6, 2)
  rank           Int
  compositeScore Float?
  buyBox         BuyBox  @relation(fields: [buyBoxId], references: [id], onDelete: Cascade)

  @@index([buyBoxId])
  @@map("catalog_buy_box_alternatives")
}

model Catalog_CategoryStrategy {
  id                    String   @id @default(cuid()) @db.VarChar(64)
  categoryId            String   @unique @db.VarChar(64)
  name                  String
  weights               Json
  explorationBudget     Float    @default(0.10)
  createdAt             DateTime @default(now()) @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @db.Timestamp(6)
  createdByOperatorId   String   @db.VarChar(64)

  @@map("catalog_category_strategies")
}

model Catalog_ScoreSnapshot {
  id             String                 @id @default(cuid()) @db.VarChar(64)
  productId      String                 @db.VarChar(64)
  sellerId       String                 @db.VarChar(64)
  compositeScore Float
  signalValues   Json
  signalWeights  Json
  assignmentType Catalog_AssignmentType
  strategyName   String
  geographicZone String?
  anomalyFlags   Json?
  computedAt     DateTime               @db.Timestamp(6)

  @@index([productId, computedAt])
  @@index([sellerId])
  @@map("catalog_score_snapshots")
}

model Catalog_AnomalyFlag {
  id                    String    @id @default(cuid()) @db.VarChar(64)
  sellerId              String    @db.VarChar(64)
  signalName            String
  detectedValue         Float
  expectedMin           Float
  expectedMax           Float
  flaggedAt             DateTime  @db.Timestamp(6)
  clearedAt             DateTime? @db.Timestamp(6)
  clearedByOperatorId   String?

  @@index([sellerId, flaggedAt])
  @@map("catalog_anomaly_flags")
}

model Catalog_BuyBoxOverride {
  id         String    @id @default(cuid()) @db.VarChar(64)
  productId  String    @unique @db.VarChar(64)
  sellerId   String    @db.VarChar(64)
  operatorId String    @db.VarChar(64)
  reason     String
  startAt    DateTime  @db.Timestamp(6)
  endAt      DateTime? @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)

  @@index([productId, endAt])
  @@map("catalog_buy_box_overrides")
}

model Catalog_ZonePerformance {
  id                  String   @id @default(cuid()) @db.VarChar(64)
  sellerId            String   @db.VarChar(64)
  geographicZone      String
  deliverySuccessRate Float
  avgDeliveryDays     Float
  orderCount          Int
  updatedAt           DateTime @updatedAt @db.Timestamp(6)

  @@unique([sellerId, geographicZone])
  @@map("catalog_zone_performance")
}

model Catalog_OperatorAuditLog {
  id            String    @id @default(cuid()) @db.VarChar(64)
  operatorId    String    @db.VarChar(64)
  entityType    String
  entityId      String    @db.VarChar(64)
  field         String
  previousValue Json?
  newValue      Json?
  changedAt     DateTime  @default(now()) @db.Timestamp(6)

  @@index([entityType, entityId])
  @@map("catalog_operator_audit_logs")
}

model ProductVariant {
  id              String                  @id @default(cuid()) @db.VarChar(64)
  productId       String                  @db.VarChar(64)
  sku             String                  @unique @db.VarChar(100)
  name            String?                 @db.VarChar(255)
  price           Decimal                 @db.Decimal(10, 2)
  compareAtPrice  Decimal?                @db.Decimal(10, 2)
  costPrice       Decimal?                @db.Decimal(10, 2)
  inventoryPolicy Catalog_InventoryPolicy @default(deny)
  weight          Decimal?                @db.Decimal(8, 3)
  dimensions      Json?
  attributes      Json?
  images          Json?
  status          Catalog_VariantStatus   @default(active)
  createdAt       DateTime                @default(now()) @db.Timestamp(6)
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("catalog_product_variants")
}

model MediaRef {
  id           String   @id @default(cuid()) @db.VarChar(64)
  entityType   String   @db.VarChar(50)
  entityId     String   @db.VarChar(64)
  mediaType    String   @db.VarChar(50)
  url          String   @db.VarChar(500)
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  metadata     Json?
  uploadedBy   String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@map("catalog_media_refs")
}

model Catalog_ProductMatchAudit {
  id                 String                 @id @default(cuid()) @db.VarChar(64)
  candidateProductId String                 @db.VarChar(64)
  matchedProductId   String?                @db.VarChar(64)
  matchLevel         Catalog_MatchLevel
  matchScore         Decimal                @db.Decimal(5, 2)
  matchingCriteria   Json
  decision           Catalog_MatchDecision
  decidedBy          Catalog_MatchDecidedBy
  sellerId           String                 @db.VarChar(64)
  metadata           Json?
  createdAt          DateTime               @default(now()) @db.Timestamp(6)

  @@index([sellerId, createdAt])
  @@index([matchLevel])
  @@index([decision])
  @@map("catalog_product_match_audits")
}

model Catalog_MatchConfirmation {
  id                String                     @id @default(cuid()) @db.VarChar(64)
  auditId           String                     @db.VarChar(64)
  sellerId          String                     @db.VarChar(64)
  candidateProducts Json
  status            Catalog_ConfirmationStatus @default(PENDING)
  sellerChoice      String?
  expiresAt         DateTime                   @db.Timestamp(6)
  respondedAt       DateTime?                  @db.Timestamp(6)
  createdAt         DateTime                   @default(now()) @db.Timestamp(6)

  @@index([sellerId, status])
  @@index([expiresAt])
  @@map("catalog_match_confirmations")
}

model Catalog_ProductReview {
  id               String                    @id @default(cuid()) @db.VarChar(64)
  productId        String                    @db.VarChar(64)
  buyerId          String                    @db.VarChar(64)
  rating           Int
  comment          String?
  moderationStatus Catalog_ModerationStatus  @default(VISIBLE)
  submittedAt      DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamp(6)

  moderationLogs   Catalog_ReviewModerationLog[]

  @@unique([productId, buyerId])
  @@index([productId, moderationStatus])
  @@index([buyerId])
  @@map("catalog_product_reviews")
}

model Catalog_ReviewModerationLog {
  id             String                   @id @default(cuid()) @db.VarChar(64)
  reviewId       String                   @db.VarChar(64)
  adminId        String                   @db.VarChar(64)
  previousStatus Catalog_ModerationStatus
  newStatus      Catalog_ModerationStatus
