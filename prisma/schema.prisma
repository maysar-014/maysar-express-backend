// --- wallet-service Service Models ---

// Wallet_Wallet Service Database Schema
// Balance management and transaction ledger





// User wallets for platform currency
model Wallet_Wallet {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  balance       Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  status        Wallet_WalletStatus @default(ACTIVE)
  frozenAmount  Decimal  @default(0) @db.Decimal(10, 2)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  transactions  Wallet_Transaction[]

  @@map("wallets")
}

// Complete transaction ledger (append-only)
model Wallet_Transaction {
  id                 String   @id @default(uuid()) @db.Uuid
  walletId           String   @db.Uuid
  userId             String   @db.Uuid
  type               Wallet_TransactionType
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("TZS") @db.VarChar(3)
  balanceBefore      Decimal  @db.Decimal(10, 2)
  balanceAfter       Decimal  @db.Decimal(10, 2)
  frozenAmountBefore Decimal  @default(0) @db.Decimal(10, 2)
  frozenAmountAfter  Decimal  @default(0) @db.Decimal(10, 2)
  referenceType      String?  @db.VarChar(50) // order, refund, transfer, etc.
  referenceId        String?  @db.Uuid
  description        String?  @db.VarChar(255)
  metadata           Json?
  createdAt          DateTime @default(now()) @db.Timestamp(6)

  // Relations
  wallet        Wallet_Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

enum Wallet_WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum Wallet_TransactionType {
  CREDIT
  DEBIT
  FREEZE
  UNFREEZE
  TRANSFER_IN
  TRANSFER_OUT
  REFUND
  FEE
  ADJUSTMENT
  DEBIT_FROZEN
}

model Wallet_OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}

