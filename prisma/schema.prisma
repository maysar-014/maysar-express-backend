// ─── Multi-Seller Master Order ────────────────────────────────────────────────
// Groups N independent seller orders created from a single buyer checkout.
// Business logic lives on the individual Order_Order records (unchanged).
// This record exists purely for buyer UX — it is read-only after creation.

model Order_MasterOrder {
  id            String   @id @db.VarChar(64)  // MSR-MO-{YYYYMMDD}-{6alphanum}
  buyerId       String   @db.VarChar(64)
