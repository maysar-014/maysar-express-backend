                  "    pm.expect(summary.pendingAmount).to.be.a('number');",
                  "});",
                  "",
                  "console.log('✅ SAGA BUSINESS LOGIC: Seller commission summary updated with approved commission');"
                ]
              }
            }
          ]
        },
        {
