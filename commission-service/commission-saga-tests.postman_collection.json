                  "    pm.expect(jsonData.status).to.eql('healthy');",
                  "});",
                  "",
                  "pm.test(\"Saga orchestration completed successfully\", function () {",
                  "    // Final validation that all saga steps completed",
                  "    var commissionId = pm.collectionVariables.get('commissionId');",
                  "    var orderId = pm.collectionVariables.get('orderId');",
                  "    pm.expect(commissionId).to.exist;",
                  "    pm.expect(orderId).to.exist;",
                  "});",
                  "",
                  "console.log('🎉 END-TO-END SAGA VALIDATION COMPLETE: Commission calculation, approval, and payout scheduling successful');",
