        {
          "name": "Verify Parallel Commission Isolation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commissions/sellers/{{sellerId}}?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["commissions", "sellers", "{{sellerId}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Multiple commissions retrieved\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.commissions.length).to.be.greaterThan(1);",
                  "});",
                  "",
                  "pm.test(\"Commissions have different IDs and orderIds\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var commissions = jsonData.data.commissions;",
                  "    var ids = commissions.map(c => c.id);",
                  "    var orderIds = commissions.map(c => c.orderId);",
                  "    var uniqueIds = [...new Set(ids)];",
                  "    var uniqueOrderIds = [...new Set(orderIds)];",
                  "    pm.expect(uniqueIds.length).to.be.greaterThan(1);",
                  "    pm.expect(uniqueOrderIds.length).to.be.greaterThan(1);",
                  "});",
                  "",
                  "pm.test(\"All commissions in pending status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var commissions = jsonData.data.commissions;",
                  "    commissions.forEach(function(commission) {",
                  "        pm.expect(commission.status).to.eql('pending');",
                  "    });",
                  "});",
                  "",
                  "console.log('✅ PARALLEL SAGAS: Multiple independent commission calculations processed successfully');"
                ]
              }
            }
          ]
        }
      ]
