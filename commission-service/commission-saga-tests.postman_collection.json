  "item": [
    {
      "name": "🚀 END-TO-END: Complete Commission Saga Flow",
      "item": [
        {
          "name": "Step 1: Calculate Commission (Order Completion Triggers Saga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"saga_order_{{$timestamp}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"orderAmount\": 150.00,\n  \"recipientType\": \"seller\",\n  \"commissionType\": \"sale\",\n  \"baseRate\": 0.08,\n  \"performanceBonus\": 0.05,\n  \"qualityMetrics\": {\n    \"rating\": 4.8,\n    \"onTimeDelivery\": true,\n    \"customerSatisfaction\": 4.5\n  },\n  \"specialConditions\": {\n    \"firstOrder\": false,\n    \"bulkOrder\": true,\n    \"promotionalPeriod\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/commissions/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["commissions", "calculate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Commission calculated successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.commissionId).to.exist;",
                  "    pm.collectionVariables.set('commissionId', jsonData.data.commissionId);",
                  "    pm.collectionVariables.set('orderId', 'saga_order_' + pm.collectionVariables.get('$timestamp'));",
                  "});",
                  "",
                  "pm.test(\"Commission breakdown provided\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.breakdown).to.be.an('object');",
                  "    pm.expect(jsonData.data.breakdown.baseAmount).to.be.a('number');",
                  "    pm.expect(jsonData.data.breakdown.bonus).to.be.a('number');",
                  "    pm.expect(jsonData.data.breakdown.totalCommission).to.be.a('number');",
                  "});",
                  "",
                  "pm.test(\"Commission amount within expected range\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var totalCommission = jsonData.data.breakdown.totalCommission;",
                  "    pm.expect(totalCommission).to.be.within(10, 25); // Expected range for $150 order",
                  "});",
                  "",
                  "console.log('✅ SAGA STEP 1 COMPLETE: Commission calculated for order', pm.collectionVariables.get('orderId'), 'with ID', pm.collectionVariables.get('commissionId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Step 2: Verify Commission Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commissions/{{commissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["commissions", "{{commissionId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Commission details retrieved\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get('commissionId'));",
                  "});",
                  "",
                  "pm.test(\"Commission in pending status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('pending');",
                  "    pm.expect(jsonData.data.createdAt).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Commission data integrity\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var commission = jsonData.data;",
                  "    pm.expect(commission.orderId).to.eql(pm.collectionVariables.get('orderId'));",
                  "    pm.expect(commission.sellerId).to.eql(pm.collectionVariables.get('sellerId'));",
                  "    pm.expect(commission.type).to.eql('sale');",
                  "    pm.expect(commission.amount).to.be.a('number');",
                  "    pm.expect(commission.rate).to.be.a('number');",
                  "});",
                  "",
                  "console.log('✅ SAGA BUSINESS LOGIC: Commission details verified with pending status');"
                ]
              }
            }
          ]
        },
        {
          "name": "Step 3: Approve Commission (Saga Step 2)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
