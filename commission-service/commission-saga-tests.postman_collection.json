                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.approved).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Approval response structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.eventsGenerated).to.be.a('number');",
                  "    pm.expect(jsonData.data.eventsGenerated).to.be.greaterThan(0);",
                  "});",
                  "",
                  "console.log('✅ SAGA STEP 2 COMPLETE: Commission approved and payout auto-scheduled');"
                ]
