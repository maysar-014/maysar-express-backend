                  "    pm.expect(summary).to.have.property('totalEarned');",
                  "    pm.expect(summary).to.have.property('totalPaid');",
                  "    pm.expect(summary).to.have.property('pendingAmount');",
                  "    pm.expect(summary).to.have.property('averageRate');",
                  "});",
                  "",
                  "pm.test(\"Approved commission reflected in summary\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var summary = jsonData.data;",
