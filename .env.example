# Maysar Express Backend - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env files to version control

# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_DB=maysar_dev
POSTGRES_USER=maysar_user
POSTGRES_PASSWORD=your-super-secure-database-password-here-minimum-16-characters

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-super-secure-redis-password-here-minimum-16-characters

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-here-minimum-256-bits-for-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External API Keys (if needed)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# Monitoring & Logging
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
# LOG_LEVEL=info

# Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Database URL (for Prisma - constructed from above values)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
