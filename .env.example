# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/maysar_db?sslmode=disable
POSTGRES_USER=postgres # [SECRETS MANAGER]
POSTGRES_PASSWORD=password # [SECRETS MANAGER]
POSTGRES_DB=maysar_db # [ENV VAR]

# Environment
NODE_ENV=development
DOTENV_NO_TIPS=true

# JWT Configuration
JWT_SECRET=your-jwt-secret-here # [SECRETS MANAGER]
JWT_EXPIRES_IN=7d # [ENV VAR]
JWT_ALGORITHM=HS256
# Optional when using RS256/ES256 signing
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Google OAuth (Auth Service)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/oauth/callback
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_OAUTH_ACCESS_TYPE=offline
GOOGLE_OAUTH_ENABLE_STATE=true
GOOGLE_OAUTH_REQUIRE_VERIFIED_EMAIL=true
GOOGLE_OAUTH_ALLOWED_DOMAINS=
GOOGLE_OAUTH_SESSION_TIMEOUT=3600000
GOOGLE_OAUTH_MAX_RETRIES=3
GOOGLE_OAUTH_RETRY_DELAY=1000

# Map service API keys
HERE_API_KEY=your-here-api-key # [SECRETS MANAGER]
# Routing fallback & prefiltering
ROUTING_FALLBACK_ENABLED=true
ROUTING_FALLBACK_INFLATION_FACTOR=1.35
ROUTING_FALLBACK_TIMEOUT_MS=800
ROUTING_FALLBACK_AVG_SPEED_KMH=30
COURIER_PREFILTER_MAX_CANDIDATES=15

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD= # [SECRETS MANAGER]
INVENTORY_REDIS_RESERVATIONS_MODE=shadow # off|shadow

# Search (Meilisearch)
SEARCH_PROVIDER=meilisearch
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_PROTOCOL=http
MEILI_MASTER_KEY=change-me-in-prod # [SECRETS MANAGER]
MEILISEARCH_API_KEY=change-me-in-prod # should match MEILI_MASTER_KEY
MEILISEARCH_INDEX_NAME=catalog
MEILISEARCH_REQUEST_TIMEOUT=30000

# File Storage
STORAGE_BUCKET=maysar-files
MAX_FILE_SIZE=10485760

# Email Configuration
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=
SMTP_FROM_NAME=

# SMS Configuration (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=MAYSAR
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_BASE_URL=
AFRICASTALKING_BULK_SMS_MODE=1
AFRICASTALKING_ENQUEUE=1
AFRICASTALKING_KEYWORD=
AFRICASTALKING_LINK_ID=
AFRICASTALKING_RETRY_DURATION_HOURS=
SMS_ALLOW_LIVE_IN_DEV=false
SMS_RATE_LIMIT_PER_MINUTE=60
SMS_RATE_LIMIT_PER_HOUR=1000
SMS_RATE_LIMIT_PER_DAY=10000
SMS_RATE_LIMIT_PER_USER_PER_HOUR=20
SMS_RATE_LIMIT_PER_PHONE_NUMBER_PER_DAY=5

# Push Notifications (provider-agnostic — set via secrets manager)
# PUSH_PROVIDER=          # e.g. firebase, onesignal, aws-sns, self-hosted
# PUSH_PROJECT_ID=        # [SECRETS MANAGER]
# PUSH_PRIVATE_KEY=       # [SECRETS MANAGER]
# PUSH_CLIENT_EMAIL=      # [SECRETS MANAGER]
# PUSH_SERVER_KEY=        # [SECRETS MANAGER]

# Analytics (provider-agnostic — set via secrets manager)
# ANALYTICS_PROVIDER=     # e.g. google-analytics, mixpanel, self-hosted
# ANALYTICS_ID=           # [SECRETS MANAGER]

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:3200

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Feature Flags
ENABLE_REAL_TIME=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true

# Development Settings
DEV_SEED_DATA=true
DEV_RESET_DB=false

# --- Consolidated Service Variables ---

# User Service
USER_SERVICE_JWT_SECRET=your-user-service-jwt-secret # [SECRETS MANAGER]
USER_SERVICE_JWT_EXPIRES_IN=24h # [ENV VAR]
USER_SERVICE_PRISMA_LOG_LEVEL=info # [ENV VAR]

# Auth Service
AUTH_SERVICE_SESSION_SECRET=your-session-secret # [SECRETS MANAGER]
AUTH_SERVICE_TOKEN_EXPIRY=3600 # [ENV VAR]

# Catalog Service
CATALOG_SERVICE_DB_HOST=localhost
CATALOG_SERVICE_DB_PORT=5432
CATALOG_SERVICE_DB_NAME=catalog_db
CATALOG_SERVICE_DB_USER=postgres
CATALOG_SERVICE_DB_PASSWORD=password

# Buy Box Configuration
BUY_BOX_WEIGHT_PRICE=0.5
BUY_BOX_WEIGHT_RATING=0.3
BUY_BOX_WEIGHT_AVAILABILITY=0.2
BUY_BOX_MATCH_CONFIDENCE_THRESHOLD=0.75
BUY_BOX_NEW_SELLER_BOOST=5
BUY_BOX_RECENCY_BOOST=5
BUY_BOX_MAX_ALTERNATIVES=5

# SMS Service
SMS_SERVICE_API_KEY=your-sms-api-key
SMS_SERVICE_PROVIDER=africastalking
SMS_PROVIDER=africastalking

# ── Payment Method Configuration & Environment Control ───────────────────────
# Every payment method operates independently in one of three modes:
#   sandbox = test mode (sandbox credentials required)
#   live    = production mode (LIVE credentials strictly required)
#   off     = completely disabled (not shown to buyers, rejected by the API)
# Default when unset: sandbox in non-production, off in production.
# Declared and validated at startup in payment-methods.config.ts — invalid
# values fail fast instead of being silently ignored.
PAYMENT_MPESA_MODE=sandbox              # sandbox | live | off
PAYMENT_AIRTEL_MONEY_MODE=sandbox       # sandbox | live | off
PAYMENT_MIXX_BY_YAS_MODE=off            # sandbox | live | off  (formerly TIGO_PESA)
PAYMENT_HALOPESA_MODE=sandbox           # sandbox | live | off
PAYMENT_CARD_MODE=off                   # sandbox | live | off
PAYMENT_BANK_TRANSFER_MODE=sandbox      # sandbox | live | off
PAYMENT_WALLET_MODE=sandbox             # sandbox | live | off

# Payment provider credentials (provider-scoped AND environment-scoped:
# sandbox credentials are NEVER used for live; live credentials NEVER fall
# back to sandbox. Credentials are never exposed to clients or logs.
# Provider names below are examples only — set via secrets manager:
# PAYMENT_PROVIDER=          # e.g. selcom, stripe, paypal, flutterwave, razorpay, custom
# PAYMENT_SANDBOX_API_KEY=   # [SECRETS MANAGER]
# PAYMENT_SANDBOX_MERCHANT_CODE=  # [SECRETS MANAGER]
# PAYMENT_SANDBOX_BASE_URL=   # [SECRETS MANAGER] — e.g. https://sandbox.payment-gateway.example/v1
# PAYMENT_LIVE_API_KEY=      # [SECRETS MANAGER]
# PAYMENT_LIVE_MERCHANT_CODE= # [SECRETS MANAGER]
# PAYMENT_LIVE_BASE_URL=      # [SECRETS MANAGER] — e.g. https://api.payment-gateway.example/v1

# Wallet and bank transfer use internal adapters — no external credentials needed.

# Authoritative payment-method discovery for buyer apps:
#   GET /payment-methods          (public)
#   GET /admin/payment-methods    (admin/system, credential presence only)

# Public base URL for callbacks and IPN notifications
BASE_URL=http://localhost:3000 # [ENV VAR]
# Public web app origin used for seller storefront share links (not the API origin).
STOREFRONT_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000 # [ENV VAR]

# Service Discovery
SERVICE_DISCOVERY_ENABLED=true # [ENV VAR]
# Optional: derive service URLs from BASE_URL + /api/{service}
SERVICE_DISCOVERY_SERVICE_NAMES=auth,catalog,order

# Error Tracking (Sentry)
# IMPORTANT: Obtain from Sentry dashboard; store in secrets manager in production
SENTRY_DSN= # [SECRETS MANAGER]

# Order Service
ORDER_SERVICE_API_KEY=your-order-api-key

# Notification Service
NOTIFICATION_SERVICE_FIREBASE_KEY=your-firebase-key

# Wallet Service
WALLET_SERVICE_SECRET=your-wallet-secret

# Security & Encryption
PII_ENCRYPTION_KEY=<32-byte hex> # [SECRETS MANAGER]
PII_HMAC_SECRET=<random secret> # [SECRETS MANAGER]
API_KEY_SECRET=your-api-key-secret # [SECRETS MANAGER]
DEVICE_FINGERPRINT_SALT=your-device-fingerprint-salt # [SECRETS MANAGER]
ENABLE_TOKEN_BLACKLISTING=true # [ENV VAR]
ENABLE_BRUTE_FORCE_PROTECTION=true # [ENV VAR]
ENABLE_DEVICE_TRACKING=true # [ENV VAR]
ENABLE_SESSION_MANAGEMENT=true # [ENV VAR]
ENABLE_RATE_LIMITING=true # [ENV VAR]

# Event Bus Configuration
# Prevents Node.js memory-leak warnings when many sagas subscribe
EVENT_BUS_MAX_LISTENERS=200

# Backup Configuration
POSTGRES_BACKUP_RETENTION_DAYS=7 # [ENV VAR]
REDIS_BACKUP_RETENTION_DAYS=7 # [ENV VAR]
BACKUP_S3_BUCKET= # [ENV VAR]
BACKUP_ENCRYPTION_KEY= # [SECRETS MANAGER]
AWS_ACCESS_KEY_ID= # [SECRETS MANAGER]
AWS_SECRET_ACCESS_KEY= # [SECRETS MANAGER]
AWS_DEFAULT_REGION=us-east-1 # [ENV VAR]

# Least-privilege database roles (see config/database/least-privilege-roles.sql)
MAYSAR_APP_USER=maysar_app # [ENV VAR]
MAYSAR_APP_PASSWORD= # [SECRETS MANAGER]
MAYSAR_BACKUP_USER=maysar_backup # [ENV VAR]
MAYSAR_BACKUP_PASSWORD= # [SECRETS MANAGER]
MAYSAR_MONITOR_USER=maysar_monitor # [ENV VAR]
MAYSAR_MONITOR_PASSWORD= # [SECRETS MANAGER]

# OpenTelemetry & Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces # [ENV VAR]
METRICS_ENABLED=true # [ENV VAR]
SERVICE_NAME=maysar-backend # [ENV VAR]
SERVICE_VERSION=1.0.0 # [ENV VAR]

# CI/CD Secrets (GitHub Actions only - never in application)
DOCKER_USERNAME= # [SECRETS MANAGER - CI only]
# Cloud provider credentials (provider-agnostic — set via secrets manager):
# CLOUD_PROVIDER=          # e.g. aws, azure, gcp, oracle, hetzner, digitalocean, self-hosted
# CLOUD_ACCESS_KEY_ID=     # [SECRETS MANAGER - CI only]
# CLOUD_SECRET_ACCESS_KEY= # [SECRETS MANAGER - CI only]
# CLOUD_REGION=            # [ENV VAR]
# CLOUD_CLUSTER_ID=        # [SECRETS MANAGER - CI only]

# Object Storage (S3-compatible for dev & production)
MINIO_ROOT_USER=maysar
MINIO_ROOT_PASSWORD=maysar2026
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000      # browser/CDN-reachable base URL for returned media URLs
S3_REGION=us-east-1
S3_BUCKET= # [ENV VAR]
S3_ACCESS_KEY_ID= # [SECRETS MANAGER]
S3_SECRET_ACCESS_KEY= # [SECRETS MANAGER]
S3_FORCE_PATH_STYLE=true                   # true for MinIO/S3-compatible, false for AWS S3
S3_ACCESS_KEY_ID=maysar                    # [SECRETS MANAGER in prod]
S3_SECRET_ACCESS_KEY=maysar2026            # [SECRETS MANAGER in prod]
S3_BUCKET_CHAT_MEDIA=chat-media
S3_BUCKET_PRODUCT_MEDIA=product-media        # bucket for product images (full + thumbnails)
S3_FORCE_PATH_STYLE=true                   # true for MinIO, false for AWS S3

# ── Checkout / Pricing ────────────────────────────────────────────────────────
# Tanzania market: sellers list tax-inclusive prices, so VAT is NOT added at checkout.
# Set TAX_RATE=0.18 only if switching to B2B VAT-exclusive pricing.
TAX_RATE=0
SHIPPING_COST=0
MIN_ORDER_FREE_SHIPPING=0

# ── Logistics Service ─────────────────────────────────────────────────────────
# Internal URL that checkout-service uses to validate delivery quotes.
# In docker-compose this is typically http://logistics-service:PORT
LOGISTICS_SERVICE_URL=http://localhost:3000

