# Copy to .env and fill before running locally. Do NOT commit secrets.
POSTGRES_DB=maysar_dev
POSTGRES_USER=maysar_user
POSTGRES_PASSWORD=replace-with-strong-password
REDIS_PASSWORD=replace-with-redis-pass
JWT_SECRET=replace-with-jwt-secret
CORS_ORIGIN=http://localhost:3000
RATE_WINDOW_MS=900000
RATE_MAX=100
BODY_LIMIT=10mb