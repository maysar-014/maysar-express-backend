{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.eslint.json",
    "ecmaVersion": 2020
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2020": true
  },
  "ignorePatterns": ["dist/", "node_modules/", "**/*.js", "services/notification-service/notification-service/**"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-namespace": "off",
    "@typescript-eslint/ban-ts-comment": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/ban-types": "warn",
    "no-console": "warn",
    "no-control-regex": "warn",
    "no-useless-catch": "warn",
    "no-case-declarations": "warn",
    "no-useless-escape": "warn",
    "no-empty": "warn",
    "prefer-spread": "warn",
    "no-constant-condition": "warn",
    "no-var": "warn",
    "no-irregular-whitespace": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__tests__/**/*.ts",
        "**/tests/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/ban-ts-comment": "off",
        "no-console": "off",
        "no-control-regex": "off",
        "no-case-declarations": "off",
        "no-useless-escape": "off",
        "no-empty": "off",
        "prefer-spread": "off",
        "no-constant-condition": "off",
        "no-var": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "services/**/index.ts",
        "services/**/src/index.ts",
        "services/**/src/app.ts",
        "services/**/src/container.ts",
        "services/**/src/main.ts",
        "services/**/src/api/main.ts",
        "services/**/bootstrap.ts",
        "services/**/simple-*.ts",
        "services/**/src/**/*runner.ts",
        "services/**/src/**/*diagnostic*.ts",
        "services/**/src/**/*test*.ts",
