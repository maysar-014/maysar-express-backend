sequenceDiagram
    participant UI as AdminUI
    participant Saga
    participant US as UserService
    participant EB as EventBus

    UI->>Saga: performAction(userId, action)
    Saga->>US: validatePermissions(adminId)
    US-->>Saga: authorized
    
    Saga->>US: executeOperation(userId, action)
    US-->>Saga: success
    
    Saga->>UI: updateUI(success)
    Saga->>EB: publish(AdminUserActionEvent)
