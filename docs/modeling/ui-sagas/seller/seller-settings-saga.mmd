sequenceDiagram
    participant UI as SellerUI
    participant Saga
    participant BS as BusinessService
    participant EB as EventBus

    UI->>Saga: updateSettings(newSettings)
    Saga->>BS: validateSettings(newSettings)
    BS-->>Saga: valid
    
    Saga->>BS: saveSettings(sellerId, newSettings)
    BS-->>Saga: success
    
    Saga->>EB: publish(SellerSettingsUpdatedEvent)
    Saga->>UI: settingsSaved()
