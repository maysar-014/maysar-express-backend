# =====================================================================================
# CATALOG SERVICE ENVIRONMENT CONFIGURATION
# =====================================================================================
# Copy this file to .env and update values for your environment

# =====================================================================================
# SERVICE CONFIGURATION
# =====================================================================================
NODE_ENV=development
PORT=3000
HOST=localhost

SERVICE_NAME=catalog-service
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Product Catalog Service

# =====================================================================================
# SECURITY CONFIGURATION
# =====================================================================================
# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-min-32-chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Authorization
ADMIN_ROLES=admin,superuser
AUTHZ_RBAC=true

# =====================================================================================
# RATE LIMITING
# =====================================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRATEGY=fixed

# =====================================================================================
# VALIDATION
# =====================================================================================
VALIDATION_SANITIZE=true
MAX_REQUEST_SIZE=10485760

# =====================================================================================
# LOGGING
# =====================================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =====================================================================================
# MONITORING
# =====================================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =====================================================================================
# DATABASE CONFIGURATION
# =====================================================================================
# Option 1: Full DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/catalog_db?sslmode=require

# Option 2: Individual database settings (for development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalog_db
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_SSL_MODE=prefer
DB_CONNECTION_TIMEOUT=10000
DB_COMMAND_TIMEOUT=30000

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_REAP_INTERVAL=1000
DB_POOL_CREATE_RETRY_INTERVAL=200

# Performance
DB_STATEMENT_CACHE_SIZE=100
DB_QUERY_TIMEOUT=30000
DB_SLOW_QUERY_THRESHOLD=1000
DB_ENABLE_QUERY_LOGGING=false
DB_LOG_SLOW_QUERIES=true

# Prisma
PRISMA_LOG_LEVEL=warn
PRISMA_GENERATE_SCHEMA=false

# Migration
DB_ENABLE_MIGRATIONS=true
DB_MIGRATION_TABLE=_prisma_migrations
DB_MIGRATION_LOCK_TIMEOUT=300000

# =====================================================================================
# MESSAGING CONFIGURATION
# =====================================================================================
# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=catalog-service
KAFKA_GROUP_ID=catalog-service-group
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000
KAFKA_RETRY_BACKOFF=100
KAFKA_MAX_RETRIES=10

# RabbitMQ Configuration (alternative to Kafka)
RABBITMQ_URL=
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10000
RABBITMQ_PREFETCH=1
RABBITMQ_RECONNECT_DELAY=1000
RABBITMQ_MAX_RECONNECT_ATTEMPTS=10

# Event Store
EVENT_STORE_CONNECTION=memory
EVENT_STORE_REDIS_URL=
EVENT_STORE_FILE_PATH=./event-store.db
EVENT_STORE_RETENTION_DAYS=30
EVENT_STORE_MAX_EVENTS_PER_STREAM=10000
EVENT_STORE_SNAPSHOT_INTERVAL=100
EVENT_STORE_COMPRESSION_ENABLED=true

# Message Queue Settings
QUEUE_DEFAULT_TTL=3600000
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000
QUEUE_DEAD_LETTER_EXCHANGE=dead-letter
QUEUE_DEAD_LETTER_QUEUE=dead-letters
QUEUE_MAX_MESSAGE_SIZE=1048576

# Messaging Monitoring
MESSAGING_ENABLE_METRICS=true
MESSAGING_METRICS_INTERVAL=30000
MESSAGING_ENABLE_HEALTH_CHECKS=true
MESSAGING_HEALTH_CHECK_TIMEOUT=5000
MESSAGING_ALERT_CONNECTION_ERRORS=true
MESSAGING_ALERT_MESSAGE_FAILURES=true

# Topics
TOPIC_PRODUCT_EVENTS=catalog.product.events
TOPIC_PRICING_EVENTS=catalog.pricing.events
TOPIC_SEARCH_EVENTS=catalog.search.events
TOPIC_AUDIT_EVENTS=catalog.audit.events

# =====================================================================================
# EXTERNAL SERVICES CONFIGURATION
# =====================================================================================
# CDN Configuration
CDN_PROVIDER=cloudflare
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.yourdomain.com
CDN_API_KEY=your-cdn-api-key
CDN_SECRET=your-cdn-secret
CDN_REGION=
CDN_BUCKET=
CDN_PUBLIC_READ=true
CDN_SIGNED_URLS=false
CDN_SIGNED_URL_EXPIRATION=3600

# Search Configuration
SEARCH_PROVIDER=elasticsearch
SEARCH_ENABLED=true

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=catalog
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL=true
ELASTICSEARCH_REQUEST_TIMEOUT=30000

# Algolia (alternative to Elasticsearch)
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_ONLY_API_KEY=
ALGOLIA_INDEX_NAME=catalog

# Cache Configuration
CACHE_PROVIDER=redis
CACHE_ENABLED=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=catalog:
REDIS_TTL=3600

# Memcached (alternative to Redis)
MEMCACHED_SERVERS=localhost:11211
MEMCACHED_OPTIONS=

# Image Processing
IMAGE_PROVIDER=sharp
IMAGE_ENABLED=true
IMAGE_MAX_SIZE=10485760
IMAGE_ALLOWED_FORMATS=jpg,jpeg,png,webp,gif
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_THUMBNAIL_SIZES=100x100,300x300,600x600
IMAGE_WATERMARK_ENABLED=false
IMAGE_WATERMARK_TEXT=

# File Upload
UPLOAD_PROVIDER=local
UPLOAD_ENABLED=true
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# AWS S3 (for cloud file upload)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_READ=false

# Payment Configuration
PAYMENT_PROVIDER=
PAYMENT_ENABLED=false

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2023-10-16

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Notification Configuration
NOTIFICATION_PROVIDER=
NOTIFICATION_ENABLED=false

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@catalog.com

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@catalog.com

# AWS SES
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
AWS_SES_FROM=noreply@catalog.com

# External Services Monitoring
EXTERNAL_SERVICES_ENABLE_METRICS=true
EXTERNAL_SERVICES_METRICS_INTERVAL=30000
EXTERNAL_SERVICES_ENABLE_HEALTH_CHECKS=true
EXTERNAL_SERVICES_HEALTH_CHECK_TIMEOUT=5000
EXTERNAL_SERVICES_ALERT_ON_FAILURES=true
EXTERNAL_SERVICES_CIRCUIT_BREAKER_ENABLED=true
EXTERNAL_SERVICES_CIRCUIT_BREAKER_THRESHOLD=5
EXTERNAL_SERVICES_CIRCUIT_BREAKER_TIMEOUT=60000
