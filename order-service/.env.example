# Order Service Environment Configuration
# This file contains all supported environment variables for the Order Service

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3002
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/order_service"
DB_MAX_CONNECTIONS=10

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET="your-very-secure-jwt-secret-key-minimum-32-characters"
API_KEY="your-optional-api-key"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://maysar.com,https://admin.maysar.com"

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_COMPRESSION=true

# =============================================================================
# EXTERNAL SERVICES CONFIGURATION
# =============================================================================
PESAPAL_API_URL="https://cybqa.pesapal.com/pesapalv3"
PESAPAL_API_KEY="your-pesapal-api-key"
PESAPAL_CONSUMER_KEY="your-pesapal-consumer-key"
PESAPAL_CONSUMER_SECRET="your-pesapal-consumer-secret"

# Redis Configuration (for future caching)
REDIS_URL="redis://localhost:6379"

# =============================================================================
# LOGGING & MONITORING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=simple

# Metrics Configuration
ENABLE_METRICS=false
METRICS_PORT=9090

# =============================================================================
# LEGACY CONFIGURATION (will be migrated)
# =============================================================================
# Application Base URL
BASE_URL="http://localhost:3002"

# Security (legacy)
BCRYPT_ROUNDS=12

# Monitoring (legacy)
APM_ENABLED=false
APM_SERVICE_NAME="order-service"
APM_SERVER_URL="http://localhost:8200"

# Email Configuration (for future notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30000
