            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Route created for assigned courier\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.routes).to.be.an('array');",
                  "    pm.expect(jsonData.data.routes.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Route contains delivery waypoints\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var route = jsonData.data.routes[0];",
                  "    pm.expect(route.waypoints).to.be.an('array');",
                  "    pm.expect(route.waypoints.length).to.be.greaterThan(1);",
                  "    pm.collectionVariables.set('sagaRouteId', route.id);",
                  "});",
                  "",
                  "pm.test(\"Route has business logic properties\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var route = jsonData.data.routes[0];",
                  "    pm.expect(route.status).to.be.oneOf(['planned', 'active', 'completed']);",
                  "    pm.expect(route.totalDistance).to.be.a('number');",
                  "    pm.expect(route.estimatedDuration).to.be.a('number');",
                  "});",
                  "",
                  "console.log('✅ SAGA BUSINESS LOGIC: Route auto-created for delivery', pm.collectionVariables.get('sagaDeliveryId'));"
                ]
              }
            }
          ]
