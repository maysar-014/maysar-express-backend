        {
          "name": "Verify Parallel Saga Isolation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api-version",
                "value": "v1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/deliveries?status=assigned&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries"],
              "query": [
                {
                  "key": "status",
                  "value": "assigned"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Multiple deliveries in assigned state\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.deliveries.length).to.be.greaterThan(1);",
                  "});",
                  "",
                  "pm.test(\"Parallel sagas have different couriers\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var deliveries = jsonData.data.deliveries;",
                  "    var courierIds = deliveries.map(d => d.courierId).filter(id => id);",
                  "    var uniqueCouriers = [...new Set(courierIds)];",
                  "    pm.expect(uniqueCouriers.length).to.be.greaterThan(1);",
                  "});",
                  "",
                  "pm.test(\"Each delivery has independent saga state\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var deliveries = jsonData.data.deliveries;",
                  "    deliveries.forEach(function(delivery) {",
                  "        pm.expect(delivery.status).to.be.oneOf(['assigned', 'picked_up', 'in_transit']);",
                  "        pm.expect(delivery.assignedAt).to.exist;",
                  "    });",
                  "});",
                  "",
                  "console.log('✅ PARALLEL SAGAS: Multiple deliveries running independently with different couriers');"
                ]
              }
            }
          ]
        }
