                  "    pm.expect(delivery.pickedUpAt).to.exist;",
                  "    pm.expect(delivery.deliveredAt).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Saga orchestration sequence validated\", function () {",
                  "    var jsonData = pm.response.json();",
