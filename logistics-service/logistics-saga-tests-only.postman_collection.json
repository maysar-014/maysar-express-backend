                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "api-version",
                "value": "v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"saga_test_{{$timestamp}}\",\n  \"pickupAddress\": {\n    \"street\": \"Uhuru Street\",\n    \"city\": \"Dar es Salaam\",\n    \"region\": \"Dar es Salaam\",\n    \"postalCode\": \"11101\",\n    \"country\": \"TZ\",\n    \"contactName\": \"Test Seller\",\n    \"contactPhone\": \"+255712345678\",\n    \"coordinates\": {\n      \"lat\": -6.7924,\n      \"lng\": 39.2083\n    }\n  },\n  \"deliveryAddress\": {\n    \"street\": \"Samora Avenue\",\n    \"city\": \"Dar es Salaam\",\n    \"region\": \"Dar es Salaam\",\n    \"postalCode\": \"11102\",\n    \"country\": \"TZ\",\n    \"contactName\": \"Test Customer\",\n    \"contactPhone\": \"+255723456789\",\n    \"coordinates\": {\n      \"lat\": -6.8000,\n      \"lng\": 39.2100\n    }\n  },\n  \"packageDetails\": {\n    \"weight\": 2.5,\n    \"dimensions\": {\n      \"length\": 30,\n      \"width\": 20,\n      \"height\": 15\n    },\n    \"value\": 50000,\n    \"fragile\": false,\n    \"perishable\": false,\n    \"hazardous\": false,\n    \"items\": [\n      {\n        \"productId\": \"prod_saga_test\",\n        \"name\": \"Saga Test Electronics\",\n        \"quantity\": 1,\n        \"weight\": 2.5,\n        \"value\": 50000\n      }\n    ]\n  },\n  \"priority\": \"standard\",\n  \"desiredArrivalTime\": \"{{currentDateTime}}\",\n  \"estimatedArrivalMinutes\": 45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/deliveries",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response has deliveryId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.deliveryId).to.exist;",
                  "    pm.collectionVariables.set('sagaDeliveryId', jsonData.data.deliveryId);",
                  "});",
                  "",
                  "pm.test(\"Courier assigned (saga step 1 completed)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.courierId).to.exist;",
                  "    pm.collectionVariables.set('sagaCourierId', jsonData.data.courierId);",
                  "});",
                  "",
                  "pm.test(\"Delivery status is assigned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('assigned');",
                  "});",
                  "",
                  "console.log('✅ SAGA STEP 1 COMPLETE: Courier assigned to delivery', pm.collectionVariables.get('sagaDeliveryId'));"
                ]
              }
            }
          ]
