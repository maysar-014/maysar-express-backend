// Checkout Service Database Schema
// Isolated data ownership - no cross-service queries

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Cart entity - shopping cart management
model Cart {
  id            String   @id @default(uuid())
  userId        String   @db.Uuid
  status        String   @default("active") // active, abandoned, converted
  items         CartItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime @default(dbgenerated("now() + interval '7 days'"))

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// Cart items - individual products in cart
model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String   @db.Uuid
  variantId       String?  @db.Uuid
  quantity        Int
  priceAtTime     Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// Checkout session - checkout flow state
model CheckoutSession {
  id                String   @id @default(uuid())
  cartId            String
  userId            String   @db.Uuid
  status            String   @default("initiated") // initiated, payment_pending, completed, failed, abandoned
  
  // Checkout data
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  
  // Pricing
  subtotal          Decimal  @db.Decimal(12, 2)
  shippingCost      Decimal  @db.Decimal(12, 2) @default(0)
  taxAmount         Decimal  @db.Decimal(12, 2) @default(0)
  discountAmount    Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount       Decimal  @db.Decimal(12, 2)
  
  // Payment
  paymentMethodId   String?
  paymentStatus     String?  // pending, processing, completed, failed
  
  // Metadata
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime @default(dbgenerated("now() + interval '1 hour'"))

  @@index([userId])
  @@index([status])
  @@index([cartId])
  @@index([expiresAt])
}

// Order - created after successful checkout
model Order {
  id                String   @id @default(uuid())
  checkoutSessionId String
  userId            String   @db.Uuid
  status            String   @default("pending") // pending, confirmed, shipped, delivered, cancelled
  
  // Order details
  items             OrderItem[]
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  
  // Pricing
  subtotal          Decimal  @db.Decimal(12, 2)
  shippingCost      Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(12, 2)
  
  // Payment
  paymentMethodId   String?
  paymentStatus     String   @default("pending")
  
  // Tracking
  trackingNumber    String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Order items - products in order
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// Inventory reservation - track reserved stock during checkout
model InventoryReservation {
  id            String   @id @default(uuid())
  checkoutId    String
  productId     String   @db.Uuid
  variantId     String?  @db.Uuid
  quantity      Int
  status        String   @default("reserved") // reserved, confirmed, released
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([checkoutId, productId, variantId])
  @@index([checkoutId])
  @@index([status])
  @@index([expiresAt])
}

// Discount application - track applied discounts
model AppliedDiscount {
  id              String   @id @default(uuid())
  checkoutId      String
  discountCode    String?
  discountType    String   // percentage, fixed, shipping_free
  discountValue   Decimal  @db.Decimal(12, 2)
  maxUses         Int?
  currentUses     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([checkoutId])
  @@index([discountCode])
}
