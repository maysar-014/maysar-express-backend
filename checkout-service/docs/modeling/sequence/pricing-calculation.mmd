sequenceDiagram
    participant B as "Buyer"
    participant UC as "InitiateCheckoutUseCase"
    participant REPO_C as "CartRepository"
    participant ENG as "CheckoutEngine"
    participant POL as "PricingPolicy"
    participant REPO_S as "CheckoutRepository"
    participant EB as "EventBus"

    B->>UC: execute(input)
    UC->>REPO_C: getCart(cartId)
    REPO_C-->>UC: cartData
    
    UC->>ENG: calculatePricing(context)
    ENG->>POL: apply(subtotal, rules)
    POL-->>ENG: finalAmounts
    ENG-->>UC: pricingResult
    
    UC->>REPO_S: saveCheckoutSession(session)
    UC->>EB: publish(CheckoutInitiated)
    
    UC-->>B: checkoutResult(data, pricing)
