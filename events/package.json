{
  "name": "@maysar/events",
  "version": "1.0.0",
  "description": "Maysar Event Catalog and Schema Registry",
  "main": "index.ts",
  "scripts": {
    "validate": "ts-node validate.ts",
    "validate:ci": "npm run validate && npm run test:schemas",
