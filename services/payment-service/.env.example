# Payment Service Environment Configuration
NODE_ENV=development
SERVICE_NAME=payment-service
SERVICE_VERSION=1.0.0
PORT=3003

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/maysar_payment_db?schema=public"

# Security
JWT_SECRET="your-secret"
API_KEY="your-api-key"

# Logging
LOG_LEVEL=info

# Message Queue
MESSAGE_QUEUE_TYPE=kafka
MESSAGE_QUEUE_URL="localhost:9092"

# Payment Gateway (Mock/Real)
STRIPE_SECRET_KEY="sk_test_..."
PAYPAL_CLIENT_ID="your-client-id"

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9093
