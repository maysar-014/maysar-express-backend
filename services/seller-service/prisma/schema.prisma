// Seller Service Database Schema
// Complete seller onboarding and management

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Seller management
model Seller {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  businessName        String   @db.VarChar(255)
  businessType        String?  @db.VarChar(100)
  registrationNumber  String?  @unique @db.VarChar(100)
  taxId               String?  @db.VarChar(100)
  businessAddress     Json
  contactDetails      Json
  status              SellerStatus @default(pending)
  verificationStatus  VerificationStatus @default(unverified)
  riskScore           Decimal  @default(0.5) @db.Decimal(3, 2)
  performanceScore    Decimal  @default(0.0) @db.Decimal(3, 2)
  createdAt           DateTime @default(now()) @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @db.Timestamp(6)

  // Relations
  kycRecords     KycRecord[]
  badges         SellerBadge[]

  @@map("sellers")
}

// KYC document management
model KycRecord {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @db.Uuid
  documentType      String   @db.VarChar(50)
  documentNumber    String   @db.VarChar(100)
  documentUrl       String   @db.VarChar(500)
  verificationStatus VerificationStatus @default(pending)
  verifiedBy        String?  @db.Uuid
  verifiedAt        DateTime? @db.Timestamp(6)
  expiryDate        Date?
  metadata          Json?
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  // Relations
  seller            Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}

// Seller reputation system
model SellerBadge {
  id           String   @id @default(uuid()) @db.Uuid
  sellerId     String   @db.Uuid
  badgeType    BadgeType
  awardedAt    DateTime @default(now()) @db.Timestamp(6)
  expiresAt    DateTime? @db.Timestamp(6)
  criteriaMet  Json?
  awardedBy    String?  @db.Uuid

  // Relations
  seller       Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_badges")
}

// Enums
enum SellerStatus {
  pending
  active
  suspended
  deactivated
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
  expired
}

enum BadgeType {
  verified
  top_seller
  high_rated
  trusted
  fast_shipper
  premium
}
