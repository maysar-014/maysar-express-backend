sequenceDiagram
    participant Saga as PaymentProcessingSaga
    participant Fraud as FraudEngine
    participant Bus as EventBus
    participant Provider as PaymentProvider
    
    Saga->>Bus: publishCommand(PaymentInitiated)
    
    rect rgb(240, 240, 240)
        note right of Saga: FraudCheck Step
        Saga->>Fraud: assessTransaction()
        Fraud-->>Saga: Assessment Result
    end
    
    rect rgb(240, 240, 240)
        note right of Saga: ProcessPayment Step
        alt WALLET Method
            Saga->>Bus: publishCommand(WalletPaymentRequested)
            Bus-->>Saga: handleWalletPaymentProcessed()
        else Provider Method
            Saga->>Provider: processPayment()
            Provider-->>Saga: success
        end
    end
    
    rect rgb(240, 240, 240)
        note right of Saga: UpdateOrder Step
        Saga->>Bus: publishCommand(Payment.Success.v1)
    end
    
    rect rgb(240, 240, 240)
        note right of Saga: NotifyUser Step
        Saga->>Bus: publishCommand(PaymentNotificationRequested)
    end

    opt Compensation
        Saga->>Bus: publishCommand(PaymentCancelled)
        Saga->>Bus: publishCommand(PaymentRefund.Command.v1)
    end
(releaseData)
    end
