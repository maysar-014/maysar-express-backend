sequenceDiagram
    participant API
    participant WC as WalletController
    participant UC as InitiatePayoutFromWalletUseCase
    participant DUC as DebitWalletUseCase
    participant CUC as CreditWalletUseCase
    participant PSC as PayoutServiceClient
    participant PAY as Payout API
    participant EB as EventBus

    API->>WC: initiatePayout(req)
    WC->>WC: resolveRole(req.user)
    
    alt is buyer
        WC-->>API: 403 Forbidden
    else is eligible role
        WC->>UC: execute(dto)
        
        UC->>UC: validateRoleEligibility()
        
        alt role not eligible
            UC-->>WC: failure
        else role eligible
            UC->>DUC: execute({amount, ...})
            DUC-->>UC: debitResult (success, balanceBefore)
            
            alt debit success
                UC->>PSC: initiatePayout({amount, availableBalance, ...})
                PSC->>PAY: POST /api/payouts
                PAY-->>PSC: payoutResponse
                
                alt payout success
                    UC->>EB: publish(WalletPayoutInitiated)
                    UC-->>WC: success
                    WC-->>API: 201 Created
                else payout failure
                    UC->>CUC: execute({amount, ...})
                    CUC-->>UC: creditResult
                    UC-->>WC: failure
                    WC-->>API: 400 Bad Request
                end
            else debit failure
                UC-->>WC: failure
                WC-->>API: 400 Bad Request
            end
        end
    end
