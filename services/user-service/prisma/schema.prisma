// Prisma schema for User Service
// This schema defines the database structure for user management and profiles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  passwordHash            String
  role                    UserRole @default(BUYER)
  status                  UserStatus @default(PENDING_VERIFICATION)

  // Profile Information
  firstName               String?
  lastName                String?
  phoneNumber             String?
  dateOfBirth             DateTime?
  avatar                  String?

  // Verification Status
  isEmailVerified         Boolean  @default(false)
  isPhoneVerified         Boolean  @default(false)
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?

  // Security Tracking
  failedLoginAttempts     Int      @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?

  // Two-Factor Authentication
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret         String?

  // Preferences
  language                String   @default("en")
  timezone                String   @default("UTC")
  notificationsEnabled    Boolean  @default(true)

  // Metadata
  attributes              Json?

  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  addresses               UserAddress[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]

  @@map("users")
}

// ============================================================================
// USER ADDRESSES
// ============================================================================

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  type        AddressType @default(HOME)
  street      String
  city        String
  state       String?
  postalCode  String?
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

// ============================================================================
// SESSION MANAGEMENT
// ============================================================================

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  ipAddress   String
  userAgent   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================================
// PASSWORD RESET TOKENS
// ============================================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================================
// EMAIL VERIFICATION TOKENS
// ============================================================================

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ============================================================================
// AUDIT LOGGING
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  email       String?
  action      String
  ipAddress   String
  userAgent   String
  success     Boolean
  reason      String?
  metadata    Json?
  timestamp   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  BUYER     @map("buyer")
  SELLER    @map("seller")
  SUPPLIER  @map("supplier")
  COURIER   @map("courier")
  ENABLER   @map("enabler")
  SYSTEM    @map("system")
}

enum UserStatus {
  PENDING_VERIFICATION @map("pending_verification")
  ACTIVE               @map("active")
  SUSPENDED            @map("suspended")
  DEACTIVATED          @map("deactivated")
  LOCKED               @map("locked")
}

enum AddressType {
  HOME      @map("home")
  WORK      @map("work")
  BILLING   @map("billing")
  SHIPPING  @map("shipping")
}

// ============================================================================
// INDEXES AND CONSTRAINTS
// ============================================================================

// Additional indexes for performance
model UserIndex {
  userId    String
  indexType String
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, indexType])
// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
