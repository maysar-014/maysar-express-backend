# User Service Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# SERVICE CONFIGURATION
# ============================================

# Service basic settings
NODE_ENV=development
SERVICE_NAME=user-service
SERVICE_VERSION=1.0.0
PORT=3001

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL database connection
DATABASE_URL="postgresql://username:password@localhost:5432/maysar_user_db?schema=public"

# Database connection pool settings
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_QUERY_TIMEOUT=30000

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT and authentication (for inter-service communication)
JWT_SECRET="your-super-secure-jwt-secret-change-in-production"
JWT_EXPIRE="24h"
API_KEY="your-service-api-key"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://maysar.com,https://admin.maysar.com,https://api.maysar.com"

# Security headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

# Global rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Specific endpoint limits
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW_MS=900000
RATE_LIMIT_VERIFICATION_MAX=3
RATE_LIMIT_VERIFICATION_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, simple, dev)
LOG_FORMAT=json

# External logging service (optional)
LOG_EXTERNAL_URL=""
LOG_EXTERNAL_API_KEY=""

# ============================================
# EVENT PUBLISHING CONFIGURATION
# ============================================

# Message queue configuration (Kafka, RabbitMQ, etc.)
MESSAGE_QUEUE_TYPE=memory
MESSAGE_QUEUE_URL=""

# Event publishing settings
EVENT_PUBLISHING_ENABLED=true
EVENT_PUBLISHING_BATCH_SIZE=10
EVENT_PUBLISHING_TIMEOUT=5000

# ============================================
# MONITORING & METRICS
# ============================================

# Application monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check settings
HEALTH_CHECK_DATABASE_TIMEOUT=5000
HEALTH_CHECK_CACHE_TIMEOUT=2000

# ============================================
# EXTERNAL SERVICE CONFIGURATION
# ============================================

# Email service for notifications
EMAIL_SERVICE_URL=""
EMAIL_SERVICE_API_KEY=""

# Notification service
NOTIFICATION_SERVICE_URL=""
NOTIFICATION_SERVICE_API_KEY=""

# Cache service (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# ============================================
# FEATURE FLAGS
# ============================================

# Feature toggles
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PHONE_VERIFICATION=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_USER_SEARCH=true
FEATURE_ADVANCED_ANALYTICS=false

# ============================================
# BUSINESS RULES CONFIGURATION
# ============================================

# User registration rules
USER_MIN_AGE=13
USER_MAX_FIRST_NAME_LENGTH=50
USER_MAX_LAST_NAME_LENGTH=50

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Account security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=24

# ============================================
# PERFORMANCE CONFIGURATION
# ============================================

# Request timeout settings
REQUEST_TIMEOUT_MS=30000
DATABASE_TIMEOUT_MS=10000

# Cache settings
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# Compression settings
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# ============================================
# DEVELOPMENT & DEBUGGING
# ============================================

# Development settings
DEBUG_MODE=false
ENABLE_SWAGGER_DOCS=true
ENABLE_REQUEST_BODY_LOGGING=false

# Testing configuration
TEST_DATABASE_URL="postgresql://test:test@localhost:5433/maysar_user_test"

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Kubernetes/Docker settings
DEPLOYMENT_ENV=development
NAMESPACE=default
POD_NAME=""
SERVICE_ACCOUNT=""

# Load balancer health checks
HEALTH_CHECK_PATH="/health"
READINESS_CHECK_PATH="/health/ready"
LIVENESS_CHECK_PATH="/health/live"
