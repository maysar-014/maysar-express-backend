// Logistics Service Database Schema
// Complete shipment lifecycle and tracking management

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Shipment lifecycle management
model Shipment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  trackingNumber    String   @unique @db.VarChar(100)
  carrier           String   @db.VarChar(100)
  serviceType       String?  @db.VarChar(50)
  status            ShipmentStatus @default(pending)
  originAddress     Json
  destinationAddress Json
  estimatedDelivery DateTime? @db.Timestamp(6)
  actualDelivery    DateTime? @db.Timestamp(6)
  weight            Decimal? @db.Decimal(8, 3)
  dimensions        Json?
  insuranceAmount   Decimal? @db.Decimal(10, 2)
  shippingCost      Decimal  @db.Decimal(8, 2)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @db.Timestamp(6)

  // Relations
  trackingEvents    TrackingEvent[]
  proofOfDelivery   ProofOfDelivery?

  @@map("shipments")
}

// Real-time tracking events
model TrackingEvent {
  id           String   @id @default(uuid()) @db.Uuid
  shipmentId   String   @db.Uuid
  eventType    String   @db.VarChar(100)
  description  String?
  location     Json?
  timestamp    DateTime @db.Timestamp(6)
  carrierStatusCode String? @db.VarChar(50)
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  // Relations
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("tracking_events")
}

// Proof of delivery with verification
model ProofOfDelivery {
  id               String   @id @default(uuid()) @db.Uuid
  shipmentId       String   @unique @db.Uuid
  recipientName    String?  @db.VarChar(255)
  recipientSignature String?
  recipientPhotoUrl String? @db.VarChar(500)
  deliveryNotes    String?
  deliveryCoordinates Json?
  deliveryTimestamp DateTime @db.Timestamp(6)
  deliveredBy      String   @db.Uuid
  verifiedBy       String?  @db.Uuid
  verificationStatus VerificationStatus @default(pending)
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  // Relations
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// Enums
enum ShipmentStatus {
  pending
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
  cancelled
}

enum VerificationStatus {
  pending
  verified
  rejected
  disputed
}
