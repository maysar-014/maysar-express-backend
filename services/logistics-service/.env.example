# Logistics Service Environment Configuration
NODE_ENV=development
SERVICE_NAME=logistics-service
SERVICE_VERSION=1.0.0
PORT=3007

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/maysar_logistics_db?schema=public"

# Supabase (if used)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"

# Redis
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL=info
