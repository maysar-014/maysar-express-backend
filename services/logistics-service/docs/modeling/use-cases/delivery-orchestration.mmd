useCaseDiagram
    actor "System" as SY
    actor "Order Service" as OS
    actor "Courier" as C
    
    package "Logistics Service" {
        usecase "Create Delivery Request" as UC1
        usecase "Assign Optimal Courier" as UC2
        usecase "Optimize Route" as UC3
        usecase "Track Delivery Progress" as UC4
        usecase "Update Delivery Status" as UC5
        usecase "Calculate ETA" as UC6
    }
    
    OS --> UC1
    SY --> UC2
    SY --> UC3
    SY --> UC6
    C --> UC5
    C --> UC4
    
    UC1 ..> UC2 : <<include>>
    UC2 ..> UC3 : <<include>>
