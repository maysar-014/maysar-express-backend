{
    "name": "pricing-service",
    "version": "1.0.0",
    "description": "Pricing Microservice for Maysar Platform",
    "main": "dist/api/main.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/api/main.js",
        "dev": "ts-node-dev --respawn --transpile-only src/api/main.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "prisma:generate": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^5.7.0",
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "compression": "^1.7.4",
        "joi": "^17.11.0",
        "dotenv": "^16.3.1",
        "winston": "^3.11.0",
        "inversify": "^6.0.1",
        "inversify-express-utils": "^6.4.3",
        "reflect-metadata": "^0.1.13"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/compression": "^1.7.5",
        "@types/node": "^20.10.5",
        "@types/jest": "^29.5.11",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "prisma": "^5.7.0",
        "eslint": "^8.56.0"
    }
}