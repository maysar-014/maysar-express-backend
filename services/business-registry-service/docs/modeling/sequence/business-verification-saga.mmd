sequenceDiagram
    participant Saga
    participant BR as BusinessRepository
    participant CS as ComplianceService
    participant EB as EventBus

    Saga->>BR: getDocuments(businessId)
    BR-->>Saga: documents
    
    Saga->>CS: verifyDocuments(documents)
    CS-->>Saga: verificationResult
    
    Saga->>CS: checkCompliance(businessId)
    CS-->>Saga: complianceStatus

    alt VERIFIED
        Saga->>BR: updateStatus(businessId, VERIFIED)
        Saga->>EB: publish(BusinessVerifiedEvent)
    else NEEDS_REVIEW
        Saga->>BR: updateStatus(businessId, NEEDS_REVIEW)
        Saga->>EB: publish(BusinessReviewRequestedEvent)
    else REJECTED
        Saga->>BR: updateStatus(businessId, REJECTED)
        Saga->>EB: publish(BusinessRejectedEvent)
    end