// Inventory Service Database Schema
// Multi-warehouse inventory management with advanced tracking

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Core warehouse management
model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  address     Json     // Structured address with coordinates
  type        WarehouseType // central, regional, store
  status      WarehouseStatus @default(active)
  capacity    Json?    // Storage capacity by category
  operatingHours Json? // Operating hours and holidays
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  // Relations
  stockItems      StockItem[]
  reservations    Reservation[]
  inventoryMovements InventoryMovement[]
  inventoryCounts InventoryCount[]

  @@map("warehouses")
}

// Advanced stock item tracking
model StockItem {
  id                String   @id @default(uuid()) @db.Uuid
  productVariantId  String   @db.Uuid
  warehouseId       String   @db.Uuid
  sku               String   @unique @db.VarChar(100)
  quantityAvailable Int  @default(0)
  quantityReserved  Int  @default(0)
  quantityDamaged   Int  @default(0)
  quantityOnOrder   Int  @default(0)
  reorderPoint      Int  @default(0)
  maxStock          Int?
  unitCost          Decimal? @db.Decimal(10, 2)
  lastInventoryCount DateTime? @db.Timestamp(6)
  expiryDate        DateTime? @db.Date
  batchNumber       String?  @db.VarChar(100)
  locationCode      String?  @db.VarChar(50) // Aisle, shelf, bin location
  status            StockStatus @default(active)
  metadata          Json?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @db.Timestamp(6)

  // Relations
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reservations      Reservation[]
  inventoryMovements InventoryMovement[]
  inventoryCountItems InventoryCountItem[]

  // Constraints
  @@unique([productVariantId, warehouseId])
  @@map("stock_items")
}

// Stock reservation with expiration
model Reservation {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  orderItemId       String   @db.Uuid
  productVariantId  String   @db.Uuid
  warehouseId       String   @db.Uuid
  quantityReserved  Int
  status            ReservationStatus @default(active)
  expiresAt         DateTime @db.Timestamp(6)
  fulfilledAt       DateTime? @db.Timestamp(6)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @db.Timestamp(6)

  // Relations
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItem         StockItem @relation(fields: [productVariantId, warehouseId], references: [productVariantId, warehouseId], onDelete: Cascade)

  @@map("reservations")
}

// Complete audit trail for inventory movements
model InventoryMovement {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @db.Uuid
  warehouseId      String   @db.Uuid
  movementType     MovementType
  quantity         Int
  referenceType    String?  // order, return, adjustment, transfer
  referenceId      String?  @db.Uuid
  reason           String?  @db.VarChar(255)
  performedBy      String?  @db.Uuid // user or system
  unitCost         Decimal? @db.Decimal(10, 2)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  // Relations
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItem        StockItem @relation(fields: [productVariantId, warehouseId], references: [productVariantId, warehouseId], onDelete: Cascade)

  @@map("inventory_movements")
}

// Inventory counting with cycle counting support
model InventoryCount {
  id              String   @id @default(uuid()) @db.Uuid
  warehouseId     String   @db.Uuid
  productVariantId String? @db.Uuid // null for full warehouse count
  countedBy       String   @db.Uuid
  countedAt       DateTime @default(now()) @db.Timestamp(6)
  status          CountStatus @default(in_progress)
  countType       CountType @default(full) // full, spot, cycle
  itemsCounted    Int  @default(0)
  discrepanciesFound Int @default(0)
  totalValue      Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?  @db.Text
  completedAt     DateTime? @db.Timestamp(6)
  approvedBy      String?  @db.Uuid
  approvedAt      DateTime? @db.Timestamp(6)
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  // Relations
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryCountItems InventoryCountItem[]

  @@map("inventory_counts")
}

// Individual count items with discrepancy tracking
model InventoryCountItem {
  id                String   @id @default(uuid()) @db.Uuid
  inventoryCountId  String   @db.Uuid
  productVariantId  String   @db.Uuid
  warehouseId       String   @db.Uuid
  systemQuantity    Int
  countedQuantity   Int
  discrepancy       Int      // Computed field: counted - system
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  // Relations
  inventoryCount    InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  stockItem         StockItem @relation(fields: [productVariantId, warehouseId], references: [productVariantId, warehouseId], onDelete: Cascade)

  @@map("inventory_count_items")
}

// Enums
enum WarehouseType {
  central
  regional
  store
}

enum WarehouseStatus {
  active
  inactive
  maintenance
}

enum StockStatus {
  active
  discontinued
  damaged
}

enum ReservationStatus {
  active
  fulfilled
  cancelled
  expired
}

enum MovementType {
  inbound
  outbound
  transfer
  adjustment
  damage
}

enum CountStatus {
  in_progress
  completed
  reconciled
  cancelled
}

enum CountType {
  full
  spot
  cycle
}

// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
