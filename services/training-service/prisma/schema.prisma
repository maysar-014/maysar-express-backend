generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrainingRecord {
  id          String   @id @default(uuid())
  learnerId   String
  learnerRole String
  moduleId    String
  status      String
  startedAt   DateTime?
  completedAt DateTime?
  score       Int?
  attempts    Int      @default(0)
  progress    Json?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      TrainingModule @relation(fields: [moduleId], references: [id])

  @@index([learnerId])
  @@index([learnerRole])
  @@index([moduleId])
  @@index([status])
  @@index([expiresAt])
}


model CertificationRequirement {
  module             String  @id
  minimumScore       Int
  validityPeriodDays Int
  mandatory          Boolean @default(true)
  maxAttempts        Int     @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum ContentType {
  TEXT
  VIDEO
  INTERACTIVE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TrainingModule {
  id              String         @id @default(uuid())
  name            String
  description     String
  contentType     ContentType    @default(TEXT)
  content         Json
  durationMinutes Int
  category        String
  prerequisites   String[]
  targetRoles     String[]
  isPublic        Boolean        @default(true)
  difficulty      DifficultyLevel @default(BEGINNER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  records         TrainingRecord[]
}

model Badge {
  id        String   @id @default(uuid())
  learnerId String
  type      String
  reason    String
  metadata  Json?
  awardedAt DateTime @default(now())

  @@index([learnerId])
  @@index([type])
}

model LeaderboardEntry {
  learnerId    String @id
  totalScore   Int    @default(0)
  modulesCount Int    @default(0)
  badgesCount  Int    @default(0)
  updatedAt    DateTime @updatedAt

  @@index([totalScore.desc])
}



