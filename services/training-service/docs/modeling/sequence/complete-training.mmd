sequenceDiagram
    participant API as "API Controller"
    participant UC as "CompleteTrainingUseCase"
    participant RecRepo as "TrainingRecordRepo"
    participant ReqRepo as "CertRequirementRepo"
    participant Engine as "EligibilityEngine"
    participant Record as "TrainingRecord Entity"

    API->>UC: execute(recordId, score)
    UC->>RecRepo: findById(recordId)
    RecRepo-->>UC: record
    UC->>ReqRepo: findByModule(moduleId)
    ReqRepo-->>UC: requirement
    
    UC->>Record: complete(score, passingScore, validityDays)
    Record-->>UC: updated status (COMPLETED/FAILED)
    
    UC->>RecRepo: save(record)
    
    alt is COMPLETED
        UC->>RecRepo: findByLearnerId(learnerId)
        RecRepo-->>UC: allRecords
        UC->>ReqRepo: findAll()
        ReqRepo-->>UC: allRequirements
        UC->>Engine: checkEligibility(allRecords, allRequirements)
        Engine-->>UC: eligibilityStatus
    end
    
    UC-->>API: success (passed, score, expiresAt)
