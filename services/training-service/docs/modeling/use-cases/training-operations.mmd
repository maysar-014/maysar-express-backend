useCaseDiagram
    actor "Learner" as L
    actor "System" as S
    actor "Internal App" as IA
    
    package "Training Service" {
        usecase "Browse Modules" as UC1
        usecase "Start Training" as UC2
        usecase "Submit Assessment" as UC3
        usecase "View Progress" as UC4
        usecase "Check Eligibility" as UC5
        usecase "Manage Modules" as UC6
        usecase "Expire Certifications" as UC7
    }
    
    L --> UC1
    L --> UC2
    L --> UC3
    L --> UC4
    
    UC2 ..> UC5 : <<include>>
    
    IA --> UC6
    S --> UC7
    S --> UC5
