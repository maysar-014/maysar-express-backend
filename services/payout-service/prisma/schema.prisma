// Payout Service Database Schema
// Platform to seller disbursements

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Payout processing for sellers
model Payout {
  id            String   @id @default(uuid()) @db.Uuid
  sellerId      String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  method        PayoutMethod
  status        PayoutStatus @default(PENDING)
  bankDetails   Json?    // Encrypted bank account details
  mobileMoneyDetails Json?
  reference     String?  @db.VarChar(255)
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  fee           Decimal  @default(0) @db.Decimal(8, 2)
  netAmount     Decimal  @default(0) @db.Decimal(10, 2)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("payouts")
}

enum PayoutMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  WALLET
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
