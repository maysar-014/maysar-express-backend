# Community Service Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/community_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=community-service
KAFKA_GROUP_ID=community-service-group

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
API_KEY=your-api-key-here

# External Services
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
LOGISTICS_SERVICE_URL=http://localhost:3005

# Feature Flags
ENABLE_CACHING=true
ENABLE_EVENTS=true
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Content Moderation
AUTO_MODERATION_ENABLED=true
SUSPICIOUS_KEYWORDS_THRESHOLD=0.7

# Feed Configuration
FEED_CACHE_TTL=300
TRENDING_CACHE_TTL=600
MAX_FEED_SIZE=100
