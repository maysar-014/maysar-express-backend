sequenceDiagram
    participant API
    participant UC as CreatePostUseCase
    participant PE as Post Entity
    participant PR as PostRepository
    participant EB as EventBus
    participant MS as ModerationService

    API->>UC: execute(command)
    UC->>UC: validateContent(command.content)
    
    UC->>MS: checkModerationRequirements(content)
    MS-->>UC: needsModeration / autoApprove
    
    UC->>PE: create(command, status)
    PE-->>UC: post
    
    UC->>PR: save(post)
    PR-->>UC: success
    
    UC->>EB: publish(PostCreatedEvent)
    UC-->>API: success
