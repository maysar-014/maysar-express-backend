# Commission Service Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# SERVICE CONFIGURATION
# ============================================

NODE_ENV=development
SERVICE_NAME=commission-service
SERVICE_VERSION=1.0.0
PORT=3002

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL database connection
DATABASE_URL="postgresql://username:password@localhost:5432/maysar_commission_db?schema=public"

# ============================================
# SECURITY CONFIGURATION
# ============================================

JWT_SECRET="your-super-secure-jwt-secret-change-in-production"
API_KEY="your-commission-service-api-key"

# ============================================
# LOGGING CONFIGURATION
# ============================================

LOG_LEVEL=info

# ============================================
# EVENT PUBLISHING CONFIGURATION
# ============================================

MESSAGE_QUEUE_TYPE=kafka
MESSAGE_QUEUE_URL="localhost:9092"

# ============================================
# MONITORING & METRICS
# ============================================

METRICS_ENABLED=true
METRICS_PORT=9092
