# Commission Service Environment Variables

# Server Configuration
PORT=3008
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/commission_db

# Kafka Configuration (Optional)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commission-service

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Provider Configuration (Optional)
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=sk_test_...
PAYMENT_BASE_URL=https://api.stripe.com

# Logging Configuration
LOG_LEVEL=info

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# JWT Configuration (if authentication is added)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h
