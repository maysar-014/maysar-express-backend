// Trust Service Database Schema
// Reviews, ratings, trust scores, and dispute resolution

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Product and seller reviews
model Review {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  reviewerId      String   @db.Uuid
  sellerId        String   @db.Uuid
  productId       String   @db.Uuid
  rating          Int      // 1-5 stars
  title           String?  @db.VarChar(255)
  comment         String?
  images          Json?
  status          ReviewStatus @default(pending)
  moderatedBy     String?  @db.Uuid
  moderatedAt     DateTime? @db.Timestamp(6)
  helpfulVotes    Int      @default(0)
  totalVotes      Int      @default(0)
  verifiedPurchase Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  @@map("reviews")
}

// Algorithmic trust score calculation
model TrustScore {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   @db.VarChar(50) // seller, product, enabler
  entityId       String   @db.Uuid
  overallScore   Decimal  @db.Decimal(3, 2) // 0.00 - 5.00
  reviewCount    Int      @default(0)
  qualityScore   Decimal? @db.Decimal(3, 2)
  deliveryScore  Decimal? @db.Decimal(3, 2)
  communicationScore Decimal? @db.Decimal(3, 2)
  lastCalculated DateTime @default(now()) @db.Timestamp(6)
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  @@map("trust_scores")
}

// Dispute resolution workflow
model Dispute {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  buyerId        String   @db.Uuid
  sellerId       String   @db.Uuid
  type           DisputeType
  status         DisputeStatus @default(opened)
  priority       DisputePriority @default(normal)
  description    String
  buyerEvidence  Json?
  sellerEvidence Json?
  adminEvidence  Json?
  decision       DisputeDecision?
  refundAmount   Decimal? @db.Decimal(10, 2)
  resolutionNotes String?
  resolvedBy     String?  @db.Uuid
  resolvedAt     DateTime? @db.Timestamp(6)
  slaDeadline    DateTime? @db.Timestamp(6)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  @@map("disputes")
}

// Enums
enum ReviewStatus {
  pending
  approved
  rejected
  flagged
  hidden
}

enum DisputeType {
  item_not_received
  item_damaged
  wrong_item
  buyer_remorse
  seller_not_responsive
  quality_issue
  other
}

enum DisputeStatus {
  opened
  under_review
  evidence_collected
  decided
  resolved
  escalated
  closed
}

enum DisputePriority {
  low
  normal
  high
  critical
}

enum DisputeDecision {
  buyer_wins
  seller_wins
  split
  uphold
  refund
  exchange
  store_credit
}
