// Compliance Service Database Schema
// Handles GDPR, PCI DSS, SOX compliance automation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Compensating Controls for PCI DSS
model CompensatingControl {
  id             String   @id @default(cuid())
  requirement    String
  description    String
  implementation String
  evidence       Json?
  status         String   @default(pending) // approved, rejected, expired
  approvedBy     String?
  approvedAt     DateTime?
  expiryDate     DateTime
  reviewDate     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("compensating_controls")
}

// GDPR Subject Rights Requests
model SubjectRightsRequest {
  id           String   @id @default(cuid())
  userId       String
  requestType  SubjectRightsRequestType
  status       SubjectRightsRequestStatus @default(pending)
  requestedAt  DateTime @default(now())
  completedAt  DateTime?
  data         Json?
  reason       String?

  @@map("subject_rights_requests")
}

// PCI DSS Compliance Tracking
model PCIComplianceRecord {
  id              String   @id @default(cuid())
  assessmentDate  DateTime @default(now())
  assessor        String
  complianceLevel PCIComplianceLevel
  expiryDate      DateTime
  vulnerabilities Json?
  remediationPlan Json?
  status          ComplianceStatus @default(active)

  @@map("pci_compliance_records")
}

// SOX Audit Trail
model SOXAComplianceRecord {
  id             String   @id @default(cuid())
  controlId      String
  controlArea    String
  assessmentDate DateTime @default(now())
  assessor       String
  status         SOXComplianceStatus
  findings       Json?
  remediation    Json?
  nextReviewDate DateTime

  @@map("sox_compliance_records")
}

// SOX Controls (for storing control definitions)
model SOXControl {
  id             String   @id @default(cuid())
  controlId      String   @unique
  controlArea    SOXControlArea
  description    String
  frequency      SOXFrequency
  owner          String
  status         SOXControlStatus @default(effective)
  lastTested     DateTime?
  nextReviewDate DateTime
  evidence       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sox_controls")
}

// Data Retention Policies
model DataRetentionPolicy {
  id             String   @id @default(cuid())
  dataType       String
  retentionPeriod Int // days
  legalBasis     String
  applicableLaw  String
  autoDelete     Boolean @default(true)
  lastReviewed   DateTime @default(now())
  nextReviewDate DateTime

  @@map("data_retention_policies")
}

// Data Deletion Logs
model DataDeletionLog {
  id            String   @id @default(cuid())
  userId        String
  dataType      String
  recordsDeleted Int
  deletedAt     DateTime @default(now())
  requestedBy   String
  reason        String

  @@map("data_deletion_logs")
}

// KYC Records (Know Your Customer)
model KYCRecord {
  id                String   @id @default(cuid())
  userId            String
  verificationStatus KYCStatus @default(pending)
  submittedAt       DateTime @default(now())
  verifiedAt        DateTime?
  verifiedBy        String?
  documents         Json? // File paths/URLs to verification documents
  rejectionReason   String?
  expiryDate        DateTime?
  riskLevel         KYCRiskLevel @default(medium)

  @@map("kyc_records")
}

// Compliance Audit Logs
model ComplianceAuditLog {
  id          String   @id @default(cuid())
  action      String
  resource    String
  userId      String
  timestamp   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  details     Json?

  @@map("compliance_audit_logs")
}

// Data Processing Records (GDPR Article 30)
model DataProcessingRecord {
  id              String   @id @default(cuid())
  purpose         String
  categories      Json // Personal data categories
  recipients      Json // Data recipients
  retentionPeriod String
  securityMeasures Json
  lastReviewed    DateTime @default(now())

  @@map("data_processing_records")
}

// Privacy Impact Assessments
model PrivacyImpactAssessment {
  id             String   @id @default(cuid())
  projectName    String
  assessmentDate DateTime @default(now())
  assessor       String
  riskLevel      RiskLevel
  findings       Json?
  recommendations Json?
  status         AssessmentStatus @default(in_progress)

  @@map("privacy_impact_assessments")
}

// Enums
enum SubjectRightsRequestType {
  access
  delete
  portability
  rectification
}

enum SubjectRightsRequestStatus {
  pending
  processing
  completed
  rejected
}

enum PCIComplianceLevel {
  level1 // >6M transactions/year
  level2 // 1-6M transactions/year
  level3 // <1M transactions/year
  level4 // <1M transactions/year (small merchants)
}

enum SOXComplianceStatus {
  compliant
  non_compliant
  remediation_required
  under_review
}

enum ComplianceStatus {
  active
  expired
  revoked
}

enum KYCStatus {
  pending
  submitted
  under_review
  approved
  rejected
  expired
}

enum KYCRiskLevel {
  low
  medium
  high
  critical
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum AssessmentStatus {
  in_progress
  completed
  requires_action
}

enum SOXControlArea {
  access_control
  change_management
  financial_reporting
  data_integrity
  segregation_duties
}

enum SOXFrequency {
  daily
  weekly
  monthly
  quarterly
  annually
}

enum SOXControlStatus {
  effective
  ineffective
  compensating_control
}
