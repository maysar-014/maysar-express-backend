useCaseDiagram
    actor "User" as U
    actor "Compliance Officer" as CO
    actor "System" as S
    
    package "Compliance Service" {
        usecase "Submit KYC Docs" as UC1
        usecase "Perform Risk Assessment" as UC2
        usecase "Review Verification" as UC3
        usecase "Manage Retention Policy" as UC4
        usecase "Anonymize Expired Data" as UC5
        usecase "Check KYC Validity" as UC6
    }
    
    U --> UC1
    U --> UC6
    CO --> UC3
    CO --> UC2
    S --> UC2
    S --> UC4
    S --> UC5
    S --> UC6
