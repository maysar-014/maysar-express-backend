# Database
DATABASE_URL="postgresql://user:password@localhost:5432/notification_db"

# Service
PORT=3004
NODE_ENV=development

# Redis (optional - for cache and rate limiting)
REDIS_URL="redis://localhost:6379"

# Email provider (SendGrid / SMTP)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@maysar.com

# SMS provider (Twilio / Africa's Talking)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# JWT / Auth (for API gateway)
JWT_SECRET=
API_KEY=

# Logging
LOG_LEVEL=info
