// Notification Service Database Schema
// Multi-channel notifications, templates, preferences, audit

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notification {
  id                 String    @id @default(uuid())
  userId             String    @db.VarChar(255)
  type               String    @db.VarChar(20)  // email, sms, push, in-app
  channel            String    @db.VarChar(20)
  status             String    @db.VarChar(20)  // pending, sent, failed, delivered, read
  priority           String    @default("medium") @db.VarChar(20)
  subject            String    @db.VarChar(500)
  content            String    @db.Text
  contentHtml        String?   @db.Text
  metadata           Json?     @default("{}")
  scheduledAt        DateTime? @db.Timestamp(6)
  sentAt             DateTime? @db.Timestamp(6)
  deliveredAt       DateTime? @db.Timestamp(6)
  readAt             DateTime? @db.Timestamp(6)
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  lastError          String?   @db.Text
  deliveryAddress    String?   @db.VarChar(500)
  deliveryAddressType String?  @db.VarChar(20)
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @db.Timestamp(6)

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  name         String   @unique @db.VarChar(100)
  type         String   @db.VarChar(50)
  channel      String   @db.VarChar(20)
  subject      String   @db.VarChar(500)
  bodyTemplate String   @db.Text
  variables    Json     @default("[]")  // string[]
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdBy    String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @db.Timestamp(6)

  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

model NotificationPreference {
  id         String   @id @default(uuid())
  userId     String   @db.VarChar(255)
  channel    String   @db.VarChar(20)
  enabled    Boolean  @default(true)
  categories Json     @default("{}")  // { marketing, transactional, system }
  quietHours Json?    // { start, end, timezone }
  frequency  String?  @db.VarChar(20)  // realtime, hourly, daily, weekly
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  @@unique([userId, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationLog {
  id             String   @id @default(uuid())
  notificationId String   @db.VarChar(255)
  action         String   @db.VarChar(50)  // sent, delivered, failed, read
  provider       String?  @db.VarChar(50)
  details        Json?    @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  @@index([notificationId])
  @@index([createdAt])
// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
