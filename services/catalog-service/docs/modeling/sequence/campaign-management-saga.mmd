sequenceDiagram
    participant Saga
    participant PR as ProductRepository
    participant CS as CampaignService
    participant EB as EventBus

    Saga->>CS: createCampaign(campaignData)
    CS-->>Saga: campaignId
    
    Saga->>PR: applyDiscounts(campaignId, productIds)
    PR-->>Saga: success
    
    Saga->>CS: scheduleActivation(campaignId, startDate)
    CS-->>Saga: scheduled
    
    Saga->>EB: publish(CampaignCreatedEvent)
