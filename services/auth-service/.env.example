# Auth Service Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/auth_db"
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TLS=false

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="7d"
JWT_ISSUER="maysar-auth-service"
JWT_AUDIENCE="maysar-platform"

# Password Security
PASSWORD_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Two-Factor Authentication
TOTP_ISSUER="Maysar"
TOTP_WINDOW=1

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@maysar.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@maysar.com"
EMAIL_FROM_NAME="Maysar Platform"

# SMS Configuration (for phone verification)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Kafka Messaging
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="auth-service"
KAFKA_GROUP_ID="auth-service-group"
KAFKA_SSL=false

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT_MINUTES=480
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"
LOG_FILE_PATH="./logs/auth-service.log"

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
APM_ENABLED=false

# Admin Configuration
ADMIN_EMAIL="admin@maysar.com"
SYSTEM_USER_ID="system-user-001"

# Feature Flags
ENABLE_TWO_FACTOR=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PHONE_VERIFICATION=false
ENABLE_SOCIAL_LOGIN=false
ENABLE_PASSWORD_RESET=true

# External Service URLs
ORDER_SERVICE_URL="http://localhost:3002"
LOGISTICS_SERVICE_URL="http://localhost:3003"
PAYMENT_SERVICE_URL="http://localhost:3004"
COMMUNITY_SERVICE_URL="http://localhost:3005"

# Development Settings
DEBUG_MODE=false
ENABLE_SWAGGER=true
ENABLE_CORS_LOGS=false
