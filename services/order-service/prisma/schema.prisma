// Prisma schema for Order Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  buyerId         String
  sellerId        String
  status          OrderStatus @default(PENDING)
  paymentMethod   PaymentMethod
  totalAmount     Decimal
  currency        String   @default("TZS")
  totalWeight     Float
  deliveryAddress Json // Address value object
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  items           OrderItem[]
  payments        Payment[]
  settlements     Settlement[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Decimal
  weight      Float
  currency    String  @default("TZS")

  // Relations
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal
  currency      String        @default("TZS")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  externalRef   String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Settlement {
  id              String   @id @default(cuid())
  orderId         String
  settlementId    String   @unique
  sellerPayout    Decimal
  platformCommission Decimal
  courierEarnings Decimal?
  currency        String   @default("TZS")
  status          SettlementStatus @default(PENDING)
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("settlements")
}

// Enums
enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  WALLET
  CARD
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}

// ============================================================================
// SAGA LOGS
// ============================================================================

model SagaLog {
  id          String   @id @default(uuid())
  sagaId      String   @unique
  sagaType    String
  status      String   @default("STARTED") // STARTED, IN_PROGRESS, COMPLETED, FAILED, COMPENSATING, COMPENSATED
  currentStep String
  payload     Json
  context     Json
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SagaStepLog[]

  @@index([status])
  @@index([sagaType])
  @@map("saga_logs")
}

model SagaStepLog {
  id          String   @id @default(uuid())
  sagaId      String
  stepName    String
  status      String   @default("PENDING") // PENDING, STARTED, COMPLETED, FAILED, COMPENSATED
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?

  saga        SagaLog  @relation(fields: [sagaId], references: [sagaId], onDelete: Cascade)

  @@index([sagaId])
  @@map("saga_step_logs")
}
