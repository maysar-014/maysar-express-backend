# Checkout Service Environment Configuration
NODE_ENV=development
SERVICE_NAME=checkout-service
SERVICE_VERSION=1.0.0
PORT=3005

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/maysar_checkout_db?schema=public"

# Security
JWT_SECRET="your-secret"
API_KEY="your-api-key"

# Logging
LOG_LEVEL=info

# Message Queue
MESSAGE_QUEUE_TYPE=kafka
MESSAGE_QUEUE_URL="localhost:9092"
