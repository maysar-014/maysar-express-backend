# Application Configuration
NODE_ENV=development
PORT=3008
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/checkout_service

# Pricing Configuration
TAX_RATE=10
SHIPPING_COST=10
MIN_ORDER_FREE_SHIPPING=100

# Checkout Configuration
CHECKOUT_SESSION_EXPIRATION_MS=3600000
MAX_RETRIES=3
TIMEOUT_MS=30000

# Service Configuration
SERVICE_NAME=checkout-service
SERVICE_VERSION=1.0.0

# Event Bus Configuration
EVENT_BUS_TYPE=in-memory

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
