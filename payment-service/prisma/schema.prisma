// Payment Service Database Schema
// Complete payment processing, wallet management, and financial transactions

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Payment transactions with PCI compliance
model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  userId        String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  method        PaymentMethod
  provider      String   @db.VarChar(50) // PESAPAL, INTERNAL_WALLET
  providerRef   String?  @db.VarChar(255)
  status        PaymentStatus @default(PENDING)
  description   String?  @db.VarChar(500)
  metadata      Json?
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  refundedAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("payments")
}

// Refund processing
model Refund {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @db.Uuid
  orderId       String   @db.Uuid
  userId        String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  reason        String   @db.VarChar(255)
  reasonDetails String?  @db.Text
  status        RefundStatus @default(PENDING)
  providerRef   String?  @db.VarChar(255)
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("refunds")
}

// Webhook processing for payment providers
model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @db.VarChar(50)
  eventType     String   @db.VarChar(100)
  eventId       String   @db.VarChar(255)
  payload       Json
  processed     Boolean  @default(false)
  processedAt   DateTime? @db.Timestamp(6)
  errorMessage  String?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// Enums
enum PaymentMethod {
  MPESA
  AIRTEL_MONEY
  TIGO_PESA
  HALOPESA
  WALLET
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}


// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}

// Fraud Detection
model FraudAssessment {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @unique
  riskScore       Int
  riskLevel       String
  recommendation  String
  confidence      Float
  flags           Json
  processingTime  Int
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  @@map("fraud_assessments")
}
