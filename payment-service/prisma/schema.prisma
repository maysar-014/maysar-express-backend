// Payment Service Database Schema
// Complete payment processing, wallet management, and financial transactions

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Payment transactions with PCI compliance
model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  userId        String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  method        PaymentMethod
  provider      String   @db.VarChar(50) // pesapal, stripe, paypal, etc.
  providerRef   String?  @db.VarChar(255)
  status        PaymentStatus @default(pending)
  description   String?  @db.VarChar(500)
  metadata      Json?
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  refundedAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  transactions  Transaction[]

  @@map("payments")
}

// User wallets for platform currency
model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  balance     Decimal  @default(0) @db.Decimal(10, 2)
  currency    String   @default("TZS") @db.VarChar(3)
  status      WalletStatus @default(active)
  frozenAmount Decimal @default(0) @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  // Relations
  transactions Transaction[]

  @@map("wallets")
}

// Complete transaction ledger (append-only)
model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String?  @db.Uuid
  paymentId     String?  @db.Uuid
  userId        String   @db.Uuid
  type          TransactionType
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  balanceBefore Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @db.Decimal(10, 2)
  referenceType String?  @db.VarChar(50) // order, refund, transfer, etc.
  referenceId   String?  @db.Uuid
  description   String?  @db.VarChar(255)
  metadata      Json?
  processedAt   DateTime @default(now()) @db.Timestamp(6)

  // Relations
  wallet        Wallet? @relation(fields: [walletId], references: [id])
  payment       Payment? @relation(fields: [paymentId], references: [id])

  @@map("transactions")
}

// Refund processing
model Refund {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @db.Uuid
  orderId       String   @db.Uuid
  userId        String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  reason        String   @db.VarChar(255)
  status        RefundStatus @default(pending)
  providerRef   String?  @db.VarChar(255)
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("refunds")
}

// Payout processing for sellers
model Payout {
  id            String   @id @default(uuid()) @db.Uuid
  sellerId      String   @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  method        PayoutMethod
  status        PayoutStatus @default(pending)
  bankDetails   Json?    // Encrypted bank account details
  reference     String?  @db.VarChar(255)
  processedAt   DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  fee           Decimal  @default(0) @db.Decimal(8, 2)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("payouts")
}

// Webhook processing for payment providers
model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @db.VarChar(50)
  eventType     String   @db.VarChar(100)
  eventId       String   @db.VarChar(255)
  payload       Json
  processed     Boolean  @default(false)
  processedAt   DateTime? @db.Timestamp(6)
  errorMessage  String?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// Enums
enum PaymentMethod {
  card
  mobile_money_mpesa
  mobile_money_airtel
  mobile_money_tigo
  mobile_money_mixed
  bank_transfer
  wallet
  cash_on_delivery
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  cancelled
  refunded
  disputed
}

enum WalletStatus {
  active
  frozen
  suspended
  closed
}

enum TransactionType {
  credit
  debit
  transfer_in
  transfer_out
  refund
  fee
  adjustment
}

enum RefundStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum PayoutMethod {
  bank_transfer
  mobile_money
  wallet_transfer
  check
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// ============================================================================
// TRANSACTIONAL OUTBOX
// ============================================================================

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
