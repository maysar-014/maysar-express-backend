        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.0",
        "@types/morgan": "^1.9.4",
        "@types/node": "^18.0.0",
        "jest": "^29.5.0",
        "prisma": "^5.0.0",
        "ts-jest": "^29.1.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.0"
