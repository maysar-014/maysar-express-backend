// Wallet Service Database Schema
// Balance management and transaction ledger

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// User wallets for platform currency
model Wallet {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  balance       Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  status        WalletStatus @default(ACTIVE)
  frozenAmount  Decimal  @default(0) @db.Decimal(10, 2)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  transactions  Transaction[]

  @@map("wallets")
}

// Complete transaction ledger (append-only)
model Transaction {
  id                 String   @id @default(uuid()) @db.Uuid
  walletId           String   @db.Uuid
  userId             String   @db.Uuid
  type               TransactionType
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("TZS") @db.VarChar(3)
  balanceBefore      Decimal  @db.Decimal(10, 2)
  balanceAfter       Decimal  @db.Decimal(10, 2)
  frozenAmountBefore Decimal  @default(0) @db.Decimal(10, 2)
  frozenAmountAfter  Decimal  @default(0) @db.Decimal(10, 2)
  referenceType      String?  @db.VarChar(50) // order, refund, transfer, etc.
  referenceId        String?  @db.Uuid
  description        String?  @db.VarChar(255)
  metadata           Json?
  createdAt          DateTime @default(now()) @db.Timestamp(6)

  // Relations
  wallet        Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

enum WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
  FREEZE
  UNFREEZE
  TRANSFER_IN
  TRANSFER_OUT
  REFUND
  FEE
  ADJUSTMENT
  DEBIT_FROZEN
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  eventData   Json
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("outbox_events")
}
