sequenceDiagram
    participant API
    participant UC as FreezeFundsUseCase
    participant WE as Wallet Entity
    participant WR as WalletRepository
    participant EB as EventBus

    API->>UC: execute(command)
    UC->>WR: findById(command.walletId)
    WR-->>UC: wallet
    
    UC->>UC: validateAmount(command.amount)
    
    UC->>WE: checkAvailableBalance(command.amount)
    WE-->>UC: isAvailable
    
    UC->>WE: freeze(command.amount)
    WE-->>UC: updatedWallet
    
    UC->>WR: save(updatedWallet)
    WR-->>UC: success
    
    UC->>EB: publish(FundsFrozenEvent)
    UC-->>API: success
