sequenceDiagram
    participant API
    participant UC as CreditWalletUseCase
    participant WE as Wallet Entity
    participant WR as WalletRepository
    participant EB as EventBus

    API->>UC: execute(command)
    UC->>WR: findById(command.walletId)
    WR-->>UC: wallet
    
    UC->>UC: validateAmount(command.amount)
    
    UC->>WE: checkStatus()
    WE-->>UC: status
    
    UC->>WE: credit(command.amount)
    WE-->>UC: updatedWallet
    
    UC->>WR: save(updatedWallet)
    WR-->>UC: success
    
    UC->>EB: publish(WalletCreditedEvent)
    UC-->>API: success
