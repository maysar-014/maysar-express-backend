# Test environment template.
# Copy to `.env.test` and keep values test/sandbox only.

# Environment
NODE_ENV=test
LOG_LEVEL=error
LOG_FORMAT=combined

# Database & Redis (local test instances only)
DATABASE_URL=postgresql://test:test@localhost:5432/maysar_test
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=maysar_test
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=TEST_REDIS_PASSWORD
CATALOG_SERVICE_DB_HOST=localhost
CATALOG_SERVICE_DB_PORT=5432
CATALOG_SERVICE_DB_NAME=catalog_test
CATALOG_SERVICE_DB_USER=test
CATALOG_SERVICE_DB_PASSWORD=test

# Search (Meilisearch - test)
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_PROTOCOL=http
MEILI_MASTER_KEY=dev-master-key
MEILISEARCH_API_KEY=dev-master-key
MEILISEARCH_INDEX_NAME=catalog_test
MEILISEARCH_REQUEST_TIMEOUT=30000

# JWT / sessions
JWT_SECRET=TEST_JWT_SECRET
JWT_EXPIRES_IN=7d
USER_SERVICE_JWT_SECRET=TEST_USER_SERVICE_JWT_SECRET
USER_SERVICE_JWT_EXPIRES_IN=24h
AUTH_SERVICE_SESSION_SECRET=TEST_AUTH_SESSION_SECRET
AUTH_SERVICE_TOKEN_EXPIRY=3600

# Notification / messaging
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test-smtp-user
SMTP_PASS=TEST_SMTP_PASS
SMTP_FROM=
SMTP_FROM_NAME=
# SMS Configuration (provider-agnostic — set via secrets manager)
# Provider name is an example only — replace with your actual provider:
# SMS_PROVIDER=           # e.g. africastalking, twilio, custom
SMS_PROVIDER=test-sms-provider
# SMS_API_KEY=            # [SECRETS MANAGER]
# SMS_SENDER_ID=          # [SECRETS MANAGER]
# SMS_ENV=                # [ENV VAR]
# SMS_BASE_URL=           # [ENV VAR]
SMS_ALLOW_LIVE_IN_DEV=false
SMS_SERVICE_API_KEY=TEST_SMS_API_KEY

# Push Notifications (test-only placeholders — provider-agnostic)
# PUSH_PROJECT_ID=test-push-project
# PUSH_PRIVATE_KEY=TEST_PUSH_PRIVATE_KEY
# PUSH_CLIENT_EMAIL=test-push@example.test
# PUSH_SERVER_KEY=TEST_PUSH_SERVER_KEY

# Payment gateways (sandbox only — live credentials MUST NEVER appear in test)
# Per-method mode control: all set to sandbox for tests
PAYMENT_PROVIDER=sandbox-payment-gateway
PAYMENT_SANDBOX_API_KEY=test-payment-api-key
PAYMENT_SANDBOX_MERCHANT_CODE=test-merchant-code
PAYMENT_SANDBOX_BASE_URL=https://sandbox.payment-gateway.example/v1

BASE_URL=http://localhost:3000

# Observability (local/test)
SENTRY_DSN=http://test-sentry-key@localhost:9000/1
JAEGER_ENDPOINT=http://localhost:14268/api/traces
METRICS_ENABLED=true
SERVICE_NAME=maysar-backend-test
SERVICE_VERSION=1.0.0-test

# Storage
STORAGE_BUCKET=test-maysar-files
STORAGE_PATH=./tmp/test-storage
MAX_FILE_SIZE=10485760

# Security
PII_ENCRYPTION_KEY=TEST_PII_ENCRYPTION_KEY
PII_HMAC_SECRET=TEST_PII_HMAC_SECRET

# Event bus
EVENT_BUS_MAX_LISTENERS=200

# Regional / analytics
GOOGLE_ANALYTICS_ID=GA-TEST-0000000

# Feature flags
ENABLE_REAL_TIME=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
DEV_SEED_DATA=false
DEV_RESET_DB=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:3200

# Backup / cloud placeholders (never production values in test)
POSTGRES_BACKUP_RETENTION_DAYS=7
REDIS_BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=test-backup-bucket
AWS_ACCESS_KEY_ID=TEST_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=TEST_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1

# CI-only placeholders
DOCKER_USERNAME=test-docker-user
# Cloud provider credentials (test-only placeholders — provider-agnostic)
# CLOUD_PROVIDER=test-cloud-provider      # e.g. aws, azure, gcp, oracle, hetzner, digitalocean, self-hosted
# CLOUD_ACCESS_KEY_ID=test-cloud-access-key-id
# CLOUD_SECRET_ACCESS_KEY=TEST_CLOUD_SECRET_ACCESS_KEY
# CLOUD_REGION=test-cloud-region
# CLOUD_CLUSTER_ID=test-cloud-cluster-id


