useCaseDiagram
    actor "User" as U
    actor "Admin" as A
    actor "System" as S

    package "User Service - Account Management" {
        usecase "Update Profile" as UC1
        usecase "Change Password" as UC2
        usecase "Change Role" as UC3
        usecase "Suspend Account" as UC4
        usecase "Delete Account" as UC5
        usecase "Reactivate Account" as UC6
    }

    U --> UC1
    U --> UC2
    U --> UC5

    A --> UC3
    A --> UC4
    A --> UC6
    A --> UC5

    S --> UC4
    S --> UC6
