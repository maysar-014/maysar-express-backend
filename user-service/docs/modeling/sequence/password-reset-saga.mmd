sequenceDiagram
    participant Saga
    participant UR as UserRepository
    participant NS as NotificationService
    participant EB as EventBus

    Saga->>UR: generateResetToken(email)
    UR-->>Saga: token
    
    Saga->>NS: sendPasswordResetEmail(email, token)
    NS-->>Saga: success
    
    note over Saga: Wait for User Action
    
    Saga->>UR: validateResetToken(token)
    UR-->>Saga: valid
    
    Saga->>UR: updatePassword(userId, newPassword)
    UR-->>Saga: success
    
    Saga->>EB: publish(PasswordResetEvent)
