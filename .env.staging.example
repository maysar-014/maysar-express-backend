# Staging environment template
# Copy to `.env.staging` and populate with real staging secrets from your secret manager.

# Core runtime
NODE_ENV=staging
PORT=3000
BASE_URL=https://api-staging.maysar.co.tz
LOG_LEVEL=info
LOG_FORMAT=json

# Infrastructure
DATABASE_URL=postgresql://maysar_staging:<db-password>@staging-postgres:5432/maysar_staging
REDIS_URL=redis://:<redis-password>@staging-redis:6379
POSTGRES_USER=maysar_staging
POSTGRES_PASSWORD=<from-secret-manager>
POSTGRES_DB=maysar_staging
REDIS_PASSWORD=<from-secret-manager>

# Security
JWT_SECRET=<from-secret-manager-min-32-chars>
JWT_EXPIRES_IN=7d
USER_SERVICE_JWT_SECRET=<from-secret-manager>
USER_SERVICE_JWT_EXPIRES_IN=24h
AUTH_SERVICE_SESSION_SECRET=<from-secret-manager>
AUTH_SERVICE_TOKEN_EXPIRY=3600

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=<from-secret-manager>
GOOGLE_OAUTH_CLIENT_SECRET=<from-secret-manager>
# Optional in staging; defaults to BASE_URL + /api/auth/oauth/callback
GOOGLE_OAUTH_CALLBACK_URL=https://api-staging.maysar.co.tz/api/auth/oauth/callback

# Catalog DB (if separate credentials are required)
CATALOG_SERVICE_DB_HOST=staging-postgres
CATALOG_SERVICE_DB_PORT=5432
CATALOG_SERVICE_DB_NAME=maysar_staging
CATALOG_SERVICE_DB_USER=maysar_staging
CATALOG_SERVICE_DB_PASSWORD=<from-secret-manager>

# SMS (Africa's Talking)
SMS_SERVICE_PROVIDER=africastalking
SMS_PROVIDER=africastalking
SMS_SERVICE_API_KEY=<from-secret-manager>
AFRICASTALKING_USERNAME=<from-secret-manager>
AFRICASTALKING_API_KEY=<from-secret-manager>
AFRICASTALKING_SENDER_ID=MAYSAR
AFRICASTALKING_ENV=live
AFRICASTALKING_BASE_URL=
AFRICASTALKING_BULK_SMS_MODE=1
AFRICASTALKING_ENQUEUE=1
AFRICASTALKING_KEYWORD=
AFRICASTALKING_LINK_ID=
AFRICASTALKING_RETRY_DURATION_HOURS=
SMS_ALLOW_LIVE_IN_DEV=false

# Email (Maileroo SMTP)
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<from-secret-manager>
SMTP_PASS=<from-secret-manager>
SMTP_FROM=
SMTP_FROM_NAME=

# Payments (Selcom — Maysar's payment gateway)
# ── Per-method mode control ───────────────────────────────────────────────────
# In staging, enable the methods you want to test. Use "live" only for methods
# that are fully contracted and have live credentials in the secret manager.
PAYMENT_MPESA_MODE=sandbox              # sandbox | live | off
PAYMENT_AIRTEL_MONEY_MODE=sandbox       # sandbox | live | off
PAYMENT_MIXX_BY_YAS_MODE=sandbox        # sandbox | live | off  (formerly TIGO_PESA)
PAYMENT_HALOPESA_MODE=off               # sandbox | live | off
PAYMENT_CARD_MODE=off                   # sandbox | live | off
PAYMENT_BANK_TRANSFER_MODE=sandbox      # sandbox | live | off
PAYMENT_WALLET_MODE=live                # sandbox | live | off

# ── Selcom credentials (sandbox) ──────────────────────────────────────────────
PAYMENT_SELCOM_SANDBOX_API_KEY=<from-secret-manager>
PAYMENT_SELCOM_SANDBOX_MERCHANT_CODE=<from-secret-manager>
PAYMENT_SELCOM_SANDBOX_BASE_URL=https://apigwtest.selcommobile.com/v1

# ── Selcom credentials (live) ─────────────────────────────────────────────────
# Populate only when at least one method is set to mode=live
PAYMENT_SELCOM_LIVE_API_KEY=<from-secret-manager>
PAYMENT_SELCOM_LIVE_MERCHANT_CODE=<from-secret-manager>
PAYMENT_SELCOM_LIVE_BASE_URL=https://apigw.selcommobile.com/v1

# Firebase (FCM)
FIREBASE_PROJECT_ID=<from-secret-manager>
FIREBASE_PRIVATE_KEY=<from-secret-manager>
FIREBASE_CLIENT_EMAIL=<from-secret-manager>

# Observability
SENTRY_DSN=<from-secret-manager>
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
METRICS_ENABLED=true
SERVICE_NAME=maysar-backend-staging
SERVICE_VERSION=1.0.0-staging

# Platform behavior
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://staging.maysar.com
ENABLE_REAL_TIME=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
EVENT_BUS_MAX_LISTENERS=200
