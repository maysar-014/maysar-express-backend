generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  brand       String
  sku         String   @unique
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
  inventory Inventory[]
  pricing  ProductPricing[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String
  sku       String   @unique
  attributes Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id])
  inventory Inventory[]
  pricing   ProductPricing[]

  @@map("product_variants")
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String
  variantId         String?
  warehouseId       String
  physicalStock     Int      @default(0)
  availableStock    Int      @default(0)
  reservedStock     Int      @default(0)
  allocatedStock    Int      @default(0)
  reorderLevel      Int      @default(0)
  maxStock          Int      @default(1000)
  lastRestocked     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  reservations StockReservation[]

  @@unique([productId, variantId, warehouseId])
  @@map("inventory")
}

model StockReservation {
  id          String   @id @default(uuid())
  inventoryId String
  productId   String
  variantId   String?
  quantity    Int
  customerId  String?
  orderId     String?
  status      String   @default("active")
  priority    Int      @default(1)
  expiryTime  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("stock_reservations")
}

model ProductPricing {
  id         String   @id @default(uuid())
  productId  String
  variantId  String?
  region     String
  currency   String
  basePrice  Decimal
  costPrice  Decimal?
  msrp       Decimal?
  validFrom  DateTime @default(now())
  validUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([productId, variantId, region, currency])
  @@map("product_pricing")
}

model CustomerPreference {
  id               String   @id @default(uuid())
  customerId       String   @unique
  categories       String[]
  brands           String[]
  priceRangeMin    Decimal?
  priceRangeMax    Decimal?
  currency         String   @default("TZS")
  excludeCategories String[]
  excludeBrands    String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("customer_preferences")
}

model RecommendationFeedback {
  id               String   @id @default(uuid())
  customerId       String?
  recommendationId String
  productId        String
  action           String   // clicked, purchased, ignored, dismissed
  feedback         String?  // positive, negative, neutral
  context          Json?
  createdAt        DateTime @default(now())

  @@map("recommendation_feedback")
}