# Product Service Configuration
NODE_ENV=development
PORT=3005

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/maysar_product_service"

# Redis Cache
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# External Services
CATALOG_SERVICE_URL="http://localhost:3005"
CUSTOMER_SERVICE_URL="http://localhost:3006"
ML_SERVICE_URL="http://localhost:3012"

# Security
JWT_SECRET="your-jwt-secret-key"
API_KEY="your-api-key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
MAX_PROCESSING_TIME_MS=100
CACHE_TTL_SECONDS=3600

# Business Rules
ACCURACY_TARGET=99.8
RESERVATION_DEFAULT_EXPIRY_MINUTES=15
LOW_STOCK_THRESHOLD=0.2