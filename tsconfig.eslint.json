{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "services/**/*.ts",
    "shared/**/*.ts",
    "shared-contracts/**/*.ts",
    "events/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
