# PostgreSQL (portable deployment)
POSTGRES_DB=maysar
POSTGRES_USER=maysar
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Host storage (must be persistent on the server)
POSTGRES_DATA_DIR=/data/postgres
POSTGRES_BACKUP_DIR=/backups/postgres

# Backup policy
POSTGRES_BACKUP_CRON=0 2 * * *
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_FILE_PREFIX=maysar

# Optional timezone for cron/log timestamps
TZ=UTC
