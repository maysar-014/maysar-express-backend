// Analytics Service Database Schema
// Event fact storage, metrics aggregation, and business intelligence

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Event fact storage (append-only event store)
model EventFact {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @unique @db.VarChar(255)
  eventType     String   @db.VarChar(100)
  eventVersion  Int
  producer      String   @db.VarChar(100)
  entityType    String?  @db.VarChar(50)
  entityId      String?  @db.Uuid
  userId        String?  @db.Uuid
  sessionId     String?  @db.Uuid
  timestamp     DateTime @db.Timestamp(6)
  payload       Json
  metadata      Json?
  processedAt   DateTime? @db.Timestamp(6)
  partitionKey  String   @db.VarChar(50) // For time-based partitioning
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("event_facts")
}

// Pre-aggregated metrics for fast queries
model Metric {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  value         Decimal  @db.Decimal(20, 4)
  unit          String?  @db.VarChar(50)
  dimensions    Json     // Key-value pairs for filtering
  timestamp     DateTime @db.Timestamp(6)
  aggregationType String @db.VarChar(50) // count, sum, avg, min, max
  timeBucket    String   @db.VarChar(20) // 1m, 5m, 1h, 1d, etc.
  source        String   @db.VarChar(100)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("metrics")
}

// User behavior analytics
model UserSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  sessionId     String   @unique @db.VarChar(255)
  deviceInfo    Json?
  userAgent     String?  @db.VarChar(500)
  ipAddress     String?  @db.VarChar(45)
  location      Json?    // Geolocation data
  startedAt     DateTime @db.Timestamp(6)
  endedAt       DateTime? @db.Timestamp(6)
  duration      Int?     // Duration in seconds
  pageViews     Int      @default(0)
  eventsCount   Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("user_sessions")
}

// Product view analytics
model ProductView {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  variantId     String   @db.Uuid
  userId        String?  @db.Uuid
  sessionId     String?  @db.Uuid
  source        String?  @db.VarChar(100) // search, category, recommendation, etc.
  referrer      String?  @db.VarChar(500)
  timestamp     DateTime @db.Timestamp(6)
  duration      Int?     // Time spent viewing in seconds
  interactionType String? @db.VarChar(50) // view, click, add_to_cart, purchase
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("product_views")
}

// Revenue and financial analytics
model RevenueMetric {
  id            String   @id @default(uuid()) @db.Uuid
  period        String   @db.VarChar(20) // daily, weekly, monthly, yearly
  periodStart   DateTime @db.Timestamp(6)
  periodEnd     DateTime @db.Timestamp(6)
  metricType    String   @db.VarChar(50) // revenue, orders, avg_order_value, etc.
  value         Decimal  @db.Decimal(20, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  dimensions    Json     // Breakdown by category, seller, region, etc.
  comparedTo    Decimal? @db.Decimal(20, 2) // Previous period comparison
  growthRate    Decimal? @db.Decimal(8, 4)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@map("revenue_metrics")
}

// Custom dashboard configurations
model Dashboard {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?
  ownerId       String   @db.Uuid
  visibility    DashboardVisibility @default(private)
  config        Json     // Dashboard layout and widget configuration
  isActive      Boolean  @default(true)
  lastViewedAt  DateTime? @db.Timestamp(6)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  widgets       DashboardWidget[]

  @@map("dashboards")
}

// Dashboard widgets
model DashboardWidget {
  id            String   @id @default(uuid()) @db.Uuid
  dashboardId   String   @db.Uuid
  name          String   @db.VarChar(255)
  type          WidgetType
  position      Json     // x, y, width, height
  config        Json     // Widget-specific configuration
  dataSource    String   @db.VarChar(255)
  refreshRate   Int?     // Auto-refresh interval in seconds
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("dashboard_widgets")
}

// Automated reports
model Report {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?
  type          ReportType
  schedule      String?  @db.VarChar(100) // cron expression
  recipients    String[] // Email addresses
  config        Json     // Report configuration
  format        ReportFormat @default(pdf)
  isActive      Boolean  @default(true)
  lastRunAt     DateTime? @db.Timestamp(6)
  nextRunAt     DateTime? @db.Timestamp(6)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("reports")
}

// Alert configurations
model Alert {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?
  metric        String   @db.VarChar(255)
  condition     String   @db.VarChar(50) // gt, lt, eq, etc.
  threshold     Decimal  @db.Decimal(20, 4)
  severity      AlertSeverity @default(medium)
  channels      String[] // email, slack, webhook, etc.
  isActive      Boolean  @default(true)
  cooldownMinutes Int    @default(60)
  lastTriggeredAt DateTime? @db.Timestamp(6)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("alerts")
}

// Data retention policies
model DataRetention {
  id            String   @id @default(uuid()) @db.Uuid
  tableName     String   @db.VarChar(100)
  retentionDays Int
  archiveTable  String?  @db.VarChar(100)
  compressionEnabled Boolean @default(false)
  lastCleanupAt DateTime? @db.Timestamp(6)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("data_retention")
}

// User segments for targeted analytics
model UserSegment {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?
  criteria      Json     // Segment definition criteria
  estimatedSize Int?
  lastCalculated DateTime? @db.Timestamp(6)
  isActive      Boolean  @default(true)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@map("user_segments")
}

// Enums
enum DashboardVisibility {
  private
  team
  organization
  public
}

enum WidgetType {
  line_chart
  bar_chart
  pie_chart
  metric_card
  table
  heatmap
  gauge
  funnel
}

enum ReportType {
  sales_summary
  user_engagement
  inventory_status
  financial_performance
  custom
}

enum ReportFormat {
  pdf
  csv
  excel
  json
}

enum AlertSeverity {
  low
  medium
  high
  critical
}
