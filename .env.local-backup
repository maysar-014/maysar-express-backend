# ── Payment Method Configuration & Environment Control ───────────────────────
# Each method runs independently in one of three modes:
#   sandbox = test mode (sandbox credentials required)
#   live    = production mode (LIVE credentials strictly required)
#   off     = completely disabled (hidden from buyers, rejected by the API)
# These are validated at startup by payment-methods.config.ts — invalid values
# fail fast instead of being silently ignored.
PAYMENT_MPESA_MODE=off
PAYMENT_AIRTEL_MONEY_MODE=off
PAYMENT_MIXX_BY_YAS_MODE=sandbox
PAYMENT_HALOPESA_MODE=off
PAYMENT_CARD_MODE=off
PAYMENT_BANK_TRANSFER_MODE=off
PAYMENT_WALLET_MODE=sandbox

# Payment provider credentials — sandbox (provider-agnostic).
# Fill from your payment gateway test gateway; empty means those methods stay
# non-operational (configuration_error) until provided.
# Provider name is an example only — replace with your actual provider:
# PAYMENT_PROVIDER=            # e.g. selcom, stripe, paypal, flutterwave, custom
PAYMENT_SANDBOX_API_KEY=
PAYMENT_SANDBOX_MERCHANT_CODE=
PAYMENT_SANDBOX_BASE_URL=https://sandbox.payment-gateway.example/v1

# Payment provider credentials — live. NEVER set these in development; in
# production they are injected from the secrets manager and never committed
# to git.
# PAYMENT_LIVE_API_KEY=
# PAYMENT_LIVE_MERCHANT_CODE=
# PAYMENT_LIVE_BASE_URL=https://api.payment-gateway.example/v1

# ── DB pool sizing (BLG-023) ──────────────────────────────────────────────
# The monolith opens 3 separate Prisma engine pools. Postgres max_connections
# is 100, so 3 x 50 = 150 was over budget and the refused connections surfaced
# as P1001/P2024 and 30s request timeouts. 3 x 15 = 45 leaves ample headroom.
# These env vars are now honoured even though DATABASE_URL also carries
# connection_limit — see shared/database/prisma-client.ts.
DB_CONNECTION_LIMIT=15
# Fail fast on a starved pool so the cause is legible instead of a 30s hang.
DB_POOL_TIMEOUT=10

# Backup Configuration (PostgreSQL + Redis)
POSTGRES_BACKUP_RETENTION_DAYS=7
REDIS_BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_ENCRYPTION_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Least-privilege database roles
MAYSAR_APP_USER=maysar_app
MAYSAR_APP_PASSWORD=
MAYSAR_BACKUP_USER=maysar_backup
MAYSAR_BACKUP_PASSWORD=
MAYSAR_MONITOR_USER=maysar_monitor
MAYSAR_MONITOR_PASSWORD=

