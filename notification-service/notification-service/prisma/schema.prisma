// Notification Service Database Schema
// Multi-channel communication templates and delivery tracking

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// Notification templates with localization
model Template {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  type      NotificationType
  subject   String?  @db.VarChar(255)
  content   String
  variables Json?    // Template variables schema
  locale    String   @default("en") @db.VarChar(10)
  status    TemplateStatus @default(active)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  notifications Notification[]

  @@map("templates")
}

// Individual notifications with delivery tracking
model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  templateId    String?  @db.Uuid
  type          NotificationType
  priority      NotificationPriority @default(normal)
  subject       String?  @db.VarChar(255)
  content       String?
  data          Json?    // Template data for rendering
  status        NotificationStatus @default(pending)
  scheduledAt   DateTime? @db.Timestamp(6)
  sentAt        DateTime? @db.Timestamp(6)
  deliveredAt   DateTime? @db.Timestamp(6)
  failedAt      DateTime? @db.Timestamp(6)
  failureReason String?
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  // Relations
  template      Template? @relation(fields: [templateId], references: [id])
  deliveryLogs  DeliveryLog[]

  @@map("notifications")
}

// Detailed delivery tracking and analytics
model DeliveryLog {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  provider       String   @db.VarChar(50) // twilio, firebase, sendgrid, etc.
  providerMessageId String? @db.VarChar(255)
  status         DeliveryStatus
  statusCode     String?  @db.VarChar(10)
  responseBody   String?
  errorMessage   String?
  deliveryCost   Decimal? @db.Decimal(6, 4)
  userAgent      String?
  ipAddress      String?  // Using text for flexibility
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("delivery_logs")
}

// Enums
enum NotificationType {
  email
  sms
  push
  in_app
  webhook
}

enum NotificationPriority {
  low
  normal
  high
  critical
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  cancelled
  expired
}

enum DeliveryStatus {
  sent
  delivered
  failed
  bounced
  complained
  opened
  clicked
  unsubscribed
}

enum TemplateStatus {
  active
  inactive
  draft
  archived
}
